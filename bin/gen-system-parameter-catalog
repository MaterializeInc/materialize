# gen-system-parameter-catalog — regenerate the catalog of synced system
# parameters.
#
# Instantiates the default system variables and writes every parameter that the
# config sync can set to src/sql/system-parameters.json, or to the file given as
# the first argument. CI runs this through check-generation.sh and fails on any
# resulting diff.

set -euo pipefail

cd "$(dirname "$0")/.."

cargo run --quiet -p mz-system-parameter-catalog -- "${1:-src/sql/system-parameters.json}"
