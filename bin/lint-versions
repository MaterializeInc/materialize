# lint-versions - Check pinned tool and library versions

grep "rust-version = " Cargo.toml | grep -q "1\.98\.1" || \
{ echo "Please validate new Rust versions for compilation time performance regressions or ask Team Testing to do so. Afterwards change the tested version in bin/lint-versions"; exit 1; }

# The libduckdb that ci/builder and the testdrive image install must match the
# version libduckdb-sys was generated against. Its crate version encodes the
# DuckDB version as 1.MAJOR_MINOR_PATCH.x, e.g. 1.10506.1 is DuckDB 1.5.6.
encoded=$(grep -A1 '^name = "libduckdb-sys"$' Cargo.lock | sed -n 's/^version = "1\.\([0-9]*\)\..*"$/\1/p')
duckdb_version="$((encoded / 10000)).$((encoded / 100 % 100)).$((encoded % 100))"
for f in ci/builder/Dockerfile src/testdrive/ci/Dockerfile; do
  if grep -o 'duckdb/releases/download/v[^/]*/' "$f" | grep -qv "/v$duckdb_version/" \
    || ! grep -q "duckdb/releases/download/v$duckdb_version/" "$f"; then
    echo "$f must install libduckdb $duckdb_version to match libduckdb-sys in Cargo.lock"
    exit 1
  fi
done
