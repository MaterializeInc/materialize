set -uo pipefail

start="\$ $BUILDKITE_COMMAND"
end="ci-annotate-errors: Annotating the failure above"

echo "$start"
bash -e -c "$BUILDKITE_COMMAND"
result=$?
if [[ $result -ne 0 ]]; then
  echo "$end"
  args=(--test-cmd="$BUILDKITE_COMMAND" --test-result="$result" --log-start-at-last="$start" --buildkite-log-until="$end" --failures-only)
  # The macOS agent has no Docker
  if [[ $(uname) == Darwin ]]; then
    bin/ci-annotate-errors "${args[@]}"
  else
    bin/ci-builder run min bin/ci-annotate-errors "${args[@]}"
  fi
fi
exit "$result"
