set -euo pipefail

echo "Starting materialized in docker..."

# Allow specifying a version, default to latest
VERSION=${1:-latest}
container=$(docker run -d --rm --pull always -p 6875:6875 "materialize/materialized:$VERSION")
trap 'docker stop "$container" > /dev/null' EXIT

# Wait a few seconds for materialized to be ready
sleep 30

yarn tsx bin/kysely-codegen.ts
