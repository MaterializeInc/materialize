# This file is included inside the `http` block, so the directives above the
# first `server` apply to every server.

# Request metrics, served by the metrics server below. The njs module is loaded
# in /etc/nginx/nginx.conf, since `load_module` cannot appear inside `http`.
js_import mz_metrics from /etc/nginx/njs/metrics.js;
js_shared_dict_zone zone=mz_console_metrics:1m type=number;
js_set $mz_metrics_record mz_metrics.record;
# Records each request in the log phase. `$mz_metrics_record` evaluates to an
# empty string, so this log never writes a line.
access_log /dev/null main if=$mz_metrics_record;
# A request that reaches no location leaves `$mz_metrics_location` unset, and
# is counted as `other`. Reading the unset variable would log a warning.
uninitialized_variable_warn off;

server {
${MZ_NGINX_LISTENER_CONFIG}
    server_name _;

    # Each location names itself in the `location` label of the request metrics.
    location / {
        set $mz_metrics_location app;
        root /usr/share/nginx/html;
        index index.html;
        try_files $uri $uri/ /index.html;
        # Disable caching with HTTP headers
        add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0";
        add_header Expires 0;
    }

    location /api {
        set $mz_metrics_location api;
        client_max_body_size 100M;
        proxy_connect_timeout 600s;
        proxy_send_timeout 600s;
        proxy_read_timeout 600s;

        # WebSocket support
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_http_version 1.1;

        proxy_request_buffering on;
        proxy_buffers 16 32k;
        proxy_buffer_size 64k;
        proxy_busy_buffers_size 128k;
        proxy_temp_file_write_size 128k;

        resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
        set $backend ${MZ_ENDPOINT};
        proxy_pass $backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
        proxy_set_header X-Webhook-Event $http_x_webhook_event;
    }

    # RFC 9728 OAuth protected-resource metadata. MCP clients pointed at
    # /api/mcp follow the resource_metadata URL from the 401 challenge, which
    # environmentd publishes on this host, so it must reach environmentd too.
    location /.well-known/oauth-protected-resource {
        set $mz_metrics_location oauth_metadata;
        resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
        set $backend ${MZ_ENDPOINT};
        proxy_pass $backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
    }

    # Cache policy for static assets
    location ~* \.(js|css|png|jpg|jpeg|gif|svg|woff|woff2)$ {
        set $mz_metrics_location static;
        root /usr/share/nginx/html;
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Gzip compression
    gzip on;
    gzip_types text/plain text/css application/json application/javascript application/x-javascript text/xml application/xml application/xml+rss text/javascript image/svg+xml;
    gzip_min_length 256;
    gzip_comp_level 6;
    gzip_vary on;
    gzip_proxied any;
    gzip_buffers 16 8k;

    error_page 404 /404.html;
}

# Prometheus metrics, on a plain HTTP listener of their own so that they never
# share the console's port or its TLS settings.
server {
${MZ_NGINX_METRICS_LISTENER_CONFIG}
    server_name _;
    # Scrapes are neither logged nor counted as requests.
    access_log off;

    location = /metrics {
        js_content mz_metrics.render;
    }

    location / {
        return 404;
    }
}
