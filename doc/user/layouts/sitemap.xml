{{- /*
  Hugo's embedded sitemap writes .Permalink, which is a bare path when baseURL
  is one ("/docs"). The sitemap protocol requires absolute URLs, and crawlers
  drop relative <loc> entries, so prefix the site origin.
*/ -}}
{{- $origin := partial "site-origin.html" . -}}
{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{{- range where .Pages "Sitemap.Disable" "ne" true }}
{{- if .RelPermalink }}
  <url>
    <loc>{{ $origin }}{{ .RelPermalink }}</loc>
    {{- if not .Lastmod.IsZero }}
    <lastmod>{{ .Lastmod.Format "2006-01-02T15:04:05-07:00" | safeHTML }}</lastmod>
    {{- end }}
  </url>
{{- end }}
{{- end }}
</urlset>
