% Paths of fixed length, and nodes with a self loop.
two_hop(x, z) :- edges(x, y), edges(y, z).
three_hop(a, d) :- two_hop(a, c), edges(c, d).
three_hop_direct(a, d) :- edges(a, b), edges(b, c), edges(c, d).
self_loop(x) :- edges(x, x).
loop_pairs(x, y) :- self_loop(x), self_loop(y).
