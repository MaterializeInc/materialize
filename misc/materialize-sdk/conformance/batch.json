{
  "function": "batch",
  "cases": [
    {
      "name": "the AS OF releases nothing, and the snapshot is released when its timestamp closes",
      "input": {
        "start": {"kind": "snapshot"},
        "steps": [
          {"message": "progress", "frontier": "10"},
          {"message": "update", "timestamp": "10", "op": "diff", "row": ["a"], "diff": "1"},
          {"message": "progress", "frontier": "11"},
          {"message": "update", "timestamp": "12", "op": "diff", "row": ["b"], "diff": "1"},
          {"message": "progress", "frontier": "13"}
        ]
      },
      "expect": {
        "outputs": [
          [],
          [],
          [
            {
              "event": "batch",
              "lower": null,
              "upper": "11",
              "snapshot": true,
              "updates": [{"timestamp": "10", "op": "diff", "row": ["a"], "diff": "1"}]
            }
          ],
          [],
          [
            {
              "event": "batch",
              "lower": "11",
              "upper": "13",
              "snapshot": false,
              "updates": [{"timestamp": "12", "op": "diff", "row": ["b"], "diff": "1"}]
            }
          ]
        ],
        "finished": false
      }
    },
    {
      "name": "a snapshot at a requested AS OF",
      "input": {
        "start": {"kind": "snapshot", "as_of": "10"},
        "steps": [
          {"message": "progress", "frontier": "10"},
          {"message": "update", "timestamp": "10", "op": "diff", "row": ["a"], "diff": "1"},
          {"message": "progress", "frontier": "11"}
        ]
      },
      "expect": {
        "outputs": [
          [],
          [],
          [
            {
              "event": "batch",
              "lower": null,
              "upper": "11",
              "snapshot": true,
              "updates": [{"timestamp": "10", "op": "diff", "row": ["a"], "diff": "1"}]
            }
          ]
        ],
        "finished": false
      }
    },
    {
      "name": "a snapshot at another AS OF is refused, and every later step too",
      "input": {
        "start": {"kind": "snapshot", "as_of": "10"},
        "steps": [{"message": "progress", "frontier": "11"}, {"message": "progress", "frontier": "12"}]
      },
      "expect": {"outputs": [{"error": "protocol"}, {"error": "protocol"}], "finished": false}
    },
    {
      "name": "a resume starts at F - 1 and continues from F",
      "input": {
        "start": {"kind": "resume", "frontier": "10"},
        "steps": [
          {"message": "progress", "frontier": "9"},
          {"message": "update", "timestamp": "10", "op": "diff", "row": ["a"], "diff": "1"},
          {"message": "progress", "frontier": "11"}
        ]
      },
      "expect": {
        "outputs": [
          [],
          [],
          [
            {
              "event": "batch",
              "lower": "10",
              "upper": "11",
              "snapshot": false,
              "updates": [{"timestamp": "10", "op": "diff", "row": ["a"], "diff": "1"}]
            }
          ]
        ],
        "finished": false
      }
    },
    {
      "name": "a resume that starts at F would skip updates at F",
      "input": {"start": {"kind": "resume", "frontier": "10"}, "steps": [{"message": "progress", "frontier": "10"}]},
      "expect": {"outputs": [{"error": "protocol"}], "finished": false}
    },
    {
      "name": "a resume that starts below F - 1 would repeat updates",
      "input": {"start": {"kind": "resume", "frontier": "10"}, "steps": [{"message": "progress", "frontier": "8"}]},
      "expect": {"outputs": [{"error": "protocol"}], "finished": false}
    },
    {
      "name": "an update below the resume frontier is a duplicate",
      "input": {
        "start": {"kind": "resume", "frontier": "10"},
        "steps": [
          {"message": "progress", "frontier": "9"},
          {"message": "update", "timestamp": "9", "op": "diff", "row": ["a"], "diff": "1"}
        ]
      },
      "expect": {"outputs": [[], {"error": "protocol"}], "finished": false}
    },
    {
      "name": "an advance without updates is an empty batch, and a repeated frontier is nothing",
      "input": {
        "start": {"kind": "resume", "frontier": "10"},
        "steps": [
          {"message": "progress", "frontier": "9"},
          {"message": "progress", "frontier": "20"},
          {"message": "progress", "frontier": "20"}
        ]
      },
      "expect": {
        "outputs": [[], [{"event": "batch", "lower": "10", "upper": "20", "snapshot": false, "updates": []}], []],
        "finished": false
      }
    },
    {
      "name": "updates stay pending until a progress row passes them",
      "input": {
        "start": {"kind": "resume", "frontier": "10"},
        "steps": [
          {"message": "progress", "frontier": "9"},
          {"message": "update", "timestamp": "10", "op": "diff", "row": ["a"], "diff": "1"},
          {"message": "update", "timestamp": "11", "op": "diff", "row": ["b"], "diff": "1"},
          {"message": "progress", "frontier": "11"},
          {"message": "progress", "frontier": "12"}
        ]
      },
      "expect": {"outputs": [[], [], [], {"error": "protocol"}, {"error": "protocol"}], "finished": false}
    },
    {
      "name": "progress follows the updates below it",
      "input": {
        "start": {"kind": "resume", "frontier": "10"},
        "steps": [
          {"message": "progress", "frontier": "9"},
          {"message": "update", "timestamp": "10", "op": "diff", "row": ["a"], "diff": "1"},
          {"message": "update", "timestamp": "11", "op": "diff", "row": ["b"], "diff": "1"},
          {"message": "progress", "frontier": "12"}
        ]
      },
      "expect": {
        "outputs": [
          [],
          [],
          [],
          [
            {
              "event": "batch",
              "lower": "10",
              "upper": "12",
              "snapshot": false,
              "updates": [
                {"timestamp": "10", "op": "diff", "row": ["a"], "diff": "1"},
                {"timestamp": "11", "op": "diff", "row": ["b"], "diff": "1"}
              ]
            }
          ]
        ],
        "finished": false
      }
    },
    {
      "name": "an update before the first progress row is refused",
      "input": {
        "start": {"kind": "snapshot"},
        "steps": [{"message": "update", "timestamp": "10", "op": "diff", "row": ["a"], "diff": "1"}]
      },
      "expect": {"outputs": [{"error": "protocol"}], "finished": false}
    },
    {
      "name": "an update below the latest progress row is refused",
      "input": {
        "start": {"kind": "snapshot"},
        "steps": [
          {"message": "progress", "frontier": "10"},
          {"message": "progress", "frontier": "12"},
          {"message": "update", "timestamp": "11", "op": "diff", "row": ["a"], "diff": "1"}
        ]
      },
      "expect": {
        "outputs": [
          [],
          [{"event": "batch", "lower": null, "upper": "12", "snapshot": true, "updates": []}],
          {"error": "protocol"}
        ],
        "finished": false
      }
    },
    {
      "name": "an update out of timestamp order is refused",
      "input": {
        "start": {"kind": "snapshot"},
        "steps": [
          {"message": "progress", "frontier": "10"},
          {"message": "update", "timestamp": "11", "op": "diff", "row": ["a"], "diff": "1"},
          {"message": "update", "timestamp": "10", "op": "diff", "row": ["b"], "diff": "1"}
        ]
      },
      "expect": {"outputs": [[], [], {"error": "protocol"}], "finished": false}
    },
    {
      "name": "progress going back is refused",
      "input": {
        "start": {"kind": "snapshot"},
        "steps": [{"message": "progress", "frontier": "10"}, {"message": "progress", "frontier": "9"}]
      },
      "expect": {"outputs": [[], {"error": "protocol"}], "finished": false}
    },
    {
      "name": "UP TO caps the frontier and ends the stream",
      "input": {
        "start": {"kind": "snapshot"},
        "steps": [
          {"message": "progress", "frontier": "10"},
          {"message": "update", "timestamp": "10", "op": "diff", "row": ["a"], "diff": "1"},
          {"message": "update", "timestamp": "14", "op": "diff", "row": ["b"], "diff": "1"},
          {"message": "progress", "frontier": "100"}
        ],
        "up_to": "15"
      },
      "expect": {
        "outputs": [
          [],
          [],
          [],
          [
            {
              "event": "batch",
              "lower": null,
              "upper": "15",
              "snapshot": true,
              "updates": [
                {"timestamp": "10", "op": "diff", "row": ["a"], "diff": "1"},
                {"timestamp": "14", "op": "diff", "row": ["b"], "diff": "1"}
              ]
            }
          ]
        ],
        "finished": true
      }
    },
    {
      "name": "more progress past UP TO, as several workers send, changes nothing",
      "input": {
        "start": {"kind": "snapshot"},
        "steps": [
          {"message": "progress", "frontier": "10"},
          {"message": "update", "timestamp": "10", "op": "diff", "row": ["a"], "diff": "1"},
          {"message": "update", "timestamp": "12", "op": "diff", "row": ["b"], "diff": "1"},
          {"message": "progress", "frontier": "25"},
          {"message": "progress", "frontier": "27"}
        ],
        "up_to": "15"
      },
      "expect": {
        "outputs": [
          [],
          [],
          [],
          [{"event": "batch", "lower": null, "upper": "15", "snapshot": true, "updates": [{"timestamp": "10", "op": "diff", "row": ["a"], "diff": "1"}, {"timestamp": "12", "op": "diff", "row": ["b"], "diff": "1"}]}],
          []
        ],
        "finished": true
      }
    },
    {
      "name": "no update follows the end of the stream at UP TO",
      "input": {
        "start": {"kind": "snapshot"},
        "steps": [
          {"message": "progress", "frontier": "10"},
          {"message": "progress", "frontier": "15"},
          {"message": "progress", "frontier": "16"},
          {"message": "update", "timestamp": "12", "op": "diff", "row": ["a"], "diff": "1"}
        ],
        "up_to": "15"
      },
      "expect": {
        "outputs": [
          [],
          [{"event": "batch", "lower": null, "upper": "15", "snapshot": true, "updates": []}],
          [],
          {"error": "protocol"}
        ],
        "finished": true
      }
    },
    {
      "name": "progress past UP TO still cannot go back",
      "input": {
        "start": {"kind": "snapshot"},
        "steps": [
          {"message": "progress", "frontier": "10"},
          {"message": "progress", "frontier": "17"},
          {"message": "progress", "frontier": "16"}
        ],
        "up_to": "15"
      },
      "expect": {
        "outputs": [
          [],
          [{"event": "batch", "lower": null, "upper": "15", "snapshot": true, "updates": []}],
          {"error": "protocol"}
        ],
        "finished": true
      }
    },
    {
      "name": "an update at UP TO is refused",
      "input": {
        "start": {"kind": "snapshot"},
        "steps": [
          {"message": "progress", "frontier": "10"},
          {"message": "update", "timestamp": "15", "op": "diff", "row": ["a"], "diff": "1"}
        ],
        "up_to": "15"
      },
      "expect": {"outputs": [[], {"error": "protocol"}], "finished": false}
    },
    {
      "name": "the end of a bounded stream releases up to UP TO without a final progress row (SQL-528)",
      "input": {
        "start": {"kind": "resume", "frontier": "10"},
        "steps": [
          {"message": "progress", "frontier": "9"},
          {"message": "update", "timestamp": "15", "op": "diff", "row": ["a"], "diff": "1"},
          {"message": "progress", "frontier": "16"},
          {"message": "update", "timestamp": "19", "op": "diff", "row": ["b"], "diff": "1"},
          "finish"
        ],
        "up_to": "20"
      },
      "expect": {
        "outputs": [
          [],
          [],
          [
            {
              "event": "batch",
              "lower": "10",
              "upper": "16",
              "snapshot": false,
              "updates": [{"timestamp": "15", "op": "diff", "row": ["a"], "diff": "1"}]
            }
          ],
          [],
          [
            {
              "event": "batch",
              "lower": "16",
              "upper": "20",
              "snapshot": false,
              "updates": [{"timestamp": "19", "op": "diff", "row": ["b"], "diff": "1"}]
            }
          ]
        ],
        "finished": true
      }
    },
    {
      "name": "the end of an unbounded stream releases every update",
      "input": {
        "start": {"kind": "snapshot"},
        "steps": [
          {"message": "progress", "frontier": "10"},
          {"message": "update", "timestamp": "10", "op": "diff", "row": ["a"], "diff": "1"},
          {"message": "update", "timestamp": "13", "op": "diff", "row": ["b"], "diff": "1"},
          "finish"
        ]
      },
      "expect": {
        "outputs": [
          [],
          [],
          [],
          [
            {
              "event": "batch",
              "lower": null,
              "upper": "14",
              "snapshot": true,
              "updates": [
                {"timestamp": "10", "op": "diff", "row": ["a"], "diff": "1"},
                {"timestamp": "13", "op": "diff", "row": ["b"], "diff": "1"}
              ]
            }
          ]
        ],
        "finished": true
      }
    },
    {
      "name": "the end of an unbounded stream closes the latest progress row's timestamp too",
      "input": {
        "start": {"kind": "resume", "frontier": "10"},
        "steps": [{"message": "progress", "frontier": "9"}, {"message": "progress", "frontier": "12"}, "finish"]
      },
      "expect": {
        "outputs": [
          [],
          [{"event": "batch", "lower": "10", "upper": "12", "snapshot": false, "updates": []}],
          [{"event": "batch", "lower": "12", "upper": "13", "snapshot": false, "updates": []}]
        ],
        "finished": true
      }
    },
    {
      "name": "a constant query completes past the largest timestamp",
      "input": {
        "start": {"kind": "snapshot"},
        "steps": [
          {"message": "progress", "frontier": "18446744073709551615"},
          {"message": "update", "timestamp": "18446744073709551615", "op": "diff", "row": ["a"], "diff": "1"},
          "finish"
        ]
      },
      "expect": {
        "outputs": [
          [],
          [],
          [
            {
              "event": "batch",
              "lower": null,
              "upper": "18446744073709551616",
              "snapshot": true,
              "updates": [{"timestamp": "18446744073709551615", "op": "diff", "row": ["a"], "diff": "1"}]
            }
          ]
        ],
        "finished": true
      }
    },
    {
      "name": "a constant query with an earlier AS OF completes past the largest timestamp",
      "input": {
        "start": {"kind": "snapshot"},
        "steps": [
          {"message": "progress", "frontier": "42"},
          {"message": "update", "timestamp": "18446744073709551615", "op": "diff", "row": ["a"], "diff": "1"},
          "finish"
        ]
      },
      "expect": {
        "outputs": [
          [],
          [],
          [
            {
              "event": "batch",
              "lower": null,
              "upper": "18446744073709551616",
              "snapshot": true,
              "updates": [{"timestamp": "18446744073709551615", "op": "diff", "row": ["a"], "diff": "1"}]
            }
          ]
        ],
        "finished": true
      }
    },
    {
      "name": "an empty constant query completes with an empty snapshot",
      "input": {
        "start": {"kind": "snapshot"},
        "steps": [{"message": "progress", "frontier": "18446744073709551615"}, "finish"]
      },
      "expect": {
        "outputs": [
          [],
          [
            {
              "event": "batch",
              "lower": null,
              "upper": "18446744073709551616",
              "snapshot": true,
              "updates": []
            }
          ]
        ],
        "finished": true
      }
    },
    {
      "name": "a stream that ends before any progress row is refused",
      "input": {"start": {"kind": "snapshot"}, "steps": ["finish"]},
      "expect": {"outputs": [{"error": "protocol"}], "finished": false}
    },
    {
      "name": "UP TO at the AS OF ends with nothing to release",
      "input": {
        "start": {"kind": "snapshot"},
        "steps": [{"message": "progress", "frontier": "10"}, "finish"],
        "up_to": "10"
      },
      "expect": {"outputs": [[], []], "finished": true}
    },
    {
      "name": "the end after an early release continues from it",
      "input": {
        "start": {"kind": "resume", "frontier": "10"},
        "steps": [
          {"message": "progress", "frontier": "9"},
          {"message": "update", "timestamp": "10", "op": "diff", "row": ["a"], "diff": "1"},
          {"message": "update", "timestamp": "11", "op": "diff", "row": ["b"], "diff": "1"},
          {"message": "update", "timestamp": "12", "op": "diff", "row": ["c"], "diff": "1"},
          "finish"
        ],
        "up_to": "20",
        "max_pending_bytes": "178"
      },
      "expect": {
        "outputs": [
          [],
          [],
          [],
          [
            {
              "event": "batch",
              "lower": "10",
              "upper": "12",
              "snapshot": false,
              "updates": [
                {"timestamp": "10", "op": "diff", "row": ["a"], "diff": "1"},
                {"timestamp": "11", "op": "diff", "row": ["b"], "diff": "1"}
              ]
            }
          ],
          [
            {
              "event": "batch",
              "lower": "12",
              "upper": "20",
              "snapshot": false,
              "updates": [{"timestamp": "12", "op": "diff", "row": ["c"], "diff": "1"}]
            }
          ]
        ],
        "finished": true
      }
    },
    {
      "name": "the memory limit releases complete timestamps early",
      "input": {
        "start": {"kind": "resume", "frontier": "10"},
        "steps": [
          {"message": "progress", "frontier": "9"},
          {"message": "update", "timestamp": "10", "op": "diff", "row": ["a"], "diff": "1"},
          {"message": "update", "timestamp": "11", "op": "diff", "row": ["b"], "diff": "1"},
          {"message": "update", "timestamp": "12", "op": "diff", "row": ["c"], "diff": "1"},
          {"message": "progress", "frontier": "13"}
        ],
        "max_pending_bytes": "178"
      },
      "expect": {
        "outputs": [
          [],
          [],
          [],
          [
            {
              "event": "batch",
              "lower": "10",
              "upper": "12",
              "snapshot": false,
              "updates": [
                {"timestamp": "10", "op": "diff", "row": ["a"], "diff": "1"},
                {"timestamp": "11", "op": "diff", "row": ["b"], "diff": "1"}
              ]
            }
          ],
          [
            {
              "event": "batch",
              "lower": "12",
              "upper": "13",
              "snapshot": false,
              "updates": [{"timestamp": "12", "op": "diff", "row": ["c"], "diff": "1"}]
            }
          ]
        ],
        "finished": false
      }
    },
    {
      "name": "the memory limit charges updates without text",
      "input": {
        "start": {"kind": "resume", "frontier": "10"},
        "steps": [
          {"message": "progress", "frontier": "9"},
          {"message": "update", "timestamp": "10", "op": "diff", "row": [null], "diff": "1"},
          {"message": "update", "timestamp": "11", "op": "diff", "row": [null], "diff": "1"}
        ],
        "max_pending_bytes": "1"
      },
      "expect": {
        "outputs": [
          [],
          [],
          [
            {
              "event": "batch",
              "lower": "10",
              "upper": "11",
              "snapshot": false,
              "updates": [{"timestamp": "10", "op": "diff", "row": [null], "diff": "1"}]
            }
          ]
        ],
        "finished": false
      }
    },
    {
      "name": "the memory limit releases the snapshot in chunks",
      "input": {
        "start": {"kind": "snapshot"},
        "steps": [
          {"message": "progress", "frontier": "10"},
          {"message": "update", "timestamp": "10", "op": "diff", "row": ["a"], "diff": "1"},
          {"message": "update", "timestamp": "10", "op": "diff", "row": ["b"], "diff": "1"},
          {"message": "update", "timestamp": "10", "op": "diff", "row": ["c"], "diff": "1"},
          {"message": "progress", "frontier": "11"}
        ],
        "max_pending_bytes": "89"
      },
      "expect": {
        "outputs": [
          [],
          [],
