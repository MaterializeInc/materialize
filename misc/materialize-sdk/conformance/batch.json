          {"message": "update", "timestamp": "10", "op": "diff", "row": ["b"], "diff": "1"},
          {"message": "update", "timestamp": "12", "op": "diff", "row": ["c"], "diff": "1"},
          {"message": "update", "timestamp": "13", "op": "diff", "row": ["d"], "diff": "1"}
        ],
        "max_pending_bytes": "89"
      },
      "expect": {
        "outputs": [
          [],
          [],
          [
            {
              "event": "snapshot_chunk",
              "updates": [
                {"timestamp": "10", "op": "diff", "row": ["a"], "diff": "1"},
                {"timestamp": "10", "op": "diff", "row": ["b"], "diff": "1"}
              ]
            }
          ],
          [],
          [
            {
              "event": "batch",
              "lower": null,
              "upper": "13",
              "snapshot": true,
              "updates": [{"timestamp": "12", "op": "diff", "row": ["c"], "diff": "1"}]
            }
          ]
        ],
        "finished": false
      }
    },
    {
      "name": "a chunked snapshot completes at the end of the stream",
      "input": {
        "start": {"kind": "snapshot"},
        "steps": [
          {"message": "progress", "frontier": "10"},
          {"message": "update", "timestamp": "10", "op": "diff", "row": ["a"], "diff": "1"},
          {"message": "update", "timestamp": "10", "op": "diff", "row": ["b"], "diff": "1"},
          "finish"
        ],
        "max_pending_bytes": "89"
      },
      "expect": {
        "outputs": [
          [],
          [],
          [
            {
              "event": "snapshot_chunk",
              "updates": [
                {"timestamp": "10", "op": "diff", "row": ["a"], "diff": "1"},
                {"timestamp": "10", "op": "diff", "row": ["b"], "diff": "1"}
              ]
            }
          ],
          [{"event": "batch", "lower": null, "upper": "11", "snapshot": true, "updates": []}]
