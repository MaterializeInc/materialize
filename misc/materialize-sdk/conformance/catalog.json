      },
      "expect": {
        "object": {
          "object": {"id": "u5", "database": "materialize", "schema": "public", "name": "v"},
          "kind": {"other": "view"},
          "shard": null,
          "retention_ms": null,
          "columns": [{"name": "?column?", "type_oid": 23, "type_mod": -1, "nullable": false}]
        }
      }
    },
