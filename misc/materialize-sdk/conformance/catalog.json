      },
      "expect": {
        "fingerprint": {
          "object": {"id": "u1", "database": "materialize", "schema": "public", "name": "o"},
          "shard": "s1",
          "envelope": {"kind": "diff"},
          "columns": [{"name": "id", "type_oid": 20, "type_mod": -1, "nullable": false}]
        }
      }
