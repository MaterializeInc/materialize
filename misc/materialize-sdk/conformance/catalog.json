{
  "function": "catalog",
  "cases": [
    {
      "name": "the lookup names every part, with quotes doubled",
      "input": {"lookup_sql": {"name": {"database": "materialize", "schema": "public", "name": "it's"}}},
      "expect": {
        "sql": "SELECT o.id, o.type, d.name AS database, s.name AS schema, o.name, (SELECT count(DISTINCT sh.shard_id) FROM mz_internal.mz_object_global_ids AS g JOIN mz_internal.mz_storage_shards AS sh ON sh.object_id = g.global_id WHERE g.id = o.id) AS shards, (SELECT min(sh.shard_id) FROM mz_internal.mz_object_global_ids AS g JOIN mz_internal.mz_storage_shards AS sh ON sh.object_id = g.global_id WHERE g.id = o.id) AS shard, (SELECT r.value::text FROM mz_internal.mz_history_retention_strategies AS r WHERE r.id = o.id AND r.strategy = 'FOR') AS retention_ms, c.name AS column, c.type_oid, c.type_mod, c.nullable FROM mz_catalog.mz_objects AS o JOIN mz_catalog.mz_schemas AS s ON s.id = o.schema_id LEFT JOIN mz_catalog.mz_databases AS d ON d.id = s.database_id LEFT JOIN mz_catalog.mz_columns AS c ON c.id = o.id WHERE o.type IN ('table', 'source', 'view', 'materialized-view') AND o.name = 'it''s' AND s.name = 'public' AND d.name = 'materialize' ORDER BY c.position"
      }
    },
    {
      "name": "an ambient schema has no database",
      "input": {"lookup_sql": {"name": {"database": null, "schema": "mz_catalog", "name": "mz_tables"}}},
      "expect": {
        "sql": "SELECT o.id, o.type, d.name AS database, s.name AS schema, o.name, (SELECT count(DISTINCT sh.shard_id) FROM mz_internal.mz_object_global_ids AS g JOIN mz_internal.mz_storage_shards AS sh ON sh.object_id = g.global_id WHERE g.id = o.id) AS shards, (SELECT min(sh.shard_id) FROM mz_internal.mz_object_global_ids AS g JOIN mz_internal.mz_storage_shards AS sh ON sh.object_id = g.global_id WHERE g.id = o.id) AS shard, (SELECT r.value::text FROM mz_internal.mz_history_retention_strategies AS r WHERE r.id = o.id AND r.strategy = 'FOR') AS retention_ms, c.name AS column, c.type_oid, c.type_mod, c.nullable FROM mz_catalog.mz_objects AS o JOIN mz_catalog.mz_schemas AS s ON s.id = o.schema_id LEFT JOIN mz_catalog.mz_databases AS d ON d.id = s.database_id LEFT JOIN mz_catalog.mz_columns AS c ON c.id = o.id WHERE o.type IN ('table', 'source', 'view', 'materialized-view') AND o.name = 'mz_tables' AND s.name = 'mz_catalog' AND s.database_id IS NULL ORDER BY c.position"
      }
    },
    {
      "name": "a table after ADD COLUMN: one shard, columns in order",
      "input": {
        "parse_lookup": {
          "columns": [
            "id",
            "type",
            "database",
            "schema",
            "name",
            "shards",
            "shard",
            "retention_ms",
            "column",
            "type_oid",
            "type_mod",
            "nullable"
          ],
          "rows": [
            [
              "u1",
              "table",
              "materialize",
              "public",
              "ct",
              "1",
              "s852e621d-b0d7-4dff-a3af-6a13305eb76a",
              "1000",
              "a",
              "23",
              "-1",
              "t"
            ],
            [
              "u1",
              "table",
              "materialize",
              "public",
              "ct",
              "1",
              "s852e621d-b0d7-4dff-a3af-6a13305eb76a",
              "1000",
              "b",
              "25",
              "-1",
              "t"
            ]
          ]
        }
      },
      "expect": {
        "object": {
          "object": {"id": "u1", "database": "materialize", "schema": "public", "name": "ct"},
          "kind": "table",
          "shard": "s852e621d-b0d7-4dff-a3af-6a13305eb76a",
          "retention_ms": "1000",
          "columns": [
            {"name": "a", "type_oid": 23, "type_mod": -1, "nullable": true},
            {"name": "b", "type_oid": 25, "type_mod": -1, "nullable": true}
          ]
        }
      }
    },
    {
      "name": "a materialized view with RETAIN HISTORY",
      "input": {
        "parse_lookup": {
          "columns": [
            "id",
            "type",
            "database",
            "schema",
            "name",
            "shards",
            "shard",
            "retention_ms",
            "column",
            "type_oid",
            "type_mod",
            "nullable"
          ],
          "rows": [
            [
              "u4",
              "materialized-view",
              "materialize",
              "public",
              "keep",
              "1",
              "s5",
              "3600000",
              "a",
              "23",
              "-1",
              "t"
            ]
          ]
        }
      },
      "expect": {
        "object": {
          "object": {"id": "u4", "database": "materialize", "schema": "public", "name": "keep"},
          "kind": "materialized_view",
          "shard": "s5",
          "retention_ms": "3600000",
          "columns": [{"name": "a", "type_oid": 23, "type_mod": -1, "nullable": true}]
        }
      }
    },
    {
      "name": "a view has no shard and no retention",
      "input": {
        "parse_lookup": {
          "columns": [
            "id",
            "type",
            "database",
            "schema",
            "name",
            "shards",
            "shard",
            "retention_ms",
            "column",
            "type_oid",
            "type_mod",
            "nullable"
          ],
          "rows": [["u5", "view", "materialize", "public", "v", "0", null, null, "?column?", "23", "-1", "f"]]
