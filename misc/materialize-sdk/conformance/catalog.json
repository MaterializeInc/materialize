    {
      "name": "the index query names the object and the cluster",
      "input": {"indexes_sql": {"object_id": "u1", "cluster": "quickstart"}},
      "expect": {
        "sql": "SELECT i.name FROM mz_catalog.mz_indexes AS i JOIN mz_catalog.mz_clusters AS c ON c.id = i.cluster_id WHERE i.on_id = 'u1' AND c.name = 'quickstart' ORDER BY i.name"
      }
    },
    {
      "name": "an index on the subscribing cluster",
      "input": {"parse_indexes": {"columns": ["name"], "rows": [["ct_idx"]]}},
      "expect": {"indexes": ["ct_idx"]}
    },
    {
      "name": "no index",
      "input": {"parse_indexes": {"columns": ["name"], "rows": []}},
      "expect": {"indexes": []}
    },
    {
      "name": "the read frontier query takes the highest frontier of the object's versions",
      "input": {"read_frontier_sql": {"object_id": "u4"}},
      "expect": {
        "sql": "SELECT max(f.read_frontier) AS read_frontier FROM mz_internal.mz_object_global_ids AS g JOIN mz_internal.mz_frontiers AS f ON f.object_id = g.global_id WHERE g.id = 'u4'"
      }
    },
    {
      "name": "a read frontier",
      "input": {"parse_read_frontier": {"columns": ["read_frontier"], "rows": [["1791907896000"]]}},
      "expect": {"read_frontier": "1791907896000"}
    },
    {
      "name": "an object with no readable time",
      "input": {"parse_read_frontier": {"columns": ["read_frontier"], "rows": [[null]]}},
      "expect": {"read_frontier": null}
    },
    {
      "name": "the margin is how far AS OF F - 1 is above the read frontier",
      "input": {"resume_margin": {"frontier": "1791907900001", "read_frontier": "1791907896000"}},
      "expect": {"margin_ms": "4000"}
    },
    {
      "name": "AS OF at the read frontier has no margin left",
      "input": {"resume_margin": {"frontier": "1001", "read_frontier": "1000"}},
      "expect": {"margin_ms": "0"}
    },
    {
      "name": "AS OF below the read frontier has lost history",
      "input": {"resume_margin": {"frontier": "1001", "read_frontier": "1001"}},
      "expect": {"margin_ms": null}
    },
    {
      "name": "a table's fingerprint",
