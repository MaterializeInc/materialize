    {
      "name": "a constant query completes past the largest timestamp",
      "input": {
        "subscribe": {"target": {"kind": "query", "sql": "SELECT 1"}, "envelope": {"kind": "diff"}},
        "start": {"kind": "snapshot"},
        "steps": [
          {"fetch": {"max_rows": "100", "timeout_ms": "1000"}},
          {
            "push": {
              "columns": ["mz_timestamp", "mz_progressed", "mz_diff", "?column?"],
              "rows": [["18446744073709551615", "t", null, null], ["18446744073709551615", "f", "1", "1"]]
            }
          },
          {"fetch": {"max_rows": "100", "timeout_ms": "1000"}},
          {"push": {"columns": [], "rows": []}},
          {"fetch": {"max_rows": "100", "timeout_ms": "1000"}},
          {"push": {"columns": [], "rows": []}}
        ]
      },
      "expect": [
        {
          "declare": "DECLARE \"materialize_sdk\" CURSOR FOR SUBSCRIBE (\nSELECT 1\n) WITH (PROGRESS, SNAPSHOT = true)"
        },
        {"sql": "FETCH 100 \"materialize_sdk\" WITH (TIMEOUT = '1000 milliseconds')", "timeout_ms": "1000"},
        {"events": [], "finished": false},
        {"sql": "FETCH 100 \"materialize_sdk\" WITH (TIMEOUT = '1000 milliseconds')", "timeout_ms": "1000"},
        {"events": [], "finished": false},
        {"sql": "FETCH 100 \"materialize_sdk\"", "timeout_ms": null},
        {
          "events": [
            {
              "event": "batch",
              "lower": null,
              "upper": "18446744073709551616",
              "snapshot": true,
              "updates": [{"timestamp": "18446744073709551615", "op": "diff", "row": ["1"], "diff": "1"}]
            }
          ],
          "finished": true
        }
      ]
    },
