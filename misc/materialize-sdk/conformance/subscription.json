    {
      "name": "a snapshot split across FETCHes is released once its timestamp closes",
      "input": {
        "subscribe": {
          "target": {"kind": "object", "id": "u42", "database": "materialize", "schema": "public", "name": "orders"},
          "envelope": {"kind": "diff"}
        },
        "start": {"kind": "snapshot"},
        "steps": [
          {"fetch": {"max_rows": "100", "timeout_ms": "1000"}},
          {
            "push": {
              "columns": ["mz_timestamp", "mz_progressed", "mz_diff", "id"],
              "rows": [["5", "t", null, null], ["5", "f", "1", "a"]]
            }
          },
          {"fetch": {"max_rows": "100", "timeout_ms": "1000"}},
          {
            "push": {"columns": ["mz_timestamp", "mz_progressed", "mz_diff", "id"], "rows": [["5", "f", "1", "b"]]}
          },
          {"fetch": {"max_rows": "100", "timeout_ms": "1000"}},
          {
            "push": {"columns": ["mz_timestamp", "mz_progressed", "mz_diff", "id"], "rows": [["6", "t", null, null]]}
          }
        ]
      },
      "expect": [
        {
          "declare": "DECLARE \"materialize_sdk\" CURSOR FOR SUBSCRIBE [\"u42\" AS \"materialize\".\"public\".\"orders\"] WITH (PROGRESS, SNAPSHOT = true)"
        },
        {"sql": "FETCH 100 \"materialize_sdk\" WITH (TIMEOUT = '1000 milliseconds')", "timeout_ms": "1000"},
        {"events": [], "finished": false},
        {"sql": "FETCH 100 \"materialize_sdk\" WITH (TIMEOUT = '1000 milliseconds')", "timeout_ms": "1000"},
        {"events": [], "finished": false},
        {"sql": "FETCH 100 \"materialize_sdk\" WITH (TIMEOUT = '1000 milliseconds')", "timeout_ms": "1000"},
        {
          "events": [
            {
              "event": "batch",
              "lower": null,
              "upper": "6",
              "snapshot": true,
              "updates": [
                {"timestamp": "5", "op": "diff", "row": ["a"], "diff": "1"},
                {"timestamp": "5", "op": "diff", "row": ["b"], "diff": "1"}
              ]
            }
          ],
          "finished": false
        }
      ]
    },
    {
      "name": "a stream that ends before its first progress row is refused",
      "input": {
        "subscribe": {
          "target": {"kind": "object", "id": "u42", "database": "materialize", "schema": "public", "name": "orders"},
          "envelope": {"kind": "diff"}
        },
        "start": {"kind": "snapshot"},
        "steps": [
          {"fetch": {"max_rows": "100"}},
          {"push": {"columns": ["mz_timestamp", "mz_progressed", "mz_diff", "id"], "rows": []}},
          {"fetch": {"max_rows": "100", "timeout_ms": "1000"}}
        ]
      },
      "expect": [
        {
          "declare": "DECLARE \"materialize_sdk\" CURSOR FOR SUBSCRIBE [\"u42\" AS \"materialize\".\"public\".\"orders\"] WITH (PROGRESS, SNAPSHOT = true)"
        },
        {"sql": "FETCH 100 \"materialize_sdk\"", "timeout_ms": null},
        {"error": "protocol"},
        {"error": "usage"}
      ]
    },
    {
      "name": "only one FETCH is outstanding at a time",
