{
  "function": "subscription",
  "cases": [
    {
      "name": "a snapshot, then a quiet stream probed after an empty timed FETCH",
      "input": {
        "subscribe": {
          "target": {"kind": "object", "id": "u42", "database": "materialize", "schema": "public", "name": "orders"},
          "envelope": {"kind": "diff"}
        },
        "start": {"kind": "snapshot"},
        "steps": [
          {"fetch": {"max_rows": "100", "timeout_ms": "1000"}},
          {
            "push": {
              "columns": ["mz_timestamp", "mz_progressed", "mz_diff", "id"],
              "rows": [["5", "t", null, null], ["5", "f", "1", "a"], ["6", "t", null, null]]
            }
          },
          {"fetch": {"max_rows": "100", "timeout_ms": "1000"}},
          {"push": {"columns": ["mz_timestamp", "mz_progressed", "mz_diff", "id"], "rows": []}},
          {"fetch": {"max_rows": "100", "timeout_ms": "1000"}},
          {
            "push": {"columns": ["mz_timestamp", "mz_progressed", "mz_diff", "id"], "rows": [["7", "t", null, null]]}
          },
          {"fetch": {"max_rows": "100", "timeout_ms": "1000"}}
        ]
      },
      "expect": [
        {
          "declare": "DECLARE \"materialize_sdk\" CURSOR FOR SUBSCRIBE [\"u42\" AS \"materialize\".\"public\".\"orders\"] WITH (PROGRESS, SNAPSHOT = true)"
        },
        {"sql": "FETCH 100 \"materialize_sdk\" WITH (TIMEOUT = '1000 milliseconds')", "timeout_ms": "1000"},
        {
          "events": [
            {
              "event": "batch",
              "lower": null,
              "upper": "6",
              "snapshot": true,
              "updates": [{"timestamp": "5", "op": "diff", "row": ["a"], "diff": "1"}]
            }
          ],
          "finished": false
        },
        {"sql": "FETCH 100 \"materialize_sdk\" WITH (TIMEOUT = '1000 milliseconds')", "timeout_ms": "1000"},
        {"events": [], "finished": false},
        {"sql": "FETCH 100 \"materialize_sdk\"", "timeout_ms": null},
        {
          "events": [{"event": "batch", "lower": "6", "upper": "7", "snapshot": false, "updates": []}],
          "finished": false
        },
        {"sql": "FETCH 100 \"materialize_sdk\" WITH (TIMEOUT = '1000 milliseconds')", "timeout_ms": "1000"}
      ]
    },
    {
      "name": "an empty probe ends a bounded stream at UP TO",
      "input": {
        "subscribe": {
          "target": {"kind": "object", "id": "u42", "database": "materialize", "schema": "public", "name": "orders"},
          "envelope": {"kind": "diff"},
          "up_to": "20"
        },
        "start": {"kind": "resume", "frontier": "10"},
        "steps": [
          {"fetch": {"max_rows": "100", "timeout_ms": "1000"}},
          {
            "push": {
              "columns": ["mz_timestamp", "mz_progressed", "mz_diff", "id"],
              "rows": [["9", "t", null, null], ["12", "f", "1", "a"]]
            }
          },
          {"fetch": {"max_rows": "100", "timeout_ms": "1000"}},
          {"push": {"columns": ["mz_timestamp", "mz_progressed", "mz_diff", "id"], "rows": []}},
          {"fetch": {"max_rows": "100", "timeout_ms": "1000"}},
          {"push": {"columns": ["mz_timestamp", "mz_progressed", "mz_diff", "id"], "rows": []}},
          {"fetch": {"max_rows": "100", "timeout_ms": "1000"}}
        ]
      },
      "expect": [
        {
          "declare": "DECLARE \"materialize_sdk\" CURSOR FOR SUBSCRIBE [\"u42\" AS \"materialize\".\"public\".\"orders\"] WITH (PROGRESS, SNAPSHOT = false) AS OF 9 UP TO 20"
        },
        {"sql": "FETCH 100 \"materialize_sdk\" WITH (TIMEOUT = '1000 milliseconds')", "timeout_ms": "1000"},
        {"events": [], "finished": false},
        {"sql": "FETCH 100 \"materialize_sdk\" WITH (TIMEOUT = '1000 milliseconds')", "timeout_ms": "1000"},
        {"events": [], "finished": false},
        {"sql": "FETCH 100 \"materialize_sdk\"", "timeout_ms": null},
        {
          "events": [
            {
              "event": "batch",
              "lower": "10",
              "upper": "20",
              "snapshot": false,
              "updates": [{"timestamp": "12", "op": "diff", "row": ["a"], "diff": "1"}]
            }
          ],
          "finished": true
        },
        {"error": "usage"}
      ]
    },
