# DISCARD ALL reports every parameter in the notify set whose value it changed,
# like SET and transaction ends do.

ws-text
{"query": "SET application_name TO d"}
----
{"type":"CommandStarting","payload":{"has_rows":false,"is_streaming":false}}
{"type":"CommandComplete","payload":"SET"}
{"type":"ParameterStatus","payload":{"name":"application_name","value":"d"}}
{"type":"ReadyForQuery","payload":"I"}

ws-text
{"query": "DISCARD ALL"}
----
{"type":"CommandStarting","payload":{"has_rows":false,"is_streaming":false}}
{"type":"CommandComplete","payload":"DISCARD ALL"}
{"type":"ParameterStatus","payload":{"name":"application_name","value":""}}
{"type":"ReadyForQuery","payload":"I"}

# Nothing changed since the last DISCARD ALL, so nothing is reported.

ws-text
{"query": "DISCARD ALL"}
----
{"type":"CommandStarting","payload":{"has_rows":false,"is_streaming":false}}
{"type":"CommandComplete","payload":"DISCARD ALL"}
{"type":"ReadyForQuery","payload":"I"}
