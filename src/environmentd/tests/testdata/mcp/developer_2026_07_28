# The transport leaves header rules for notifications undefined, so a
# notification without Mcp-Method is still accepted.
mcp-developer
MCP-Protocol-Version: 2026-07-28
{"jsonrpc":"2.0","method":"notifications/initialized"}
----
202 Accepted

# A notification with a matching Mcp-Method is still answered 202.
mcp-developer
MCP-Protocol-Version: 2026-07-28
Mcp-Method: notifications/initialized
{"jsonrpc":"2.0","method":"notifications/initialized"}
----
202 Accepted

