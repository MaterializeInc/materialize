# Runs with enable_mcp_protocol_2026_07_28 on. Lines before the JSON body are
# request headers.

# =============================================================================
# Mcp-Method and Mcp-Name must mirror the body
# =============================================================================

mcp-developer
MCP-Protocol-Version: 2026-07-28
Mcp-Method: tools/call
Mcp-Name: query_system_catalog
{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"query_system_catalog","arguments":{"sql_query":"SELECT name FROM mz_databases WHERE name = 'materialize'"}}}
----
200 OK
{"jsonrpc":"2.0","id":1,"result":{"content":[{"type":"text","text":"[\n  [\"materialize\"]\n]"}],"isError":false}}

