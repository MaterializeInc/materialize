# The columns and join paths the instructions name. The mz_introspection
# relations only resolve with `cluster` set.
mcp-unified
{"jsonrpc":"2.0","id":17,"method":"tools/call","params":{"name":"query","arguments":{"cluster":"quickstart","sql_query":"SELECT (SELECT count(last_status_change_at) FROM mz_internal.mz_source_statuses) >= 0, (SELECT count(last_status_change_at) FROM mz_internal.mz_sink_statuses) >= 0, (SELECT count(c.name) FROM mz_internal.mz_cluster_replica_utilization u JOIN mz_catalog.mz_cluster_replicas r ON u.replica_id = r.id JOIN mz_catalog.mz_clusters c ON r.cluster_id = c.id) >= 0, (SELECT count(*) FROM mz_introspection.mz_dataflow_arrangement_sizes s JOIN mz_introspection.mz_compute_exports e ON s.id = e.dataflow_id JOIN mz_catalog.mz_objects o ON e.export_id = o.id) >= 0, (SELECT count(d.name) FROM mz_introspection.mz_dataflows d JOIN mz_introspection.mz_compute_exports e ON d.id = e.dataflow_id) >= 0, (SELECT pg_typeof(id)::text FROM mz_introspection.mz_dataflows LIMIT 1) IS DISTINCT FROM 'text'"}}}
----
200 OK
{"jsonrpc":"2.0","id":17,"result":{"content":[{"type":"text","text":"[\n  [true,true,true,true,true,true]\n]"}],"isError":false}}
