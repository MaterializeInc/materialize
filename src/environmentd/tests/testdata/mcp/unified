# Data products for the details shape. The cluster has no replicas, so
# hydration does not depend on timing.
sql
CREATE CLUSTER no_replicas REPLICAS ();
CREATE MATERIALIZED VIEW orders_mv IN CLUSTER no_replicas AS SELECT 1 AS id, 'open' AS status;
COMMENT ON MATERIALIZED VIEW orders_mv IS 'Open orders.';
COMMENT ON COLUMN orders_mv.id IS 'Order id.';
CREATE INDEX orders_mv_idx IN CLUSTER no_replicas ON orders_mv (id);
CREATE VIEW orders_view AS SELECT 1 AS id, 'open' AS status;
CREATE INDEX orders_view_idx IN CLUSTER no_replicas ON orders_view (id);
COMMENT ON INDEX orders_view_idx IS 'Orders by id.'
----
ok

