parse-statement roundtrip
DELETE FROM table
----
DELETE FROM "table"

parse-statement
DELETE FROM table
----
DELETE FROM "table"
=>
Delete(DeleteStatement { table_name: Name(UnresolvedItemName([Ident("table")])), alias: None, using: [], selection: None, rows: None })

parse-statement
DELETE FROM table as t2
----
DELETE FROM "table" AS t2
=>
Delete(DeleteStatement { table_name: Name(UnresolvedItemName([Ident("table")])), alias: Some(TableAlias { name: Ident("t2"), columns: [], strict: false }), using: [], selection: None, rows: None })

parse-statement
DELETE FROM table USING a, b
----
DELETE FROM "table" USING a, b
=>
Delete(DeleteStatement { table_name: Name(UnresolvedItemName([Ident("table")])), alias: None, using: [TableWithJoins { relation: Table { name: Name(UnresolvedItemName([Ident("a")])), alias: None }, joins: [] }, TableWithJoins { relation: Table { name: Name(UnresolvedItemName([Ident("b")])), alias: None }, joins: [] }], selection: None, rows: None })

parse-statement roundtrip
DELETE FROM foo WHERE name = 5
----
DELETE FROM foo WHERE name = 5

parse-statement
DELETE FROM foo WHERE name = 5
----
DELETE FROM foo WHERE name = 5
=>
Delete(DeleteStatement { table_name: Name(UnresolvedItemName([Ident("foo")])), alias: None, using: [], selection: Some(Op { op: Op { namespace: None, op: "=" }, expr1: Identifier([Ident("name")]), expr2: Some(Value(Number("5"))) }), rows: None })

parse-statement roundtrip
DELETE FROM foo ROWS (SELECT * FROM bar EXCEPT ALL SELECT a, b FROM baz)
----
DELETE FROM foo ROWS (SELECT * FROM bar EXCEPT ALL SELECT a, b FROM baz)

parse-statement
DELETE FROM foo ROWS (VALUES (1, 2), (3, 4))
----
DELETE FROM foo ROWS (VALUES (1, 2), (3, 4))
=>
Delete(DeleteStatement { table_name: Name(UnresolvedItemName([Ident("foo")])), alias: None, using: [], selection: None, rows: Some(Query { ctes: Simple([]), body: Values(Values([[Value(Number("1")), Value(Number("2"))], [Value(Number("3")), Value(Number("4"))]])), order_by: [], limit: None, offset: None }) })

parse-statement roundtrip
DELETE FROM foo ROWS (WITH x AS (SELECT 1) TABLE x)
----
DELETE FROM foo ROWS (WITH x AS (SELECT 1) TABLE x)

parse-statement roundtrip
DELETE FROM foo ROWS ((SELECT 1) UNION ALL (SELECT 2))
----
DELETE FROM foo ROWS ((SELECT 1) UNION ALL (SELECT 2))

parse-statement
DELETE FROM foo ROWS (SELECT 1) WHERE a = 1
----
error: DELETE ... ROWS cannot be combined with USING or WHERE
DELETE FROM foo ROWS (SELECT 1) WHERE a = 1
                                ^

parse-statement
DELETE FROM foo ROWS (SELECT 1) USING bar
----
error: DELETE ... ROWS cannot be combined with USING or WHERE
DELETE FROM foo ROWS (SELECT 1) USING bar
                                ^

parse-statement
DELETE FROM foo AS f ROWS (SELECT 1)
----
error: DELETE ... ROWS does not support a table alias
DELETE FROM foo AS f ROWS (SELECT 1)
                     ^

parse-statement
DELETE FROM foo f ROWS (SELECT 1)
----
error: DELETE ... ROWS does not support a table alias
DELETE FROM foo f ROWS (SELECT 1)
                  ^

parse-statement
DELETE FROM foo ROWS (SELECT 1) RETURNING *
----
error: Expected end of statement, found RETURNING
DELETE FROM foo ROWS (SELECT 1) RETURNING *
                                ^

# A bare table alias named `rows`, with or without a column list, still parses
# as an alias.
parse-statement
DELETE FROM foo rows WHERE a = 1
----
DELETE FROM foo AS rows WHERE a = 1
=>
Delete(DeleteStatement { table_name: Name(UnresolvedItemName([Ident("foo")])), alias: Some(TableAlias { name: Ident("rows"), columns: [], strict: false }), using: [], selection: Some(Op { op: Op { namespace: None, op: "=" }, expr1: Identifier([Ident("a")]), expr2: Some(Value(Number("1"))) }), rows: None })

parse-statement
DELETE FROM foo rows (a) WHERE a = 1
----
DELETE FROM foo AS rows (a) WHERE a = 1
=>
Delete(DeleteStatement { table_name: Name(UnresolvedItemName([Ident("foo")])), alias: Some(TableAlias { name: Ident("rows"), columns: [Ident("a")], strict: false }), using: [], selection: Some(Op { op: Op { namespace: None, op: "=" }, expr1: Identifier([Ident("a")]), expr2: Some(Value(Number("1"))) }), rows: None })
