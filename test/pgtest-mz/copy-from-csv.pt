DataRow {"fields":["a","b"]}
DataRow {"fields":["","d"]}
CommandComplete {"tag":"SELECT 2"}
ReadyForQuery {"status":"I"}

# CR and LF end records, so COPY FROM STDIN rejects both as the quote.
send
Query {"query": "COPY t10 FROM STDIN WITH (FORMAT CSV, QUOTE E'\\n')"}
Query {"query": "COPY t10 FROM STDIN WITH (FORMAT CSV, QUOTE E'\\r')"}
----

until
ErrorResponse
ReadyForQuery
ErrorResponse
ReadyForQuery
----
ErrorResponse {"fields":[{"typ":"S","value":"ERROR"},{"typ":"C","value":"XX000"},{"typ":"M","value":"COPY CSV quote cannot be a line feed or carriage return"}]}
ReadyForQuery {"status":"I"}
ErrorResponse {"fields":[{"typ":"S","value":"ERROR"},{"typ":"C","value":"XX000"},{"typ":"M","value":"COPY CSV quote cannot be a line feed or carriage return"}]}
ReadyForQuery {"status":"I"}
