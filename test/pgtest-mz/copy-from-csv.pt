CommandComplete {"tag":"COPY 0"}
ReadyForQuery {"status":"I"}
RowDescription {"fields":[{"name":"count"}]}
DataRow {"fields":["0"]}
CommandComplete {"tag":"SELECT 1"}
ReadyForQuery {"status":"I"}

# With several columns a blank line cannot be a row, and is skipped. The
