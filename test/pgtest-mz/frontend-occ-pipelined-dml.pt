# How the frontend OCC read-then-write path behaves inside an extended-protocol
# batch, the statements before one Sync, which form one implicit transaction.
#
# A write that reads no persisted state stages its rows, so it commits or rolls
# back with everything else in the batch.
#
# A write that reads persisted state commits when it executes, so it cannot
# share a transaction with other statements. It runs only as the last statement
# before its Sync, which keeps the batch atomic, and is refused otherwise,
# before it executes. A Sync that follows a Flush counts only if it arrived
# together with the Flush, since after a Flush the client may wait for results.

send
Query {"query": "DROP TABLE IF EXISTS t"}
Query {"query": "CREATE TABLE t (a int)"}
----

until ignore=NoticeResponse
ReadyForQuery
ReadyForQuery
----
CommandComplete {"tag":"DROP TABLE"}
ReadyForQuery {"status":"I"}
CommandComplete {"tag":"CREATE TABLE"}
ReadyForQuery {"status":"I"}

# A read-dependent write pipelined behind a staged write is refused. It cannot
# see those staged rows, so running it would compute its diffs from a snapshot
# that lacks them.
send
Parse {"query": "INSERT INTO t VALUES (1)"}
Bind
Execute
Parse {"query": "DELETE FROM t WHERE a = 1"}
Bind
Execute
Sync
----

until
ReadyForQuery
----
ParseComplete
BindComplete
CommandComplete {"tag":"INSERT 0 1"}
ParseComplete
BindComplete
ErrorResponse {"fields":[{"typ":"S","value":"ERROR"},{"typ":"C","value":"25001"},{"typ":"M","value":"DELETE FROM t WHERE a = 1 cannot be run inside a transaction block"}]}
ReadyForQuery {"status":"I"}

# The pipeline failed, so the staged INSERT rolled back too.
send
Query {"query": "SELECT count(*) FROM t"}
----

until
ReadyForQuery
----
RowDescription {"fields":[{"name":"count"}]}
DataRow {"fields":["0"]}
CommandComplete {"tag":"SELECT 1"}
ReadyForQuery {"status":"I"}

# A blind write pipelined behind a staged write. 20000 rows is above the
# constant-folding limit, so the values stay a dataflow and take the
# read-then-write path rather than being folded and staged by the constant
# insert path. It reads nothing, so it is admitted, and it must stage its rows
# rather than write them: writing would order them ahead of the earlier
# `VALUES (1)` op and leave them behind when the pipeline rolls that op back.
send
Parse {"query": "INSERT INTO t VALUES (1)"}
Bind
Execute
Parse {"query": "INSERT INTO t SELECT generate_series(1, 20000)"}
Bind
Execute
Parse {"query": "SELECT 1/0"}
Bind
Execute
Sync
----

until err_field_typs=SC
ReadyForQuery
----
ParseComplete
BindComplete
CommandComplete {"tag":"INSERT 0 1"}
ParseComplete
BindComplete
CommandComplete {"tag":"INSERT 0 20000"}
ParseComplete
BindComplete
ErrorResponse {"fields":[{"typ":"S","value":"ERROR"},{"typ":"C","value":"22012"}]}
ReadyForQuery {"status":"I"}

# Neither INSERT survives: the blind write joined the transaction that the
# division by zero rolled back.
send
Query {"query": "SELECT count(*) FROM t"}
----

until
ReadyForQuery
----
RowDescription {"fields":[{"name":"count"}]}
DataRow {"fields":["0"]}
CommandComplete {"tag":"SELECT 1"}
ReadyForQuery {"status":"I"}

# A blind write that opens the pipeline. Nothing is staged in front of it, so
# neither transaction predicate reports a transaction, but the pipeline is still
# one and can still fail after it. It stages its rows all the same.
send
Parse {"query": "INSERT INTO t SELECT generate_series(1, 20000)"}
Bind
Execute
Parse {"query": "SELECT 1/0"}
Bind
Execute
Sync
----

until err_field_typs=SC
ReadyForQuery
----
ParseComplete
BindComplete
CommandComplete {"tag":"INSERT 0 20000"}
ParseComplete
BindComplete
ErrorResponse {"fields":[{"typ":"S","value":"ERROR"},{"typ":"C","value":"22012"}]}
ReadyForQuery {"status":"I"}

send
Query {"query": "SELECT count(*) FROM t"}
----

until
ReadyForQuery
----
RowDescription {"fields":[{"name":"count"}]}
DataRow {"fields":["0"]}
CommandComplete {"tag":"SELECT 1"}
ReadyForQuery {"status":"I"}

send
Query {"query": "INSERT INTO t VALUES (1), (2), (3)"}
----

until
ReadyForQuery
----
CommandComplete {"tag":"INSERT 0 3"}
ReadyForQuery {"status":"I"}

# A read-dependent write that opens the batch, followed by another statement,
# is refused before it executes. The error rolls back the batch and the rest of
# it is skipped up to the Sync, so the DELETE is not applied.
send
Parse {"query": "DELETE FROM t WHERE a = 1"}
Bind
Execute
Parse {"query": "SELECT 1/0"}
Bind
Execute
Sync
----

until err_field_typs=SCMH
ReadyForQuery
----
ParseComplete
BindComplete
ErrorResponse {"fields":[{"typ":"S","value":"ERROR"},{"typ":"C","value":"25001"},{"typ":"M","value":"DELETE FROM t WHERE a = 1 must be the last statement before Sync"},{"typ":"H","value":"Materialize cannot run UPDATE, DELETE, or INSERT ... SELECT atomically with other statements. Send a Sync directly after it."}]}
ReadyForQuery {"status":"I"}

send
Query {"query": "SELECT count(*) FROM t"}
----

until
ReadyForQuery
----
RowDescription {"fields":[{"name":"count"}]}
DataRow {"fields":["3"]}
CommandComplete {"tag":"SELECT 1"}
ReadyForQuery {"status":"I"}

# Two read-dependent writes in one batch: the first is refused, nothing applies.
send
Parse {"query": "DELETE FROM t WHERE a = 2"}
Bind
Execute
Parse {"query": "DELETE FROM t WHERE a = 3"}
Bind
Execute
Sync
----

until err_field_typs=SCMH
ReadyForQuery
----
ParseComplete
BindComplete
ErrorResponse {"fields":[{"typ":"S","value":"ERROR"},{"typ":"C","value":"25001"},{"typ":"M","value":"DELETE FROM t WHERE a = 2 must be the last statement before Sync"},{"typ":"H","value":"Materialize cannot run UPDATE, DELETE, or INSERT ... SELECT atomically with other statements. Send a Sync directly after it."}]}
ReadyForQuery {"status":"I"}

send
Query {"query": "SELECT count(*) FROM t"}
----

until
ReadyForQuery
----
RowDescription {"fields":[{"name":"count"}]}
DataRow {"fields":["3"]}
CommandComplete {"tag":"SELECT 1"}
ReadyForQuery {"status":"I"}

# A read before the write commits on its own, so the write is still the only
# statement of its transaction and runs.
send
Parse {"query": "SELECT count(*) FROM t"}
Bind
Execute
Parse {"query": "DELETE FROM t WHERE a = 1"}
Bind
Execute
Sync
----

until
ReadyForQuery
----
ParseComplete
BindComplete
DataRow {"fields":["3"]}
CommandComplete {"tag":"SELECT 1"}
ParseComplete
BindComplete
CommandComplete {"tag":"DELETE 1"}
ReadyForQuery {"status":"I"}

# A read after the write is another statement in its transaction.
send
Parse {"query": "UPDATE t SET a = a + 10"}
Bind
Execute
Parse {"query": "SELECT count(*) FROM t"}
Bind
Execute
Sync
----

until err_field_typs=SCMH
ReadyForQuery
----
ParseComplete
BindComplete
ErrorResponse {"fields":[{"typ":"S","value":"ERROR"},{"typ":"C","value":"25001"},{"typ":"M","value":"UPDATE t SET a = a + '<REDACTED>' must be the last statement before Sync"},{"typ":"H","value":"Materialize cannot run UPDATE, DELETE, or INSERT ... SELECT atomically with other statements. Send a Sync directly after it."}]}
ReadyForQuery {"status":"I"}

# A Sync that arrives together with the Flush before it still counts, so the
# write runs. This is the shape pg8000 sends for every statement with
# parameters.
send
Parse {"query": "DELETE FROM t WHERE a = $1"}
Bind {"values": ["2"]}
Flush
Execute
Flush
Sync
----

until
ReadyForQuery
----
ParseComplete
BindComplete
CommandComplete {"tag":"DELETE 1"}
ReadyForQuery {"status":"I"}

# After a Flush the client may wait for results without sending a Sync, so a
# Sync that has not arrived yet cannot be waited for, and the write is refused.
send
Parse {"query": "DELETE FROM t WHERE a = 3"}
Bind
Execute
Flush
----

until err_field_typs=SCMH
ErrorResponse
----
ParseComplete
BindComplete
ErrorResponse {"fields":[{"typ":"S","value":"ERROR"},{"typ":"C","value":"25001"},{"typ":"M","value":"DELETE FROM t WHERE a = 3 must be followed by Sync, not Flush"},{"typ":"H","value":"Materialize cannot run UPDATE, DELETE, or INSERT ... SELECT atomically with other statements. Send a Sync directly after it."}]}

send
Sync
----

until
ReadyForQuery
----
ReadyForQuery {"status":"I"}

# SQL EXECUTE of a prepared read-dependent write is checked the same way.
send
Query {"query": "PREPARE del AS DELETE FROM t WHERE a = $1"}
----

until
ReadyForQuery
----
CommandComplete {"tag":"PREPARE"}
ReadyForQuery {"status":"I"}

send
Parse {"query": "EXECUTE del(3)"}
Bind
Execute
Parse {"query": "SELECT 1"}
Bind
Execute
Sync
----

until err_field_typs=SCM
ReadyForQuery
----
ParseComplete
BindComplete
ErrorResponse {"fields":[{"typ":"S","value":"ERROR"},{"typ":"C","value":"25001"},{"typ":"M","value":"DELETE FROM t WHERE a = $1 must be the last statement before Sync"}]}
ReadyForQuery {"status":"I"}

send
Parse {"query": "EXECUTE del(4)"}
Bind
Execute
Sync
----

until
ReadyForQuery
----
ParseComplete
BindComplete
CommandComplete {"tag":"DELETE 0"}
ReadyForQuery {"status":"I"}

send
Query {"query": "SELECT a FROM t ORDER BY a"}
----

until
ReadyForQuery
----
RowDescription {"fields":[{"name":"a"}]}
DataRow {"fields":["3"]}
CommandComplete {"tag":"SELECT 1"}
ReadyForQuery {"status":"I"}
