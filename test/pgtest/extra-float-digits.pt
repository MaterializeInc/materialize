# SET extra_float_digits adjusts the text encoding of floats in query results:
# zero and negative values limit the number of significant digits, positive
# values select the shortest round-trippable encoding.

send
Query {"query": "SET extra_float_digits = 0"}
Query {"query": "SELECT 0.1::float8 + 0.2::float8 AS f"}
----

until
ReadyForQuery
ReadyForQuery
----
CommandComplete {"tag":"SET"}
ReadyForQuery {"status":"I"}
RowDescription {"fields":[{"name":"f"}]}
DataRow {"fields":["0.3"]}
CommandComplete {"tag":"SELECT 1"}
ReadyForQuery {"status":"I"}

# COPY ... TO STDOUT applies the parameter too, so that a bulk export agrees
# with what the same query returns as rows.
send
Query {"query": "COPY (SELECT 0.1::float8 + 0.2::float8) TO STDOUT"}
----

until
ReadyForQuery
----
CopyOut {"format":"text","column_formats":["text"]}
CopyData "0.3\n"
CopyDone
CommandComplete {"tag":"COPY 1"}
ReadyForQuery {"status":"I"}

send
Query {"query": "COPY (SELECT 0.1::float8 + 0.2::float8) TO STDOUT WITH (FORMAT csv)"}
----

until
ReadyForQuery
----
CopyOut {"format":"text","column_formats":["text"]}
CopyData "0.3\n"
CopyDone
CommandComplete {"tag":"COPY 1"}
ReadyForQuery {"status":"I"}

# Resetting the parameter restores the shortest round-trippable encoding on both
# response paths. The default is positive in both PostgreSQL and Materialize.
send
Query {"query": "RESET extra_float_digits"}
Query {"query": "SELECT 0.1::float8 + 0.2::float8 AS f"}
Query {"query": "COPY (SELECT 0.1::float8 + 0.2::float8) TO STDOUT"}
----

until
ReadyForQuery
ReadyForQuery
ReadyForQuery
----
CommandComplete {"tag":"RESET"}
ReadyForQuery {"status":"I"}
RowDescription {"fields":[{"name":"f"}]}
DataRow {"fields":["0.30000000000000004"]}
CommandComplete {"tag":"SELECT 1"}
ReadyForQuery {"status":"I"}
CopyOut {"format":"text","column_formats":["text"]}
CopyData "0.30000000000000004\n"
CopyDone
CommandComplete {"tag":"COPY 1"}
ReadyForQuery {"status":"I"}
