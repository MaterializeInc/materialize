# Fixes database-issues#5212

query T
SELECT 'a'::character = 'a'::"char";
----
true

query error coalesce could not convert type char\(1\) to "char"
SELECT pg_typeof(coalesce('1'::"char", '1'::char));

# Fixes database-issues#5191

query T
SELECT 'a'::"char"::char;
----
a

query T
SELECT pg_typeof('a'::"char"::char);
----
character

query T
SELECT 'a'::"char"::varchar;
----
a

query T
SELECT pg_typeof('a'::"char"::varchar);
----
character varying

query T
SELECT 'a'::"char"::text;
----
a

query T
SELECT pg_typeof('a'::"char"::text);
----
text

query T
SELECT 'abc'::char::"char";
----
a

query T
SELECT pg_typeof('abc'::char::"char");
----
"char"

query T
SELECT 'abc'::varchar::"char";
----
a

query T
SELECT pg_typeof('abc'::varchar::"char");
----
"char"

query T
SELECT 'abc'::text::"char";
----
a

query T
SELECT pg_typeof('abc'::text::"char");
----
"char"

# Fixes database-issues#5222

query error coalesce could not convert type "char" to char
SELECT COALESCE('a'::char, 'a'::"char");

query error coalesce could not convert type "char" to varchar
SELECT COALESCE('a'::varchar, 'a'::"char");

query error coalesce could not convert type char\(1\) to "char"
SELECT COALESCE('a'::"char", 'a'::char);

query error coalesce could not convert type varchar to "char"
SELECT COALESCE('a'::"char", 'a'::varchar);

# Casts from "char" to non-string types go through text, since the "char"
# datum is a byte rather than a string, unless a direct cast exists.

query T
SELECT '1'::"char"::int2vector;
----
[0:0]={1}

query I
SELECT '7'::"char"::int8;
----
7

query B
SELECT 't'::"char"::bool;
----
true

query error invalid input syntax for type int2vector
SELECT 'a'::"char"::int2vector;

# "char" <-> integer is a direct cast on the byte value, as in PostgreSQL.

query I
SELECT 'a'::"char"::int4;
----
97

query T
SELECT 97::int4::"char";
----
a

query error "char" out of range
SELECT 200::int4::"char";

query I
SELECT (-1)::int4::"char"::int4;
----
-1

query I
SELECT ''::"char"::int4;
----
0

statement ok
CREATE TABLE pure_char (c "char" NOT NULL);

statement ok
INSERT INTO pure_char VALUES ('1'), ('2');

query T rowsort
SELECT c::int2vector FROM pure_char;
----
[0:0]={1}
[0:0]={2}

query I rowsort
SELECT c::int8 FROM pure_char;
----
1
2

query I rowsort
SELECT c::int4 FROM pure_char;
----
49
50

statement ok
DROP TABLE pure_char;
