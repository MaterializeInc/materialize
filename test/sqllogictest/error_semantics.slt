# A chain of indexed views, each reading the one below it twice. The index per level is what
# turns the duplicated error records into an accumulated diff, so this reaches the `Diff`
# overflow rather than exhausting memory first.
#
# The sharing here is across objects rather than within a dataflow, which the per-binding
# collapse does not reach: every level reads `Get(Global)` on an indexed view, and a binding
# collapse only ever sees `Id::Local`. Normalizing at the export boundary is what bounds this.
#
# `union` rather than `union all` keeps the ok collection at multiplicity 1 through its
# distinct, so the data path cannot overflow and the only thing that can is the error diff.

statement ok
create table indexed_diamond (x int)

statement ok
insert into indexed_diamond values (0)

statement ok
create view e0 as select 1 / x as q from indexed_diamond

statement ok
create default index on e0

statement ok
create view e1 as select * from e0 union select * from e0

statement ok
create default index on e1

statement ok
create view e2 as select * from e1 union select * from e1

statement ok
create default index on e2

statement ok
