# Text conversion. The cast always prints the mask, while concat and to_jsonb
# use the output function, as in PostgreSQL.
query TTT
SELECT '1.2.3.4'::inet::text, concat('1.2.3.4'::inet), to_jsonb('1.2.3.4'::inet)
----
1.2.3.4/32  1.2.3.4  "1.2.3.4"

