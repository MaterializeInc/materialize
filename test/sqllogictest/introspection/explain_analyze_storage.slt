# EXPLAIN ANALYZE CPU and MEMORY for sources, tables from sources, and
# subsources: explainee validation and the generated SQL. The runtime trees,
# and sinks, which need a reachable Kafka broker, are covered in testdrive
# (explain-analyze-storage.td), which retries while introspection catches up.

mode cockroach

reset-server

# Storage operators are visible in introspection only on a unified replica.
# The topology is fixed when the replica is provisioned, so the parameter must
# be set before the cluster is created.
simple conn=mz_system,user=mz_system
ALTER SYSTEM SET enable_unified_cluster = true
----
COMPLETE 0

simple conn=mz_system,user=mz_system
ALTER SYSTEM SET enable_explain_analyze_storage_objects = true
----
COMPLETE 0

statement ok
CREATE CLUSTER uc SIZE 'scale=1,workers=1';

statement ok
CREATE SOURCE auction IN CLUSTER uc FROM LOAD GENERATOR AUCTION (TICK INTERVAL '100ms') FOR ALL TABLES;

statement ok
CREATE TABLE bids_tbl FROM SOURCE auction (REFERENCE "auction"."bids");

statement ok
CREATE TABLE plain (x int);

statement ok
CREATE MATERIALIZED VIEW mv IN CLUSTER uc AS SELECT count(*) FROM plain;

# Explainee validation.

query error db error: ERROR: EXPLAIN ANALYZE \.\.\. FOR TABLE requires a table created from a source or a subsource, but materialize\.public\.plain is not
EXPLAIN ANALYZE CPU FOR TABLE plain

query error db error: ERROR: materialize\.public\.bids is a subsource
EXPLAIN ANALYZE CPU FOR SOURCE bids

query error db error: ERROR: materialize\.public\.auction_progress is a progress source, which has no dataflow of its own
EXPLAIN ANALYZE CPU FOR SOURCE auction_progress

query error db error: ERROR: table materialize\.public\.plain is not a source
EXPLAIN ANALYZE CPU FOR SOURCE plain

query error db error: ERROR: source materialize\.public\.auction is not a sink
EXPLAIN ANALYZE CPU FOR SINK auction

query error db error: ERROR: EXPLAIN ANALYZE HINTS is only supported for indexes and materialized views
EXPLAIN ANALYZE HINTS FOR SOURCE auction

# CPU and MEMORY read the explainee's cluster's logs, so they require the
# session to be on that cluster. A table from a source runs on its source's
# cluster.

simple
EXPLAIN ANALYZE CPU FOR SOURCE auction
----
db error: ERROR: materialize.public.auction runs on cluster "uc", but the active cluster is "quickstart"
HINT: Use SET cluster = uc to explain it.

simple
EXPLAIN ANALYZE MEMORY FOR TABLE bids_tbl
----
db error: ERROR: materialize.public.bids_tbl runs on cluster "uc", but the active cluster is "quickstart"
HINT: Use SET cluster = uc to explain it.

# AS SQL reads no introspection, so it works from any cluster.

query T multiline
EXPLAIN ANALYZE CPU FOR SOURCE auction AS SQL
----
WITH
    explainee AS
    (SELECT global_id FROM (VALUES ('u2')) AS e (global_id)),
    dataflow_objects AS
    (
        SELECT sdgi.id AS dataflow_id, sdgi.global_id AS global_id
        FROM mz_introspection.mz_storage_dataflow_global_ids AS sdgi
        WHERE
            sdgi.id
            = (
                    SELECT max(e_sdgi.id)
                    FROM
                        mz_introspection.mz_storage_dataflow_global_ids
                                AS e_sdgi
                            JOIN
                                explainee AS e
                                ON (e_sdgi.global_id = e.global_id)
                )
    ),
    leaf_operators AS
    (
        SELECT mdod.id::int8 AS operator_id
        FROM mz_introspection.mz_dataflow_operator_dataflows AS mdod
        WHERE
            mdod.dataflow_id IN ( SELECT dataflow_id FROM dataflow_objects )
                AND
            mdod.id
            NOT IN (
            SELECT parent_id FROM mz_introspection.mz_dataflow_operator_parents
            )
    ),
    stage_ranges AS
    (
        SELECT
            ssm.global_id AS global_id,
            ssm.stage_id AS stage_id,
            ssm.parent_stage_id AS parent_stage_id,
            ssm.nesting AS nesting,
            ssm.stage AS stage,
            ssm.operator_id_start AS operator_id_start,
            ssm.operator_id_end AS operator_id_end
        FROM
            mz_introspection.mz_storage_stage_mapping AS ssm
                JOIN
                    dataflow_objects AS dfo
                    ON
                        (
                            ssm.dataflow_id = dfo.dataflow_id
                                AND
                            ssm.global_id = dfo.global_id
                        )
    ),
    stages AS
    (
        SELECT
            0::uint8 AS stage_id,
            0::uint2 AS nesting,
            'Source auction' || ' (' || e.global_id || ')' AS operator
        FROM explainee AS e
        UNION ALL
            SELECT DISTINCT
                sr.stage_id AS stage_id,
                sr.nesting AS nesting,
                CASE
                        WHEN sr.stage = 'Export'
                                THEN
                                    'Export '
                                    || COALESCE(
                                            ms.name || '.' || mo.name,
                                            sr.global_id
                                        )
                                    || ' ('
                                    || sr.global_id
                                    || ')'
                            ELSE sr.stage
                    END
                    AS operator
            FROM
                stage_ranges AS sr
                    LEFT JOIN
                        mz_internal.mz_object_global_ids AS mogi
                        ON (sr.global_id = mogi.global_id)
                    LEFT JOIN mz_catalog.mz_objects AS mo ON (mogi.id = mo.id)
                    LEFT JOIN
                        mz_catalog.mz_schemas AS ms
                        ON (mo.schema_id = ms.id)
    ),
    stage_operators AS
    (
        SELECT
            so.stage_id AS stage_id,
            so.nesting AS nesting,
            so.operator_id AS operator_id
        FROM
            (
                        SELECT sr.stage_id, sr.nesting, operator_id
                        FROM
                            stage_ranges AS sr
                                 CROSS JOIN generate_series(sr.operator_id_start::int8, sr.operator_id_end::int8 - 1) AS operator_id
                        UNION ALL
                            SELECT parent.stage_id, parent.nesting, operator_id
                            FROM
                                stage_ranges AS sr
                                    JOIN
                                        (
                                                SELECT DISTINCT
                                                    stage_id, nesting
                                                FROM stage_ranges
                                            )
                                            AS parent
                                        ON
                                            (
                                                sr.parent_stage_id
                                                = parent.stage_id
                                            )
                                     CROSS JOIN generate_series(sr.operator_id_start::int8, sr.operator_id_end::int8 - 1) AS operator_id
                        UNION ALL
                            SELECT 0::uint8, 0::uint2, lo.operator_id
                            FROM leaf_operators AS lo
                    )
                    AS so
                JOIN leaf_operators AS lo ON (so.operator_id = lo.operator_id)
    ),
    summary_cpu AS
    (
        SELECT
            so.stage_id AS stage_id,
            so.nesting AS nesting,
            sum(mse.elapsed_ns) AS total_ns,
            CASE
                    WHEN count(DISTINCT mse.worker_id) <> 0
                            THEN
                                sum(mse.elapsed_ns)
                                / count(DISTINCT mse.worker_id)
                        ELSE NULL
                END
                AS avg_ns
        FROM
            stage_operators AS so
                JOIN
                    mz_introspection.mz_scheduling_elapsed_per_worker AS mse
                    ON (mse.id = so.operator_id)
        GROUP BY so.stage_id, so.nesting
    )
SELECT
    repeat(' ', nesting * 2) || s.operator AS operator,
    sc.total_ns / 1000 * '1 microsecond'::interval AS total_elapsed
FROM stages AS s LEFT JOIN summary_cpu AS sc USING(stage_id, nesting)
ORDER BY stage_id, nesting;
EOF

query T multiline
EXPLAIN ANALYZE MEMORY FOR SOURCE auction AS SQL
----
WITH
    explainee AS
    (SELECT global_id FROM (VALUES ('u2')) AS e (global_id)),
    dataflow_objects AS
    (
        SELECT sdgi.id AS dataflow_id, sdgi.global_id AS global_id
        FROM mz_introspection.mz_storage_dataflow_global_ids AS sdgi
        WHERE
            sdgi.id
            = (
                    SELECT max(e_sdgi.id)
                    FROM
                        mz_introspection.mz_storage_dataflow_global_ids
                                AS e_sdgi
                            JOIN
                                explainee AS e
                                ON (e_sdgi.global_id = e.global_id)
                )
    ),
    leaf_operators AS
    (
        SELECT mdod.id::int8 AS operator_id
        FROM mz_introspection.mz_dataflow_operator_dataflows AS mdod
        WHERE
            mdod.dataflow_id IN ( SELECT dataflow_id FROM dataflow_objects )
                AND
            mdod.id
            NOT IN (
            SELECT parent_id FROM mz_introspection.mz_dataflow_operator_parents
            )
    ),
    stage_ranges AS
    (
        SELECT
            ssm.global_id AS global_id,
            ssm.stage_id AS stage_id,
            ssm.parent_stage_id AS parent_stage_id,
            ssm.nesting AS nesting,
            ssm.stage AS stage,
            ssm.operator_id_start AS operator_id_start,
            ssm.operator_id_end AS operator_id_end
        FROM
            mz_introspection.mz_storage_stage_mapping AS ssm
                JOIN
                    dataflow_objects AS dfo
                    ON
                        (
                            ssm.dataflow_id = dfo.dataflow_id
                                AND
                            ssm.global_id = dfo.global_id
                        )
    ),
    stages AS
    (
        SELECT
            0::uint8 AS stage_id,
            0::uint2 AS nesting,
            'Source auction' || ' (' || e.global_id || ')' AS operator
        FROM explainee AS e
        UNION ALL
            SELECT DISTINCT
                sr.stage_id AS stage_id,
                sr.nesting AS nesting,
                CASE
                        WHEN sr.stage = 'Export'
                                THEN
                                    'Export '
                                    || COALESCE(
                                            ms.name || '.' || mo.name,
                                            sr.global_id
                                        )
                                    || ' ('
                                    || sr.global_id
                                    || ')'
                            ELSE sr.stage
                    END
                    AS operator
            FROM
                stage_ranges AS sr
                    LEFT JOIN
                        mz_internal.mz_object_global_ids AS mogi
                        ON (sr.global_id = mogi.global_id)
                    LEFT JOIN mz_catalog.mz_objects AS mo ON (mogi.id = mo.id)
                    LEFT JOIN
                        mz_catalog.mz_schemas AS ms
                        ON (mo.schema_id = ms.id)
    ),
    stage_operators AS
    (
        SELECT
            so.stage_id AS stage_id,
            so.nesting AS nesting,
            so.operator_id AS operator_id
        FROM
            (
                        SELECT sr.stage_id, sr.nesting, operator_id
                        FROM
                            stage_ranges AS sr
                                 CROSS JOIN generate_series(sr.operator_id_start::int8, sr.operator_id_end::int8 - 1) AS operator_id
                        UNION ALL
                            SELECT parent.stage_id, parent.nesting, operator_id
                            FROM
                                stage_ranges AS sr
                                    JOIN
                                        (
                                                SELECT DISTINCT
                                                    stage_id, nesting
                                                FROM stage_ranges
                                            )
                                            AS parent
                                        ON
                                            (
                                                sr.parent_stage_id
                                                = parent.stage_id
                                            )
                                     CROSS JOIN generate_series(sr.operator_id_start::int8, sr.operator_id_end::int8 - 1) AS operator_id
                        UNION ALL
                            SELECT 0::uint8, 0::uint2, lo.operator_id
                            FROM leaf_operators AS lo
                    )
                    AS so
                JOIN leaf_operators AS lo ON (so.operator_id = lo.operator_id)
    ),
    summary_memory AS
    (
        SELECT
            so.stage_id AS stage_id,
            so.nesting AS nesting,
            sum(mas.size) AS total_memory,
            sum(mas.records) AS total_records,
            CASE
                    WHEN count(DISTINCT mas.worker_id) <> 0
                            THEN sum(mas.size) / count(DISTINCT mas.worker_id)
                        ELSE NULL
                END
                AS avg_memory,
            CASE
                    WHEN count(DISTINCT mas.worker_id) <> 0
                            THEN
                                sum(mas.records) / count(DISTINCT mas.worker_id)
                        ELSE NULL
                END
                AS avg_records
        FROM
            stage_operators AS so
                JOIN
                    mz_introspection.mz_arrangement_sizes_per_worker AS mas
                    ON (mas.operator_id = so.operator_id)
        GROUP BY so.stage_id, so.nesting
    )
SELECT
    repeat(' ', nesting * 2) || s.operator AS operator,
    pg_size_pretty(sm.total_memory) AS total_memory,
    sm.total_records AS total_records
FROM stages AS s LEFT JOIN summary_memory AS sm USING(stage_id, nesting)
ORDER BY stage_id, nesting;
EOF

query T multiline
EXPLAIN ANALYZE CPU, MEMORY WITH SKEW FOR SOURCE auction AS SQL
----
WITH
    explainee AS
    (SELECT global_id FROM (VALUES ('u2')) AS e (global_id)),
    dataflow_objects AS
    (
        SELECT sdgi.id AS dataflow_id, sdgi.global_id AS global_id
        FROM mz_introspection.mz_storage_dataflow_global_ids AS sdgi
        WHERE
            sdgi.id
            = (
                    SELECT max(e_sdgi.id)
                    FROM
                        mz_introspection.mz_storage_dataflow_global_ids
                                AS e_sdgi
                            JOIN
                                explainee AS e
                                ON (e_sdgi.global_id = e.global_id)
                )
    ),
    leaf_operators AS
    (
        SELECT mdod.id::int8 AS operator_id
        FROM mz_introspection.mz_dataflow_operator_dataflows AS mdod
        WHERE
            mdod.dataflow_id IN ( SELECT dataflow_id FROM dataflow_objects )
                AND
            mdod.id
            NOT IN (
            SELECT parent_id FROM mz_introspection.mz_dataflow_operator_parents
            )
    ),
    stage_ranges AS
    (
        SELECT
            ssm.global_id AS global_id,
            ssm.stage_id AS stage_id,
            ssm.parent_stage_id AS parent_stage_id,
            ssm.nesting AS nesting,
            ssm.stage AS stage,
            ssm.operator_id_start AS operator_id_start,
            ssm.operator_id_end AS operator_id_end
        FROM
            mz_introspection.mz_storage_stage_mapping AS ssm
                JOIN
                    dataflow_objects AS dfo
                    ON
                        (
                            ssm.dataflow_id = dfo.dataflow_id
                                AND
                            ssm.global_id = dfo.global_id
                        )
    ),
    stages AS
    (
        SELECT
            0::uint8 AS stage_id,
            0::uint2 AS nesting,
            'Source auction' || ' (' || e.global_id || ')' AS operator
        FROM explainee AS e
        UNION ALL
            SELECT DISTINCT
                sr.stage_id AS stage_id,
                sr.nesting AS nesting,
                CASE
                        WHEN sr.stage = 'Export'
                                THEN
                                    'Export '
                                    || COALESCE(
                                            ms.name || '.' || mo.name,
                                            sr.global_id
                                        )
                                    || ' ('
                                    || sr.global_id
                                    || ')'
                            ELSE sr.stage
                    END
                    AS operator
            FROM
                stage_ranges AS sr
                    LEFT JOIN
                        mz_internal.mz_object_global_ids AS mogi
                        ON (sr.global_id = mogi.global_id)
                    LEFT JOIN mz_catalog.mz_objects AS mo ON (mogi.id = mo.id)
                    LEFT JOIN
                        mz_catalog.mz_schemas AS ms
                        ON (mo.schema_id = ms.id)
    ),
    stage_operators AS
    (
        SELECT
            so.stage_id AS stage_id,
            so.nesting AS nesting,
            so.operator_id AS operator_id
        FROM
            (
                        SELECT sr.stage_id, sr.nesting, operator_id
                        FROM
                            stage_ranges AS sr
                                 CROSS JOIN generate_series(sr.operator_id_start::int8, sr.operator_id_end::int8 - 1) AS operator_id
                        UNION ALL
                            SELECT parent.stage_id, parent.nesting, operator_id
                            FROM
                                stage_ranges AS sr
                                    JOIN
                                        (
                                                SELECT DISTINCT
                                                    stage_id, nesting
                                                FROM stage_ranges
                                            )
                                            AS parent
                                        ON
                                            (
                                                sr.parent_stage_id
                                                = parent.stage_id
                                            )
                                     CROSS JOIN generate_series(sr.operator_id_start::int8, sr.operator_id_end::int8 - 1) AS operator_id
                        UNION ALL
                            SELECT 0::uint8, 0::uint2, lo.operator_id
                            FROM leaf_operators AS lo
                    )
                    AS so
                JOIN leaf_operators AS lo ON (so.operator_id = lo.operator_id)
    ),
    stage_workers AS
    (
        SELECT
            so.stage_id AS stage_id,
            so.nesting AS nesting,
            count(DISTINCT mse.worker_id) AS active_workers
        FROM
            stage_operators AS so
                JOIN
                    mz_introspection.mz_scheduling_elapsed_per_worker AS mse
                    ON (mse.id = so.operator_id)
        WHERE mse.elapsed_ns > 0
        GROUP BY so.stage_id, so.nesting
    ),
    summary_cpu AS
    (
        SELECT
            so.stage_id AS stage_id,
            so.nesting AS nesting,
            sum(mse.elapsed_ns) AS total_ns,
            CASE
                    WHEN count(DISTINCT mse.worker_id) <> 0
                            THEN
                                sum(mse.elapsed_ns)
                                / count(DISTINCT mse.worker_id)
                        ELSE NULL
                END
                AS avg_ns
        FROM
            stage_operators AS so
                JOIN
                    mz_introspection.mz_scheduling_elapsed_per_worker AS mse
                    ON (mse.id = so.operator_id)
        GROUP BY so.stage_id, so.nesting
    ),
    per_worker_cpu AS
    (
        SELECT
            so.stage_id AS stage_id,
            so.nesting AS nesting,
            mse.worker_id AS worker_id,
            sum(mse.elapsed_ns) AS worker_ns
        FROM
            stage_operators AS so
                JOIN
                    mz_introspection.mz_scheduling_elapsed_per_worker AS mse
                    ON (mse.id = so.operator_id)
        GROUP BY so.stage_id, so.nesting, mse.worker_id
    ),
    summary_memory AS
    (
        SELECT
            so.stage_id AS stage_id,
            so.nesting AS nesting,
            sum(mas.size) AS total_memory,
            sum(mas.records) AS total_records,
            CASE
                    WHEN count(DISTINCT mas.worker_id) <> 0
                            THEN sum(mas.size) / count(DISTINCT mas.worker_id)
                        ELSE NULL
                END
                AS avg_memory,
            CASE
                    WHEN count(DISTINCT mas.worker_id) <> 0
                            THEN
                                sum(mas.records) / count(DISTINCT mas.worker_id)
                        ELSE NULL
                END
                AS avg_records
        FROM
            stage_operators AS so
                JOIN
                    mz_introspection.mz_arrangement_sizes_per_worker AS mas
                    ON (mas.operator_id = so.operator_id)
        GROUP BY so.stage_id, so.nesting
    ),
    per_worker_memory AS
    (
        SELECT
            so.stage_id AS stage_id,
            so.nesting AS nesting,
            mas.worker_id AS worker_id,
            sum(mas.size) AS worker_memory,
            sum(mas.records) AS worker_records
        FROM
            stage_operators AS so
                JOIN
                    mz_introspection.mz_arrangement_sizes_per_worker AS mas
                    ON (mas.operator_id = so.operator_id)
        GROUP BY so.stage_id, so.nesting, mas.worker_id
    )
SELECT
    repeat(' ', nesting * 2) || s.operator AS operator,
    pwc.worker_id AS worker_id,
    sw.active_workers AS active_workers,
    CASE
            WHEN pwc.worker_id IS NOT NULL AND sc.avg_ns <> 0
                    THEN round(pwc.worker_ns / sc.avg_ns, 2)
                ELSE NULL
        END
        AS cpu_ratio,
    pwc.worker_ns / 1000 * '1 microsecond'::interval AS worker_elapsed,
    sc.avg_ns / 1000 * '1 microsecond'::interval AS avg_elapsed,
    sc.total_ns / 1000 * '1 microsecond'::interval AS total_elapsed,
    CASE
            WHEN pwm.worker_id IS NOT NULL AND sm.avg_memory <> 0
                    THEN round(pwm.worker_memory / sm.avg_memory, 2)
                ELSE NULL
        END
        AS memory_ratio,
    pg_size_pretty(pwm.worker_memory) AS worker_memory,
    pg_size_pretty(sm.avg_memory) AS avg_memory,
    pg_size_pretty(sm.total_memory) AS total_memory,
    CASE
            WHEN pwm.worker_id IS NOT NULL AND sm.avg_records <> 0
                    THEN round(pwm.worker_records / sm.avg_records, 2)
                ELSE NULL
        END
        AS records_ratio,
    pwm.worker_records AS worker_records,
    sm.avg_records AS avg_records,
    sm.total_records AS total_records
FROM
    stages AS s
        LEFT JOIN stage_workers AS sw USING(stage_id, nesting)
        LEFT JOIN summary_cpu AS sc USING(stage_id, nesting)
        LEFT JOIN per_worker_cpu AS pwc USING(stage_id, nesting)
        LEFT JOIN summary_memory AS sm USING(stage_id, nesting)
        LEFT JOIN per_worker_memory AS pwm USING(stage_id, nesting)
WHERE
    (
        pwm.worker_id = pwc.worker_id OR pwm.worker_id IS NULL
            OR
        pwc.worker_id IS NULL
    )
ORDER BY stage_id, nesting, worker_id;
EOF

query T multiline
EXPLAIN ANALYZE MEMORY, CPU WITH SKEW FOR TABLE bids_tbl AS SQL
----
WITH
    explainee AS
    (SELECT global_id FROM (VALUES ('u8')) AS e (global_id)),
    dataflow_objects AS
    (
        SELECT sdgi.id AS dataflow_id, sdgi.global_id AS global_id
        FROM mz_introspection.mz_storage_dataflow_global_ids AS sdgi
        WHERE
            sdgi.id
            = (
                    SELECT max(e_sdgi.id)
                    FROM
                        mz_introspection.mz_storage_dataflow_global_ids
                                AS e_sdgi
                            JOIN
                                explainee AS e
                                ON (e_sdgi.global_id = e.global_id)
                )
    ),
    leaf_operators AS
    (
        SELECT mdod.id::int8 AS operator_id
        FROM mz_introspection.mz_dataflow_operator_dataflows AS mdod
        WHERE
            mdod.dataflow_id IN ( SELECT dataflow_id FROM dataflow_objects )
                AND
            mdod.id
            NOT IN (
            SELECT parent_id FROM mz_introspection.mz_dataflow_operator_parents
            )
    ),
    stage_ranges AS
    (
        SELECT
            ssm.global_id AS global_id,
            ssm.stage_id AS stage_id,
            ssm.parent_stage_id AS parent_stage_id,
            ssm.nesting AS nesting,
            ssm.stage AS stage,
            ssm.operator_id_start AS operator_id_start,
            ssm.operator_id_end AS operator_id_end
        FROM
            mz_introspection.mz_storage_stage_mapping AS ssm
                JOIN
                    dataflow_objects AS dfo
                    ON
                        (
                            ssm.dataflow_id = dfo.dataflow_id
                                AND
                            ssm.global_id = dfo.global_id
                        )
        WHERE
            ssm.global_id IN ( SELECT global_id FROM explainee )
                OR
            (ssm.parent_stage_id IS NULL AND ssm.stage <> 'Export')
    ),
    stages AS
    (
        SELECT DISTINCT
            sr.stage_id AS stage_id,
            sr.nesting AS nesting,
            CASE
                    WHEN sr.stage = 'Export'
                            THEN
                                'Export '
                                || COALESCE(
                                        ms.name || '.' || mo.name, sr.global_id
                                    )
                                || ' ('
                                || sr.global_id
                                || ')'
                        WHEN sr.parent_stage_id IS NULL
                            THEN sr.stage || ' (shared)'
                        ELSE sr.stage
                END
                AS operator
        FROM
            stage_ranges AS sr
                LEFT JOIN
                    mz_internal.mz_object_global_ids AS mogi
                    ON (sr.global_id = mogi.global_id)
                LEFT JOIN mz_catalog.mz_objects AS mo ON (mogi.id = mo.id)
                LEFT JOIN mz_catalog.mz_schemas AS ms ON (mo.schema_id = ms.id)
    ),
    stage_operators AS
    (
        SELECT
            so.stage_id AS stage_id,
            so.nesting AS nesting,
            so.operator_id AS operator_id
        FROM
            (
                        SELECT sr.stage_id, sr.nesting, operator_id
                        FROM
                            stage_ranges AS sr
                                 CROSS JOIN generate_series(sr.operator_id_start::int8, sr.operator_id_end::int8 - 1) AS operator_id
                        UNION ALL
                            SELECT parent.stage_id, parent.nesting, operator_id
                            FROM
                                stage_ranges AS sr
                                    JOIN
                                        (
                                                SELECT DISTINCT
                                                    stage_id, nesting
                                                FROM stage_ranges
                                            )
                                            AS parent
                                        ON
                                            (
                                                sr.parent_stage_id
                                                = parent.stage_id
                                            )
                                     CROSS JOIN generate_series(sr.operator_id_start::int8, sr.operator_id_end::int8 - 1) AS operator_id
                    )
                    AS so
                JOIN leaf_operators AS lo ON (so.operator_id = lo.operator_id)
    ),
    stage_workers AS
    (
        SELECT
            so.stage_id AS stage_id,
            so.nesting AS nesting,
            count(DISTINCT mse.worker_id) AS active_workers
        FROM
            stage_operators AS so
                JOIN
                    mz_introspection.mz_scheduling_elapsed_per_worker AS mse
                    ON (mse.id = so.operator_id)
        WHERE mse.elapsed_ns > 0
        GROUP BY so.stage_id, so.nesting
    ),
    summary_memory AS
    (
        SELECT
            so.stage_id AS stage_id,
            so.nesting AS nesting,
            sum(mas.size) AS total_memory,
            sum(mas.records) AS total_records,
            CASE
                    WHEN count(DISTINCT mas.worker_id) <> 0
                            THEN sum(mas.size) / count(DISTINCT mas.worker_id)
                        ELSE NULL
                END
                AS avg_memory,
            CASE
                    WHEN count(DISTINCT mas.worker_id) <> 0
                            THEN
                                sum(mas.records) / count(DISTINCT mas.worker_id)
                        ELSE NULL
                END
                AS avg_records
        FROM
            stage_operators AS so
                JOIN
                    mz_introspection.mz_arrangement_sizes_per_worker AS mas
                    ON (mas.operator_id = so.operator_id)
        GROUP BY so.stage_id, so.nesting
    ),
    per_worker_memory AS
    (
        SELECT
            so.stage_id AS stage_id,
            so.nesting AS nesting,
            mas.worker_id AS worker_id,
            sum(mas.size) AS worker_memory,
            sum(mas.records) AS worker_records
        FROM
            stage_operators AS so
                JOIN
                    mz_introspection.mz_arrangement_sizes_per_worker AS mas
                    ON (mas.operator_id = so.operator_id)
        GROUP BY so.stage_id, so.nesting, mas.worker_id
    ),
    summary_cpu AS
    (
        SELECT
            so.stage_id AS stage_id,
            so.nesting AS nesting,
            sum(mse.elapsed_ns) AS total_ns,
            CASE
                    WHEN count(DISTINCT mse.worker_id) <> 0
                            THEN
                                sum(mse.elapsed_ns)
                                / count(DISTINCT mse.worker_id)
                        ELSE NULL
                END
                AS avg_ns
        FROM
            stage_operators AS so
                JOIN
                    mz_introspection.mz_scheduling_elapsed_per_worker AS mse
                    ON (mse.id = so.operator_id)
        GROUP BY so.stage_id, so.nesting
    ),
    per_worker_cpu AS
    (
        SELECT
            so.stage_id AS stage_id,
            so.nesting AS nesting,
            mse.worker_id AS worker_id,
            sum(mse.elapsed_ns) AS worker_ns
        FROM
            stage_operators AS so
                JOIN
                    mz_introspection.mz_scheduling_elapsed_per_worker AS mse
                    ON (mse.id = so.operator_id)
        GROUP BY so.stage_id, so.nesting, mse.worker_id
    )
SELECT
    repeat(' ', nesting * 2 - 2) || s.operator AS operator,
    COALESCE(pwm.worker_id, pwc.worker_id) AS worker_id,
    sw.active_workers AS active_workers,
    CASE
            WHEN pwm.worker_id IS NOT NULL AND sm.avg_memory <> 0
                    THEN round(pwm.worker_memory / sm.avg_memory, 2)
                ELSE NULL
        END
        AS memory_ratio,
    pg_size_pretty(pwm.worker_memory) AS worker_memory,
    pg_size_pretty(sm.avg_memory) AS avg_memory,
    pg_size_pretty(sm.total_memory) AS total_memory,
    CASE
            WHEN pwm.worker_id IS NOT NULL AND sm.avg_records <> 0
                    THEN round(pwm.worker_records / sm.avg_records, 2)
                ELSE NULL
        END
        AS records_ratio,
    pwm.worker_records AS worker_records,
    sm.avg_records AS avg_records,
    sm.total_records AS total_records,
    CASE
            WHEN pwc.worker_id IS NOT NULL AND sc.avg_ns <> 0
                    THEN round(pwc.worker_ns / sc.avg_ns, 2)
                ELSE NULL
        END
        AS cpu_ratio,
    pwc.worker_ns / 1000 * '1 microsecond'::interval AS worker_elapsed,
    sc.avg_ns / 1000 * '1 microsecond'::interval AS avg_elapsed,
    sc.total_ns / 1000 * '1 microsecond'::interval AS total_elapsed
FROM
    stages AS s
        LEFT JOIN stage_workers AS sw USING(stage_id, nesting)
        LEFT JOIN summary_memory AS sm USING(stage_id, nesting)
        LEFT JOIN per_worker_memory AS pwm USING(stage_id, nesting)
        LEFT JOIN summary_cpu AS sc USING(stage_id, nesting)
        LEFT JOIN per_worker_cpu AS pwc USING(stage_id, nesting)
WHERE
    (
        pwc.worker_id = pwm.worker_id OR pwc.worker_id IS NULL
            OR
        pwm.worker_id IS NULL
    )
ORDER BY stage_id, nesting, worker_id;
EOF

query T multiline
EXPLAIN ANALYZE CPU FOR TABLE bids AS SQL
----
WITH
    explainee AS
    (SELECT global_id FROM (VALUES ('u5')) AS e (global_id)),
    dataflow_objects AS
    (
        SELECT sdgi.id AS dataflow_id, sdgi.global_id AS global_id
        FROM mz_introspection.mz_storage_dataflow_global_ids AS sdgi
        WHERE
            sdgi.id
            = (
                    SELECT max(e_sdgi.id)
                    FROM
                        mz_introspection.mz_storage_dataflow_global_ids
                                AS e_sdgi
                            JOIN
                                explainee AS e
                                ON (e_sdgi.global_id = e.global_id)
                )
    ),
    leaf_operators AS
    (
        SELECT mdod.id::int8 AS operator_id
        FROM mz_introspection.mz_dataflow_operator_dataflows AS mdod
        WHERE
            mdod.dataflow_id IN ( SELECT dataflow_id FROM dataflow_objects )
                AND
            mdod.id
            NOT IN (
            SELECT parent_id FROM mz_introspection.mz_dataflow_operator_parents
            )
    ),
    stage_ranges AS
    (
        SELECT
            ssm.global_id AS global_id,
            ssm.stage_id AS stage_id,
            ssm.parent_stage_id AS parent_stage_id,
            ssm.nesting AS nesting,
            ssm.stage AS stage,
            ssm.operator_id_start AS operator_id_start,
            ssm.operator_id_end AS operator_id_end
        FROM
            mz_introspection.mz_storage_stage_mapping AS ssm
                JOIN
                    dataflow_objects AS dfo
                    ON
                        (
                            ssm.dataflow_id = dfo.dataflow_id
                                AND
                            ssm.global_id = dfo.global_id
                        )
        WHERE
            ssm.global_id IN ( SELECT global_id FROM explainee )
                OR
            (ssm.parent_stage_id IS NULL AND ssm.stage <> 'Export')
    ),
    stages AS
    (
        SELECT DISTINCT
            sr.stage_id AS stage_id,
            sr.nesting AS nesting,
            CASE
                    WHEN sr.stage = 'Export'
                            THEN
                                'Export '
                                || COALESCE(
                                        ms.name || '.' || mo.name, sr.global_id
                                    )
                                || ' ('
                                || sr.global_id
                                || ')'
                        WHEN sr.parent_stage_id IS NULL
                            THEN sr.stage || ' (shared)'
                        ELSE sr.stage
                END
                AS operator
        FROM
            stage_ranges AS sr
                LEFT JOIN
                    mz_internal.mz_object_global_ids AS mogi
                    ON (sr.global_id = mogi.global_id)
                LEFT JOIN mz_catalog.mz_objects AS mo ON (mogi.id = mo.id)
                LEFT JOIN mz_catalog.mz_schemas AS ms ON (mo.schema_id = ms.id)
    ),
    stage_operators AS
    (
        SELECT
            so.stage_id AS stage_id,
            so.nesting AS nesting,
            so.operator_id AS operator_id
        FROM
            (
                        SELECT sr.stage_id, sr.nesting, operator_id
                        FROM
                            stage_ranges AS sr
                                 CROSS JOIN generate_series(sr.operator_id_start::int8, sr.operator_id_end::int8 - 1) AS operator_id
                        UNION ALL
                            SELECT parent.stage_id, parent.nesting, operator_id
                            FROM
                                stage_ranges AS sr
                                    JOIN
                                        (
                                                SELECT DISTINCT
                                                    stage_id, nesting
                                                FROM stage_ranges
                                            )
                                            AS parent
                                        ON
                                            (
                                                sr.parent_stage_id
                                                = parent.stage_id
                                            )
                                     CROSS JOIN generate_series(sr.operator_id_start::int8, sr.operator_id_end::int8 - 1) AS operator_id
                    )
                    AS so
                JOIN leaf_operators AS lo ON (so.operator_id = lo.operator_id)
    ),
    summary_cpu AS
    (
        SELECT
            so.stage_id AS stage_id,
            so.nesting AS nesting,
            sum(mse.elapsed_ns) AS total_ns,
            CASE
                    WHEN count(DISTINCT mse.worker_id) <> 0
                            THEN
                                sum(mse.elapsed_ns)
                                / count(DISTINCT mse.worker_id)
                        ELSE NULL
                END
                AS avg_ns
        FROM
            stage_operators AS so
                JOIN
                    mz_introspection.mz_scheduling_elapsed_per_worker AS mse
                    ON (mse.id = so.operator_id)
        GROUP BY so.stage_id, so.nesting
    )
SELECT
    repeat(' ', nesting * 2 - 2) || s.operator AS operator,
    sc.total_ns / 1000 * '1 microsecond'::interval AS total_elapsed
FROM stages AS s LEFT JOIN summary_cpu AS sc USING(stage_id, nesting)
ORDER BY stage_id, nesting;
EOF

query T multiline
EXPLAIN ANALYZE CLUSTER CPU AS SQL
----
WITH
    operator_ranges AS
    (
        SELECT
            global_id,
            lir_id AS node_id,
            operator_id_start,
            operator_id_end,
            false AS is_storage
        FROM mz_introspection.mz_lir_mapping
        UNION ALL
            SELECT
                global_id,
                stage_id AS node_id,
                operator_id_start,
                operator_id_end,
                true AS is_storage
            FROM mz_introspection.mz_storage_stage_mapping
    ),
    cpu_operators AS
    (
        SELECT
            mlm.global_id AS global_id,
            mlm.node_id AS node_id,
            valid_id AS operator_id
        FROM
            operator_ranges AS mlm
                 CROSS JOIN generate_series((mlm.operator_id_start)::int8, (mlm.operator_id_end - 1)::int8) AS valid_id
        WHERE NOT mlm.is_storage
        UNION ALL
            SELECT
                mlm.global_id AS global_id,
                mlm.node_id AS node_id,
                valid_id AS operator_id
            FROM
                operator_ranges AS mlm
                     CROSS JOIN generate_series((mlm.operator_id_start)::int8, (mlm.operator_id_end - 1)::int8) AS valid_id
            WHERE
                mlm.is_storage
                    AND
                valid_id
                NOT IN (
                SELECT parent_id::int8
                FROM mz_introspection.mz_dataflow_operator_parents
                )
    ),
    per_operator_cpu_totals AS
    (
        SELECT
            mlm.global_id AS global_id,
            mlm.node_id AS node_id,
            sum(mse.elapsed_ns) AS total_ns
        FROM
            cpu_operators AS mlm
                JOIN
                    mz_introspection.mz_scheduling_elapsed_per_worker AS mse
                    ON (mse.id = mlm.operator_id)
        GROUP BY mlm.global_id, mlm.node_id
    ),
    object_cpu_totals AS
    (
        SELECT poct.global_id AS global_id, sum(poct.total_ns) AS total_ns
        FROM per_operator_cpu_totals AS poct
        GROUP BY poct.global_id
    )
SELECT
    mo.name AS object,
    mo.global_id AS global_id,
    oct.total_ns / 1000 * '1 microsecond'::interval AS total_elapsed
FROM
    mz_introspection.mz_mappable_objects AS mo
        LEFT JOIN object_cpu_totals AS oct USING(global_id)
ORDER BY total_elapsed DESC NULLS LAST, mo.name DESC;
EOF

