# CREATE MATERIALIZED VIEW ... FROM PLAN: syntax, feature flag, purification and planning errors.

mode cockroach

statement ok
CREATE TABLE t (a int8 NOT NULL)

statement ok
CREATE TABLE u (a int8 NOT NULL)

statement ok
CREATE INDEX u_a ON u (a)

statement ok
CREATE VIEW v AS SELECT a FROM t

statement ok
CREATE INDEX v_a ON v (a)

statement ok
CREATE CLUSTER other REPLICAS ()

# The syntax is gated.

simple conn=mz_system,user=mz_system
ALTER SYSTEM SET enable_lir_plans = false
----
COMPLETE 0

statement error LIR plan syntax \(FROM PLAN, AS LIR JSON\) is not available
CREATE MATERIALIZED VIEW m (a int8 NOT NULL) FROM PLAN '{"lir_version":1,"imports":[{"id":{"Transient":1},"source":{"Name":"t"},"persist":true,"indexes":[]}],"objects":[{"id":{"Transient":2},"plan":{"lir_id":1,"node":{"Get":{"id":{"Global":{"Transient":1}},"keys":{"raw":true,"arranged":[]},"plan":"PassArrangements"}}}}],"output":{"Transient":2}}'

simple conn=mz_system,user=mz_system
ALTER SYSTEM SET enable_lir_plans = true
----
COMPLETE 0

# A valid plan passes purification and planning.
# TODO: Installing the plan is not implemented yet.
statement error CREATE MATERIALIZED VIEW \.\.\. FROM PLAN are not supported
CREATE MATERIALIZED VIEW m (a int8 NOT NULL) FROM PLAN '{"lir_version":1,"imports":[{"id":{"Transient":1},"source":{"Name":"t"},"persist":true,"indexes":[]}],"objects":[{"id":{"Transient":2},"plan":{"lir_id":1,"node":{"Get":{"id":{"Global":{"Transient":1}},"keys":{"raw":true,"arranged":[]},"plan":"PassArrangements"}}}}],"output":{"Transient":2}}'

# Column definitions.

statement error type modifiers are not supported in FROM PLAN column definitions
CREATE MATERIALIZED VIEW m (a numeric(10, 2)) FROM PLAN '{"lir_version":1,"imports":[{"id":{"Transient":1},"source":{"Name":"t"},"persist":true,"indexes":[]}],"objects":[{"id":{"Transient":2},"plan":{"lir_id":1,"node":{"Get":{"id":{"Global":{"Transient":1}},"keys":{"raw":true,"arranged":[]},"plan":"PassArrangements"}}}}],"output":{"Transient":2}}'

statement error type modifiers are not supported in FROM PLAN column definitions
