# The import is `pt`.
query T
SELECT id FROM mz_tables WHERE name = 'pt'
----
u10

# Explaining an installed plan. Its objects are renumbered to fresh transient ids, which
# depend on how many ids were allocated before.
replace (^|\s)t\d+\b  ${1}t<id>

query T multiline
EXPLAIN PHYSICAL PLAN FOR MATERIALIZED VIEW p2
----
t<id>:
  Reduce::Accumulable
    simple_aggrs[0]=(0, count(*))
    key_plan=id
    val_plan
      project=(#1)
      map=(true)
    Get::Collection t<id>
      raw=true

t<id>:
  Mfp
    project=(#0)
    Get::PassArrangements materialize.public.pt
      raw=true

