# `char` means `char(1)`.
statement error type modifiers are not supported in FROM PLAN column definitions
CREATE MATERIALIZED VIEW m (a char) FROM PLAN '{"lir_version":1,"imports":[{"id":{"Transient":1},"source":{"Name":"t"},"persist":true,"indexes":[]}],"objects":[{"id":{"Transient":2},"plan":{"lir_id":1,"node":{"Get":{"id":{"Global":{"Transient":1}},"keys":{"raw":true,"arranged":[]},"plan":"PassArrangements"}}}}],"output":{"Transient":2}}'

statement error column "a" specified more than once
CREATE MATERIALIZED VIEW m (a int8, a int8) FROM PLAN '{"lir_version":1,"imports":[{"id":{"Transient":1},"source":{"Name":"t"},"persist":true,"indexes":[]}],"objects":[{"id":{"Transient":2},"plan":{"lir_id":1,"node":{"Get":{"id":{"Global":{"Transient":1}},"keys":{"raw":true,"arranged":[]},"plan":"PassArrangements"}}}}],"output":{"Transient":2}}'

statement error column option DEFAULT 1 in FROM PLAN column definitions not yet supported
CREATE MATERIALIZED VIEW m (a int8 DEFAULT 1) FROM PLAN '{"lir_version":1,"imports":[{"id":{"Transient":1},"source":{"Name":"t"},"persist":true,"indexes":[]}],"objects":[{"id":{"Transient":2},"plan":{"lir_id":1,"node":{"Get":{"id":{"Global":{"Transient":1}},"keys":{"raw":true,"arranged":[]},"plan":"PassArrangements"}}}}],"output":{"Transient":2}}'

statement error column definitions are only supported with FROM PLAN
CREATE MATERIALIZED VIEW m (a int8) AS SELECT 1

statement error FROM PLAN requires column definitions
CREATE MATERIALIZED VIEW m FROM PLAN '{"lir_version":1,"imports":[{"id":{"Transient":1},"source":{"Name":"t"},"persist":true,"indexes":[]}],"objects":[{"id":{"Transient":2},"plan":{"lir_id":1,"node":{"Get":{"id":{"Global":{"Transient":1}},"keys":{"raw":true,"arranged":[]},"plan":"PassArrangements"}}}}],"output":{"Transient":2}}'

# Envelopes.

statement error unsupported lir_version 2, expected 1
CREATE MATERIALIZED VIEW m (a int8) FROM PLAN '{"lir_version":2,"imports":[{"id":{"Transient":1},"source":{"Name":"t"},"persist":true,"indexes":[]}],"objects":[{"id":{"Transient":2},"plan":{"lir_id":1,"node":{"Get":{"id":{"Global":{"Transient":1}},"keys":{"raw":true,"arranged":[]},"plan":"PassArrangements"}}}}],"output":{"Transient":2}}'

statement error invalid LIR plan envelope
CREATE MATERIALIZED VIEW m (a int8) FROM PLAN 'not json'

statement error import id u1 in LIR plan must be transient
CREATE MATERIALIZED VIEW m (a int8) FROM PLAN '{"lir_version":1,"imports":[{"id":{"User":1},"source":{"Name":"t"},"persist":true,"indexes":[]}],"objects":[{"id":{"Transient":2},"plan":{"lir_id":1,"node":{"Get":{"id":{"Global":{"Transient":1}},"keys":{"raw":true,"arranged":[]},"plan":"PassArrangements"}}}}],"output":{"Transient":2}}'

statement error object id u2 in LIR plan must be transient
CREATE MATERIALIZED VIEW m (a int8) FROM PLAN '{"lir_version":1,"imports":[{"id":{"Transient":1},"source":{"Name":"t"},"persist":true,"indexes":[]}],"objects":[{"id":{"User":2},"plan":{"lir_id":1,"node":{"Get":{"id":{"Global":{"Transient":1}},"keys":{"raw":true,"arranged":[]},"plan":"PassArrangements"}}}}],"output":{"User":2}}'

statement error plans must read catalog relations through imports
CREATE MATERIALIZED VIEW m (a int8) FROM PLAN '{"lir_version":1,"imports":[{"id":{"Transient":1},"source":{"Name":"t"},"persist":true,"indexes":[]}],"objects":[{"id":{"Transient":2},"plan":{"lir_id":1,"node":{"Get":{"id":{"Global":{"User":1}},"keys":{"raw":true,"arranged":[]},"plan":"PassArrangements"}}}}],"output":{"Transient":2}}'

# Imports.

statement error unknown catalog item 'nope'
CREATE MATERIALIZED VIEW m (a int8) FROM PLAN '{"lir_version":1,"imports":[{"id":{"Transient":1},"source":{"Name":"nope"},"persist":true,"indexes":[]}],"objects":[{"id":{"Transient":2},"plan":{"lir_id":1,"node":{"Get":{"id":{"Global":{"Transient":1}},"keys":{"raw":true,"arranged":[]},"plan":"PassArrangements"}}}}],"output":{"Transient":2}}'

statement error unknown catalog item u999999 in LIR plan
CREATE MATERIALIZED VIEW m (a int8) FROM PLAN '{"lir_version":1,"imports":[{"id":{"Transient":1},"source":{"Item":{"item_id":{"User":999999},"version":0}},"persist":true,"indexes":[]}],"objects":[{"id":{"Transient":2},"plan":{"lir_id":1,"node":{"Get":{"id":{"Global":{"Transient":1}},"keys":{"raw":true,"arranged":[]},"plan":"PassArrangements"}}}}],"output":{"Transient":2}}'

statement error LIR plan cannot read from persist view v
CREATE MATERIALIZED VIEW m (a int8) FROM PLAN '{"lir_version":1,"imports":[{"id":{"Transient":1},"source":{"Name":"v"},"persist":true,"indexes":[]}],"objects":[{"id":{"Transient":2},"plan":{"lir_id":1,"node":{"Get":{"id":{"Global":{"Transient":1}},"keys":{"raw":true,"arranged":[]},"plan":"PassArrangements"}}}}],"output":{"Transient":2}}'

statement error LIR plan cannot import index u_a
CREATE MATERIALIZED VIEW m (a int8) FROM PLAN '{"lir_version":1,"imports":[{"id":{"Transient":1},"source":{"Name":"u_a"},"persist":false,"indexes":[]}],"objects":[{"id":{"Transient":2},"plan":{"lir_id":1,"node":{"Get":{"id":{"Global":{"Transient":1}},"keys":{"raw":true,"arranged":[]},"plan":"PassArrangements"}}}}],"output":{"Transient":2}}'

statement error u_a is not an index on t
CREATE MATERIALIZED VIEW m (a int8) FROM PLAN '{"lir_version":1,"imports":[{"id":{"Transient":1},"source":{"Name":"t"},"persist":false,"indexes":[{"Name":"u_a"}]}],"objects":[{"id":{"Transient":2},"plan":{"lir_id":1,"node":{"Get":{"id":{"Global":{"Transient":1}},"keys":{"raw":true,"arranged":[]},"plan":"PassArrangements"}}}}],"output":{"Transient":2}}'

statement error u is not an index on t
CREATE MATERIALIZED VIEW m (a int8) FROM PLAN '{"lir_version":1,"imports":[{"id":{"Transient":1},"source":{"Name":"t"},"persist":false,"indexes":[{"Name":"u"}]}],"objects":[{"id":{"Transient":2},"plan":{"lir_id":1,"node":{"Get":{"id":{"Global":{"Transient":1}},"keys":{"raw":true,"arranged":[]},"plan":"PassArrangements"}}}}],"output":{"Transient":2}}'

statement error index u_a is on cluster quickstart, but the materialized view is on cluster other
CREATE MATERIALIZED VIEW m (a int8) IN CLUSTER other FROM PLAN '{"lir_version":1,"imports":[{"id":{"Transient":1},"source":{"Name":"u"},"persist":false,"indexes":[{"Name":"u_a"}]}],"objects":[{"id":{"Transient":2},"plan":{"lir_id":1,"node":{"Get":{"id":{"Global":{"Transient":1}},"keys":{"raw":true,"arranged":[]},"plan":"PassArrangements"}}}}],"output":{"Transient":2}}'

# The index is on the materialized view's cluster.
statement error CREATE MATERIALIZED VIEW \.\.\. FROM PLAN are not supported
CREATE MATERIALIZED VIEW m (a int8) FROM PLAN '{"lir_version":1,"imports":[{"id":{"Transient":1},"source":{"Name":"u"},"persist":false,"indexes":[{"Name":"u_a"}]}],"objects":[{"id":{"Transient":2},"plan":{"lir_id":1,"node":{"Get":{"id":{"Global":{"Transient":1}},"keys":{"raw":true,"arranged":[]},"plan":"PassArrangements"}}}}],"output":{"Transient":2}}'

# A view is read through at least one index.
statement error LIR plan must import view v through at least one index
CREATE MATERIALIZED VIEW m (a int8) FROM PLAN '{"lir_version":1,"imports":[{"id":{"Transient":1},"source":{"Name":"v"},"persist":false,"indexes":[]}],"objects":[{"id":{"Transient":2},"plan":{"lir_id":1,"node":{"Get":{"id":{"Global":{"Transient":1}},"keys":{"raw":true,"arranged":[]},"plan":"PassArrangements"}}}}],"output":{"Transient":2}}'

statement error CREATE MATERIALIZED VIEW \.\.\. FROM PLAN are not supported
CREATE MATERIALIZED VIEW m (a int8) FROM PLAN '{"lir_version":1,"imports":[{"id":{"Transient":1},"source":{"Name":"v"},"persist":false,"indexes":[{"Name":"v_a"}]}],"objects":[{"id":{"Transient":2},"plan":{"lir_id":1,"node":{"Get":{"id":{"Global":{"Transient":1}},"keys":{"raw":true,"arranged":[]},"plan":"PassArrangements"}}}}],"output":{"Transient":2}}'

# A replacement cannot import its own target.
statement ok
CREATE MATERIALIZED VIEW mvt AS SELECT a FROM t

statement error replacement would cause mvt to depend on itself
CREATE REPLACEMENT MATERIALIZED VIEW rp (a int8 NOT NULL) FOR mvt FROM PLAN '{"lir_version":1,"imports":[{"id":{"Transient":1},"source":{"Name":"mvt"},"persist":true,"indexes":[]}],"objects":[{"id":{"Transient":2},"plan":{"lir_id":1,"node":{"Get":{"id":{"Global":{"Transient":1}},"keys":{"raw":true,"arranged":[]},"plan":"PassArrangements"}}}}],"output":{"Transient":2}}'

statement error EXPLAIN CREATE MATERIALIZED VIEW \.\.\. FROM PLAN not yet supported
EXPLAIN CREATE MATERIALIZED VIEW m (a int8) FROM PLAN '{"lir_version":1,"imports":[{"id":{"Transient":1},"source":{"Name":"t"},"persist":true,"indexes":[]}],"objects":[{"id":{"Transient":2},"plan":{"lir_id":1,"node":{"Get":{"id":{"Global":{"Transient":1}},"keys":{"raw":true,"arranged":[]},"plan":"PassArrangements"}}}}],"output":{"Transient":2}}'
