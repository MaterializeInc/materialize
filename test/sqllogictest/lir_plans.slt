# Installing plans.
#
# The plans below are the output of `EXPLAIN PHYSICAL PLAN AS LIR JSON` for the SQL materialized
# views next to them, with the import names adjusted to the tables of this file.

statement ok
CREATE TABLE pt (a int8 NOT NULL, b int8)

statement ok
CREATE TABLE pu (a int8 NOT NULL, c text)

statement ok
CREATE INDEX pu_a ON pu (a)

statement ok
INSERT INTO pt VALUES (1, 10), (2, NULL), (3, 30), (3, 31)

statement ok
INSERT INTO pu VALUES (1, 'one'), (3, 'three'), (4, 'four')

# A join of a persist import and an index import.
statement ok
CREATE MATERIALIZED VIEW mv1 AS SELECT pt.a, pt.b, pu.c FROM pt JOIN pu ON pt.a = pu.a

statement ok
CREATE MATERIALIZED VIEW p1 (a int8 NOT NULL, b int8, c text) FROM PLAN '{"lir_version":1,"imports":[{"id":{"Transient":1},"source":{"Name":"materialize.public.pt"},"persist":true,"indexes":[]},{"id":{"Transient":2},"source":{"Name":"materialize.public.pu"},"persist":false,"indexes":[{"Name":"materialize.public.pu_a"}]}],"objects":[{"id":{"Transient":3},"plan":{"lir_id":4,"node":{"Join":{"inputs":[{"lir_id":2,"node":{"ArrangeBy":{"input_key":null,"input":{"lir_id":1,"node":{"Get":{"id":{"Global":{"Transient":1}},"keys":{"raw":true,"arranged":[]},"plan":"PassArrangements"}}},"input_mfp":{"mfp":{"mfp":{"expressions":[],"predicates":[],"projection":[0,1],"input_arity":2}},"lower_bounds":[],"upper_bounds":[]},"forms":{"raw":true,"arranged":[[[{"Column":[0,"a"]}],[0,1],[1]]]},"strategy":"Direct"}}},{"lir_id":3,"node":{"Get":{"id":{"Global":{"Transient":2}},"keys":{"raw":false,"arranged":[[[{"Column":[0,"a"]}],[0,1],[1]]]},"plan":"PassArrangements"}}}],"plan":{"Linear":{"source_relation":1,"source_key":[{"Column":[0,"a"]}],"initial_closure":null,"stage_plans":[{"lookup_relation":0,"stream_key":[{"Column":[0,"a"]}],"stream_thinning":[1],"lookup_key":[{"Column":[0,"a"]}],"closure":{"ready_equivalences":[],"before":{"mfp":{"expressions":[],"predicates":[],"projection":[0,2,1],"input_arity":3}}}}],"final_closure":null}}}}}}],"output":{"Transient":3}}'

query IIT rowsort
SELECT * FROM p1
----
1  10  one
3  30  three
3  31  three

query I
SELECT count(*) FROM ((SELECT * FROM p1 EXCEPT ALL SELECT * FROM mv1) UNION ALL (SELECT * FROM mv1 EXCEPT ALL SELECT * FROM p1))
----
0

