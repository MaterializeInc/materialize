# Purification records the imports by id.
replace AS OF \d{13}  AS OF <TIMESTAMP>

query T multiline
SELECT create_sql FROM mz_materialized_views WHERE name = 'p2'
----
CREATE MATERIALIZED VIEW "materialize"."public"."p2" ("a" [s22 AS "pg_catalog"."int8"] NOT NULL, "n" [s22 AS "pg_catalog"."int8"] NOT NULL) IN CLUSTER [u1] WITH (REFRESH = ON COMMIT) FROM PLAN '{
  "lir_version": 1,
  "imports": [
    {
      "id": {
        "Transient": 1
      },
      "source": {
        "Item": {
          "item_id": {
            "User": 10
          },
          "version": 0
        }
      },
      "persist": true,
      "indexes": []
    }
  ],
  "objects": [
    {
      "id": {
        "Transient": 2
      },
      "plan": {
        "lir_id": 4,
        "node": {
          "Mfp": {
            "input": {
              "lir_id": 3,
              "node": {
                "Get": {
                  "id": {
                    "Global": {
                      "Transient": 1
                    }
                  },
                  "keys": {
                    "raw": true,
                    "arranged": []
                  },
                  "plan": "PassArrangements"
                }
              }
            },
            "mfp": {
              "mfp": {
                "mfp": {
                  "expressions": [],
                  "predicates": [],
                  "projection": [
