statement ok
CREATE MATERIALIZED VIEW reachable_sql AS
WITH MUTUALLY RECURSIVE (ERROR AT RECURSION LIMIT 10000) r (src int8, dst int8) AS (
  SELECT src, dst FROM edges
  UNION
  SELECT r.src, e.dst FROM r JOIN edges e ON r.dst = e.src
)
SELECT * FROM r

query II rowsort
SELECT * FROM reachable
----
1  2
1  3
1  4
2  3
2  4
3  4
10  10
10  11
10  12
11  10
11  11
11  12
12  10
12  11
12  12

query II rowsort
(SELECT * FROM reachable EXCEPT ALL SELECT * FROM reachable_sql)
UNION ALL
(SELECT * FROM reachable_sql EXCEPT ALL SELECT * FROM reachable)
----

# A recursion that reaches its iteration limit is an error, as with
# `ERROR AT RECURSION LIMIT` in SQL. The cycle needs more than two iterations.

# datalog2lir.py examples/tc.dl --output reachable --import edges=materialize.public.edges --limit 2
statement ok
