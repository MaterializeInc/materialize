# Connect the chain to the cycle, and add a duplicate edge, which set semantics absorbs.
statement ok
INSERT INTO edges VALUES (4, 10), (1, 2)

query I rowsort
SELECT count(*) FROM reachable
----
27

query II rowsort
(SELECT * FROM reachable EXCEPT ALL SELECT * FROM reachable_sql)
UNION ALL
(SELECT * FROM reachable_sql EXCEPT ALL SELECT * FROM reachable)
----

# Retractions flow through the recursion. Breaking the cycle removes the paths around it.
statement ok
DELETE FROM edges WHERE src = 12

query I rowsort
SELECT count(*) FROM reachable
----
21

query II rowsort
(SELECT * FROM reachable EXCEPT ALL SELECT * FROM reachable_sql)
UNION ALL
(SELECT * FROM reachable_sql EXCEPT ALL SELECT * FROM reachable)
----

