# Plans compiled from Datalog by the toy compiler in misc/lir-datalog, compared with the
# same queries in SQL.
#
# Regenerate each plan with the command in the comment above it, for example
#
#   python3 misc/lir-datalog/datalog2lir.py misc/lir-datalog/examples/tc.dl \
#       --output reachable --import edges=materialize.public.edges

mode cockroach

simple conn=mz_system,user=mz_system
ALTER SYSTEM SET enable_lir_plans = true
----
COMPLETE 0

statement ok
CREATE TABLE edges (src int8 NOT NULL, dst int8 NOT NULL)

# A chain 1 -> 2 -> 3 -> 4 and a cycle 10 -> 11 -> 12 -> 10.
statement ok
INSERT INTO edges VALUES (1, 2), (2, 3), (3, 4), (10, 11), (11, 12), (12, 10)

# datalog2lir.py examples/tc.dl --output reachable --import edges=materialize.public.edges
statement ok
CREATE MATERIALIZED VIEW reachable (src int8 NOT NULL, dst int8 NOT NULL) FROM PLAN '{"imports":[{"id":{"Transient":1},"indexes":[],"persist":true,"source":{"Name":"materialize.public.edges"}}],"lir_version":1,"objects":[{"id":{"Transient":2},"plan":{"lir_id":11,"node":{"LetRec":{"body":{"lir_id":10,"node":{"Get":{"id":{"Local":0},"keys":{"arranged":[],"raw":true},"plan":"PassArrangements"}}},"ids":[0],"limits":[{"max_iters":10000,"return_at_limit":false}],"values":[{"lir_id":9,"node":{"ArrangeBy":{"forms":{"arranged":[],"raw":true},"input":{"lir_id":8,"node":{"Reduce":{"input":{"lir_id":7,"node":{"Union":{"consolidate_output":false,"inputs":[{"lir_id":1,"node":{"Get":{"id":{"Global":{"Transient":1}},"keys":{"arranged":[],"raw":true},"plan":"PassArrangements"}}},{"lir_id":6,"node":{"Join":{"inputs":[{"lir_id":4,"node":{"ArrangeBy":{"forms":{"arranged":[[[{"Column":[1,null]}],[1,0],[0]]],"raw":true},"input":{"lir_id":2,"node":{"Get":{"id":{"Local":0},"keys":{"arranged":[],"raw":true},"plan":"PassArrangements"}}},"input_key":null,"input_mfp":{"lower_bounds":[],"mfp":{"mfp":{"expressions":[],"input_arity":2,"predicates":[],"projection":[0,1]}},"upper_bounds":[]},"strategy":"Direct"}}},{"lir_id":5,"node":{"ArrangeBy":{"forms":{"arranged":[[[{"Column":[0,null]}],[0,1],[1]]],"raw":true},"input":{"lir_id":3,"node":{"Get":{"id":{"Global":{"Transient":1}},"keys":{"arranged":[],"raw":true},"plan":"PassArrangements"}}},"input_key":null,"input_mfp":{"lower_bounds":[],"mfp":{"mfp":{"expressions":[],"input_arity":2,"predicates":[],"projection":[0,1]}},"upper_bounds":[]},"strategy":"Direct"}}}],"plan":{"Linear":{"final_closure":null,"initial_closure":null,"source_key":[{"Column":[1,null]}],"source_relation":0,"stage_plans":[{"closure":{"before":{"mfp":{"expressions":[],"input_arity":3,"predicates":[],"projection":[1,2]}},"ready_equivalences":[]},"lookup_key":[{"Column":[0,null]}],"lookup_relation":1,"stream_key":[{"Column":[1,null]}],"stream_thinning":[0]}]}}}}}],"temporal_bucketi