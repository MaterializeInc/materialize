statement ok
CREATE MATERIALIZED VIEW parity_sql AS
WITH MUTUALLY RECURSIVE (ERROR AT RECURSION LIMIT 10000)
  odd (src int8, dst int8) AS (
    SELECT src, dst FROM edges
    UNION
    SELECT e.src, x.dst FROM even e JOIN edges x ON e.dst = x.src
  ),
  even (src int8, dst int8) AS (
    SELECT DISTINCT o.src, x.dst FROM odd o JOIN edges x ON o.dst = x.src
  )
SELECT 'odd' AS parity, * FROM odd UNION ALL SELECT 'even', * FROM even

query TI rowsort
SELECT parity, count(*) FROM parity_sql GROUP BY parity
----
even  14
odd  17

query TII rowsort
(SELECT 'odd', * FROM odd UNION ALL SELECT 'even', * FROM even)
EXCEPT ALL SELECT * FROM parity_sql
----

query TII rowsort
SELECT * FROM parity_sql
EXCEPT ALL (SELECT 'odd', * FROM odd UNION ALL SELECT 'even', * FROM even)
----

