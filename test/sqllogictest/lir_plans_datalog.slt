# A format reference for the encoder test in misc/lir-datalog, covering a delta join, a
# literal, scalar functions, and an aggregation.
statement ok
CREATE MATERIALIZED VIEW format_reference AS
SELECT a.src, count(*), max(c.dst)
FROM edges a, edges b, edges c
WHERE a.dst = b.src AND b.dst = c.src AND a.src > 1
GROUP BY a.src

query T multiline
