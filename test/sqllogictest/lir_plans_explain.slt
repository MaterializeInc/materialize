# EXPLAIN PHYSICAL PLAN AS LIR JSON prints the plan envelope of a materialized view.

mode cockroach

statement ok
CREATE TABLE t (a int8 NOT NULL, b int8)

statement ok
CREATE TABLE u (a int8 NOT NULL, c text)

statement ok
CREATE INDEX u_a ON u (a)

# The filter on `t` is pushed into its persist import, so the envelope reads `t` through a
# leading `Mfp` object.
statement ok
CREATE MATERIALIZED VIEW mv AS SELECT t.a, t.b, u.c FROM t JOIN u ON t.a = u.a WHERE t.b > 1

query T multiline
EXPLAIN PHYSICAL PLAN AS LIR JSON FOR MATERIALIZED VIEW mv
----
