      },
      "persist": false,
      "indexes": [
        {
          "Name": "materialize.public.\"Idx\"\"Q\""
        }
      ]
    }
  ],
  "objects": [
    {
      "id": {
        "Transient": 2
      },
      "plan": {
        "lir_id": 1,
        "node": {
          "Get": {
            "id": {
              "Global": {
                "Transient": 1
              }
            },
            "keys": {
              "raw": false,
              "arranged": [
                [
                  [
                    {
                      "Column": [
                        0,
                        "a"
                      ]
                    }
                  ],
                  [
                    0
                  ],
                  []
                ]
              ]
            },
            "plan": "PassArrangements"
          }
        }
      }
    }
  ],
  "output": {
    "Transient": 2
  }
}
