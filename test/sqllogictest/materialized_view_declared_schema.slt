# Tests for materialized views with a schema declared through column
# definitions.

mode cockroach

reset-server

statement ok
CREATE TABLE t (a int4, b text, c numeric)

statement ok
INSERT INTO t VALUES (1, 'x', 1.234), (2, 'y', 2.5)

simple conn=mz_system,user=mz_system
ALTER SYSTEM SET enable_materialized_view_column_definitions = false
----
COMPLETE 0

statement error CREATE MATERIALIZED VIEW with column definitions is not available
CREATE MATERIALIZED VIEW mv (a int8) AS SELECT a FROM t

simple conn=mz_system,user=mz_system
ALTER SYSTEM SET enable_materialized_view_column_definitions = true
----
COMPLETE 0

# Declared types, nullability and names replace the inferred ones. The query is
# cast to the declared types with assignment casts.
statement ok
CREATE MATERIALIZED VIEW mv (x int8 NOT NULL, y text, z numeric(10, 1)) AS SELECT a, b, c FROM t

query TTT rowsort
SELECT name, nullable, type FROM (SHOW COLUMNS FROM mv)
----
x  false  bigint
y  true  text
z  true  numeric

query ITR rowsort
SELECT * FROM mv
----
1  x  1.2
2  y  2.5

query T
SELECT create_sql LIKE '%("x" %int8% NOT NULL, "y" %text%, "z" %numeric%10%1%)%' FROM mz_materialized_views WHERE name = 'mv'
----
true

# A column the query proves non-nullable stays nullable unless declared.
statement ok
CREATE MATERIALIZED VIEW mv_nullable (n int8) AS SELECT count(*) FROM t

query TT rowsort
SELECT name, nullable FROM (SHOW COLUMNS FROM mv_nullable)
----
n  true

# Declared NOT NULL is checked at runtime.
statement ok
CREATE MATERIALIZED VIEW mv_not_null (a int4 NOT NULL) AS SELECT a FROM t

query I rowsort
SELECT * FROM mv_not_null
----
1
2

statement ok
INSERT INTO t VALUES (NULL, 'z', 3)

query error column "a" must not be null
SELECT * FROM mv_not_null

statement ok
DELETE FROM t WHERE a IS NULL

statement ok
DROP MATERIALIZED VIEW mv_not_null

# Keys must follow from the keys the optimizer can prove.
statement ok
CREATE MATERIALIZED VIEW mv_pk (a int4 PRIMARY KEY, n int8 NOT NULL) AS SELECT a, count(*) FROM t WHERE a IS NOT NULL GROUP BY a

statement ok
CREATE MATERIALIZED VIEW mv_superkey (a int4, n int8, UNIQUE NULLS NOT DISTINCT (a, n)) AS SELECT a, count(*) FROM t GROUP BY a

statement ok
CREATE MATERIALIZED VIEW mv_nnd (a int4, n int8, UNIQUE NULLS NOT DISTINCT (a)) AS SELECT a, count(*) FROM t GROUP BY a

statement error cannot prove that \(n\) is a key of the materialized view
CREATE MATERIALIZED VIEW mv_bad_key (a int4, n int8 NOT NULL PRIMARY KEY) AS SELECT a, count(*) FROM t GROUP BY a

statement error cannot prove that \(a\) is a key of the materialized view
CREATE MATERIALIZED VIEW mv_bad_key (a int4 PRIMARY KEY) AS SELECT a FROM t

statement error cannot prove that \(a\) is a key of the materialized view
EXPLAIN OPTIMIZED PLAN FOR CREATE MATERIALIZED VIEW mv_bad_key (a int4 PRIMARY KEY) AS SELECT a FROM t

statement error UNIQUE constraint on nullable column "a" is not supported
CREATE MATERIALIZED VIEW mv_bad_key (a int4 UNIQUE) AS SELECT a FROM t GROUP BY a

statement error multiple primary keys for a materialized view are not allowed
CREATE MATERIALIZED VIEW mv_bad_key (a int4 PRIMARY KEY, PRIMARY KEY (a)) AS SELECT a FROM t GROUP BY a

statement error unknown column in constraint: b
CREATE MATERIALIZED VIEW mv_bad_key (a int4, PRIMARY KEY (b)) AS SELECT a FROM t GROUP BY a

# Declared keys and nullability are visible to dependent objects.
statement ok
CREATE MATERIALIZED VIEW mv_pk_reader AS SELECT * FROM mv_pk

query T multiline
EXPLAIN OPTIMIZED PLAN WITH (humanized expressions, schema) AS VERBOSE TEXT FOR MATERIALIZED VIEW mv_pk_reader
----
materialize.public.mv_pk_reader:
  ReadStorage materialize.public.mv_pk

Source materialize.public.mv_pk

Schema of materialize.public.mv_pk_reader:
  a integer NOT NULL,
  n bigint NOT NULL,
  UNIQUE (a)

Target cluster: quickstart

EOF

# Keys over nullable columns are printed as UNIQUE NULLS NOT DISTINCT.
statement ok
CREATE MATERIALIZED VIEW mv_nnd_reader AS SELECT * FROM mv_nnd

query T multiline
EXPLAIN OPTIMIZED PLAN WITH (humanized expressions, schema) AS VERBOSE TEXT FOR MATERIALIZED VIEW mv_nnd_reader
----
materialize.public.mv_nnd_reader:
  ReadStorage materialize.public.mv_nnd

Source materialize.public.mv_nnd

Schema of materialize.public.mv_nnd_reader:
  a integer,
  n bigint,
  UNIQUE NULLS NOT DISTINCT (a)

Target cluster: quickstart

EOF

# Planning errors.
statement error materialized view materialize.public.mv_err declares 1 columns, but its query produces 2
CREATE MATERIALIZED VIEW mv_err (a int4) AS SELECT a, b FROM t

statement error column "a" is of type timestamp with time zone but expression is of type integer
CREATE MATERIALIZED VIEW mv_err (a timestamptz) AS SELECT a FROM t

statement error column "a" specified more than once
CREATE MATERIALIZED VIEW mv_err (a int4, a text) AS SELECT a, b FROM t

statement error conflicting NULL/NOT NULL declarations for column "a"
CREATE MATERIALIZED VIEW mv_err (a int4 NULL NOT NULL) AS SELECT a FROM t

statement error conflicting NULL/NOT NULL declarations for column "a"
CREATE MATERIALIZED VIEW mv_err (a int4 NULL, PRIMARY KEY (a)) AS SELECT a FROM t GROUP BY a

statement error ASSERT NOT NULL cannot be combined with column definitions
CREATE MATERIALIZED VIEW mv_err (a int4) WITH (ASSERT NOT NULL a) AS SELECT a FROM t

statement error materialized view column definition with option: DEFAULT 1 not yet supported
CREATE MATERIALIZED VIEW mv_err (a int4 DEFAULT 1) AS SELECT a FROM t

statement error CHECK constraints on materialized views not yet supported
CREATE MATERIALIZED VIEW mv_err (a int4, CHECK (a > 0)) AS SELECT a FROM t

# Name lists keep working.
statement ok
CREATE MATERIALIZED VIEW mv_names (p, q) AS SELECT a, b FROM t

query TT rowsort
SELECT name, type FROM (SHOW COLUMNS FROM mv_names)
----
p  integer
q  text

# Replacements are compared against the declared schema.
statement error replacement must declare its schema because its target does
CREATE REPLACEMENT MATERIALIZED VIEW rp (x, y, z) FOR mv AS SELECT a::int8, b, c::numeric(10, 1) FROM t

statement error replacement schema differs from target schema
CREATE REPLACEMENT MATERIALIZED VIEW rp (x int8, y text, z numeric(10, 1)) FOR mv AS SELECT a, b, c FROM t

statement ok
CREATE REPLACEMENT MATERIALIZED VIEW rp (x int8 NOT NULL, y text, z numeric(10, 1)) FOR mv AS SELECT a + 1, b, c FROM t

statement ok
ALTER MATERIALIZED VIEW mv APPLY REPLACEMENT rp

query ITR rowsort
SELECT * FROM mv
----
2  x  1.2
3  y  2.5

query T
SELECT create_sql LIKE '%("x" %int8% NOT NULL, "y" %text%, "z" %numeric%10%1%)%' FROM mz_materialized_views WHERE name = 'mv'
----
true

# A replacement without a column list gets the target's column definitions,
# including names, and is cast to them as if they were written out.
statement error materialized view materialize.public.rp declares 3 columns, but its query produces 2
CREATE REPLACEMENT MATERIALIZED VIEW rp FOR mv AS SELECT a::int8, b FROM t

statement ok
CREATE REPLACEMENT MATERIALIZED VIEW rp FOR mv AS SELECT a * 10 AS ignored, b, c FROM t

query TTT rowsort
SELECT name, nullable, type FROM (SHOW COLUMNS FROM rp)
----
x  false  bigint
y  true  text
z  true  numeric

query T
SELECT create_sql LIKE '%("x" %int8% NOT NULL, "y" %text%, "z" %numeric%10%1%)%' FROM mz_materialized_views WHERE name = 'rp'
----
true

statement ok
ALTER MATERIALIZED VIEW mv APPLY REPLACEMENT rp

query ITR rowsort
SELECT * FROM mv
----
10  x  1.2
20  y  2.5

query T
SELECT create_sql LIKE '%("x" %int8% NOT NULL, "y" %text%, "z" %numeric%10%1%)%' FROM mz_materialized_views WHERE name = 'mv'
----
true

# Types used by inherited column definitions are dependencies, also after the
# replacement is applied.
statement ok
CREATE TYPE int4_list AS LIST (ELEMENT TYPE = int4)

statement ok
CREATE VIEW lists AS SELECT LIST[a]::int4_list AS l FROM t

statement ok
CREATE MATERIALIZED VIEW mv_typed (l int4_list) AS SELECT l FROM lists

statement ok
CREATE REPLACEMENT MATERIALIZED VIEW rp FOR mv_typed AS SELECT l FROM lists

statement ok
ALTER MATERIALIZED VIEW mv_typed APPLY REPLACEMENT rp

query I
SELECT count(*)
FROM mz_internal.mz_object_dependencies d
JOIN mz_materialized_views m ON d.object_id = m.id
JOIN mz_types ty ON d.referenced_object_id = ty.id
WHERE m.name = 'mv_typed' AND ty.name = 'int4_list'
----
1

# An implicit target can be given a declared schema that matches its current
# one.
statement ok
CREATE REPLACEMENT MATERIALIZED VIEW rp (p int4, q text) FOR mv_names AS SELECT a, b FROM t

statement ok
ALTER MATERIALIZED VIEW mv_names APPLY REPLACEMENT rp

query T
SELECT create_sql LIKE '%("p" %int4%, "q" %text%)%' FROM mz_materialized_views WHERE name = 'mv_names'
----
true
