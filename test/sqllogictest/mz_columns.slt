# --- User relations: every type spelling ---------------------------------------

statement ok
CREATE TYPE r AS (a int, b text)

statement ok
CREATE TYPE l AS LIST (ELEMENT TYPE = int4)

statement ok
CREATE TYPE m AS MAP (KEY TYPE = text, VALUE TYPE = l)

statement ok
CREATE TABLE t (
    a int,
    b text NOT NULL,
    c numeric(10, 2) DEFAULT 1.5,
    d timestamptz DEFAULT now(),
    e varchar(20) DEFAULT 'x' || 'y',
    f char(3),
    g int4[],
    h int4 list,
    i l,
    j m,
    k r,
    l2 map[text => int],
    n timestamp(3),
    o interval,
    p uint2,
    q date DEFAULT date_trunc('day', now())::date,
    s text DEFAULT coalesce(NULL, 'z'),
    u int8 DEFAULT CAST(1 AS int8),
    w numeric,
    x int4range,
    y r list,
    z "char",
    aa bool,
    ab bytea,
    ac float4,
    ad float8,
    ae int2,
    af jsonb,
    ag oid,
    ah time,
    ai uuid,
    aj uint4,
    ak uint8,
    al mz_timestamp,
    am text[],
    an l list
)

statement ok
ALTER TABLE t ADD COLUMN v text

