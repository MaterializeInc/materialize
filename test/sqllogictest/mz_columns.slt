mode cockroach

reset-server

simple conn=mz_system,user=mz_system
ALTER SYSTEM SET enable_alter_table_add_column = true
----
COMPLETE 0

# --- Only relations have rows ------------------------------------------

query T
SELECT DISTINCT objects.type
FROM mz_catalog.mz_columns columns
JOIN mz_catalog.mz_objects objects ON objects.id = columns.id
ORDER BY objects.type
----
materialized-view
source
table
view

# Every row belongs to a relation.
query I
SELECT count(*)
FROM mz_catalog.mz_columns columns
LEFT JOIN mz_catalog.mz_relations relations ON relations.id = columns.id
WHERE relations.id IS NULL
----
0

# Column positions are 1-based and contiguous. Column names are unique too.
query I
SELECT count(*)
FROM (
    SELECT id, count(*) AS n, min(position) AS lo, max(position) AS hi, count(DISTINCT name) AS names
    FROM mz_catalog.mz_columns
    GROUP BY id
)
WHERE lo <> 1 OR hi <> n OR names <> n
----
0

# Every column type resolves in mz_types.
query I
SELECT count(*)
FROM mz_catalog.mz_columns columns
LEFT JOIN mz_catalog.mz_types types ON types.oid = columns.type_oid
WHERE types.id IS NULL
----
0

# --- Builtins -----------------------------------------------------------------

# A builtin table's columns carry the string NULL default of every table column
# without one, and no other builtin relation has defaults.
query TT
SELECT objects.type, coalesce(columns.default, '<null>')
FROM mz_catalog.mz_columns columns
JOIN mz_catalog.mz_objects objects ON objects.id = columns.id
WHERE columns.id LIKE 's%'
GROUP BY 1, 2
ORDER BY 1, 2
----
materialized-view  <null>
source  <null>
table  NULL
view  <null>

# `mz_cluster_replica_sizes`'s column information as well as each column's type.
# `type` is the pretty-printed version of the type while `type_name` is the name stored in
# catalog.
query ITTTTTI
SELECT columns.position, columns.name, columns.type, columns.nullable, columns.default, types.name as type_name, columns.type_mod
FROM mz_catalog.mz_columns columns
JOIN mz_catalog.mz_tables tables ON columns.id = tables.id
JOIN mz_catalog.mz_schemas schemas ON tables.schema_id = schemas.id
LEFT JOIN mz_catalog.mz_types types ON types.oid = columns.type_oid
WHERE tables.name = 'mz_cluster_replica_sizes' AND schemas.name = 'mz_catalog'
ORDER BY columns.position
----
1  size  text  false  NULL  text  -1
2  processes  uint8  false  NULL  uint8  -1
3  workers  uint8  false  NULL  uint8  -1
4  cpu_nano_cores  uint8  false  NULL  uint8  -1
5  memory_bytes  uint8  false  NULL  uint8  -1
6  disk_bytes  uint8  true  NULL  uint8  -1
7  credits_per_hour  numeric  false  NULL  numeric  -1

# A log, a source, a materialized view, a view and the generated views that
# report the builtins, including the one that reports these columns.
query TTITTTT
SELECT objects.type, objects.name, columns.position, columns.name, columns.type, columns.nullable, types.name as type_name
FROM mz_catalog.mz_columns columns
JOIN mz_catalog.mz_objects objects ON objects.id = columns.id
JOIN mz_catalog.mz_schemas schemas ON objects.schema_id = schemas.id
LEFT JOIN mz_catalog.mz_types types ON types.oid = columns.type_oid
WHERE
    (schemas.name, objects.name) IN (
        ('mz_introspection', 'mz_active_peeks_per_worker'),
        ('mz_internal', 'mz_catalog_raw'),
        ('mz_catalog', 'mz_tables'),
        ('mz_catalog', 'mz_relations'),
        ('mz_internal', 'mz_builtin_columns'),
        ('mz_internal', 'mz_builtin_views')
    )
ORDER BY objects.name, columns.position
----
source  mz_active_peeks_per_worker  1  id  uuid  false  uuid
source  mz_active_peeks_per_worker  2  worker_id  uint8  false  uint8
source  mz_active_peeks_per_worker  3  object_id  text  false  text
source  mz_active_peeks_per_worker  4  type  text  false  text
source  mz_active_peeks_per_worker  5  time  mz_timestamp  false  mz_timestamp
view  mz_builtin_columns  1  schema_name  text  false  text
view  mz_builtin_columns  2  relation_name  text  false  text
view  mz_builtin_columns  3  name  text  false  text
view  mz_builtin_columns  4  position  uint8  false  uint8
view  mz_builtin_columns  5  nullable  boolean  false  bool
view  mz_builtin_columns  6  type  text  false  text
view  mz_builtin_columns  7  default  text  true  text
view  mz_builtin_columns  8  type_oid  oid  false  oid
view  mz_builtin_columns  9  type_mod  integer  false  int4
view  mz_builtin_views  1  oid  oid  false  oid
view  mz_builtin_views  2  schema_name  text  false  text
view  mz_builtin_views  3  name  text  false  text
view  mz_builtin_views  4  definition  text  false  text
view  mz_builtin_views  5  privileges  mz_aclitem[]  false  _mz_aclitem
view  mz_builtin_views  6  create_sql  text  false  text
source  mz_catalog_raw  1  data  jsonb  false  jsonb
view  mz_relations  1  id  text  false  text
view  mz_relations  2  oid  oid  false  oid
view  mz_relations  3  schema_id  text  false  text
view  mz_relations  4  name  text  false  text
view  mz_relations  5  type  text  false  text
view  mz_relations  6  owner_id  text  false  text
view  mz_relations  7  cluster_id  text  true  text
view  mz_relations  8  privileges  mz_aclitem[]  false  _mz_aclitem
materialized-view  mz_tables  1  id  text  false  text
materialized-view  mz_tables  2  oid  oid  false  oid
materialized-view  mz_tables  3  schema_id  text  false  text
materialized-view  mz_tables  4  name  text  false  text
materialized-view  mz_tables  5  owner_id  text  false  text
materialized-view  mz_tables  6  privileges  mz_aclitem[]  false  _mz_aclitem
materialized-view  mz_tables  7  create_sql  text  true  text
materialized-view  mz_tables  8  redacted_create_sql  text  true  text
materialized-view  mz_tables  9  source_id  text  true  text

# --- User relations: every type spelling ---------------------------------------

statement ok
CREATE TYPE record_type AS (a int, b text)

statement ok
CREATE TYPE list_type AS LIST (ELEMENT TYPE = int4)

statement ok
CREATE TYPE map_type AS MAP (KEY TYPE = text, VALUE TYPE = list_type)

statement ok
CREATE TABLE type_table (
    a int,
    b text NOT NULL,
    c numeric(10, 2) DEFAULT 1.5,
    d timestamptz DEFAULT now(),
    e varchar(20) DEFAULT 'x' || 'y',
    f char(3),
    g int4[],
    h int4 list,
    i list_type,
    j map_type,
    k record_type,
    l2 map[text => int],
    n timestamp(3),
    o interval,
    p uint2,
    q date DEFAULT date_trunc('day', now())::date,
    s text DEFAULT coalesce(NULL, 'z'),
    u int8 DEFAULT CAST(1 AS int8),
    w numeric,
    x int4range,
    y record_type list,
    z "char",
    aa bool,
    ab bytea,
    ac float4,
    ad float8,
    ae int2,
    af jsonb,
    ag oid,
    ah time,
    ai uuid,
    aj uint4,
    ak uint8,
    al mz_timestamp,
    am text[],
    an list_type list
)

statement ok
ALTER TABLE type_table ADD COLUMN v text

# For the default column, replace IDs with <id> since IDs aren't stable.
query ITTTTTI
SELECT columns.position, columns.name, columns.type, columns.nullable, regexp_replace(columns.default, '\[[su][0-9]+', '[<id>', 'g'), types.name as type_name, columns.type_mod
FROM mz_catalog.mz_columns columns
JOIN mz_catalog.mz_tables tables ON columns.id = tables.id
LEFT JOIN mz_catalog.mz_types types ON types.oid = columns.type_oid
WHERE tables.name = 'type_table'
ORDER BY columns.position
----
1  a  integer  true  NULL  int4  -1
2  b  text  false  NULL  text  -1
3  c  numeric  true  1.5  numeric  2555910
4  d  timestamp␠with␠time␠zone  true  "pg_catalog"."now"()  timestamptz  -1
5  e  character␠varying  true  'x'␠||␠'y'  varchar  24
6  f  character  true  NULL  bpchar  7
7  g  integer[]  true  NULL  _int4  -1
8  h  list  true  NULL  list  -1
9  i  list_type  true  NULL  list_type  -1
10  j  map_type  true  NULL  map_type  -1
11  k  record_type  true  NULL  record_type  -1
12  l2  map  true  NULL  map  -1
13  n  timestamp␠without␠time␠zone  true  NULL  timestamp  3
14  o  interval  true  NULL  interval  -1
15  p  uint2  true  NULL  uint2  -1
16  q  date  true  "pg_catalog"."date_trunc"('day',␠"pg_catalog"."now"())::[<id>␠AS␠"pg_catalog"."date"]  date  -1
17  s  text  true  COALESCE(NULL,␠'z')  text  -1
18  u  bigint  true  1::[<id>␠AS␠"pg_catalog"."int8"]  int8  -1
19  w  numeric  true  NULL  numeric  -1
20  x  int4range  true  NULL  int4range  -1
21  y  list  true  NULL  list  -1
22  z  "char"  true  NULL  char  -1
23  aa  boolean  true  NULL  bool  -1
24  ab  bytea  true  NULL  bytea  -1
25  ac  real  true  NULL  float4  -1
26  ad  double␠precision  true  NULL  float8  -1
