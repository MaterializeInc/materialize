# Behavioural tests for mz_catalog.mz_columns. The relation is a
# BuiltinMaterializedView over the columns each item's catalog record carries
# in mz_internal.mz_catalog_raw (planner output recorded with the item, see
# mz_catalog::durable::Item::columns) and, for builtin relations, over the
# generated mz_internal.mz_builtin_columns view: see MZ_COLUMNS in
# src/catalog/src/builtin/mz_catalog.rs.

mode cockroach

reset-server

simple conn=mz_system,user=mz_system
ALTER SYSTEM SET enable_alter_table_add_column = true
----
COMPLETE 0

# --- Schema -------------------------------------------------------------------

query TTT
SELECT c.name, c.type, c.nullable::text
FROM mz_catalog.mz_columns c
JOIN mz_catalog.mz_objects o ON c.id = o.id
JOIN mz_catalog.mz_schemas s ON o.schema_id = s.id
WHERE o.name = 'mz_columns' AND s.name = 'mz_catalog'
ORDER BY c.position
----
id  text  false
name  text  false
position  uint8  false
nullable  boolean  false
type  text  false
default  text  true
type_oid  oid  false
type_mod  integer  false

# --- Exactly the relations have rows ------------------------------------------

query T
SELECT DISTINCT o.type
FROM mz_catalog.mz_columns c
JOIN mz_catalog.mz_objects o ON o.id = c.id
ORDER BY o.type
----
materialized-view
source
table
view

# Every row belongs to a relation.
query I
SELECT count(*)
FROM mz_catalog.mz_columns c
LEFT JOIN mz_catalog.mz_relations r ON r.id = c.id
WHERE r.id IS NULL
----
0

# Positions are 1-based and contiguous within a relation, and names are unique
# within it.
query I
SELECT count(*)
FROM (
    SELECT id, count(*) AS n, min(position) AS lo, max(position) AS hi, count(DISTINCT name) AS names
    FROM mz_catalog.mz_columns
    GROUP BY id
)
WHERE lo <> 1 OR hi <> n OR names <> n
----
0

# Every column type resolves in mz_types.
query I
SELECT count(*)
FROM mz_catalog.mz_columns c
LEFT JOIN mz_catalog.mz_types t ON t.oid = c.type_oid
WHERE t.id IS NULL
----
0

# --- Builtins -----------------------------------------------------------------

# A builtin table's columns carry the NULL default that every table column has.
# No other builtin relation has defaults.
query TT
SELECT o.type, coalesce(c.default, '<null>')
FROM mz_catalog.mz_columns c
JOIN mz_catalog.mz_objects o ON o.id = c.id
WHERE c.id LIKE 's%'
GROUP BY 1, 2
ORDER BY 1, 2
----
materialized-view  <null>
source  <null>
table  NULL
view  <null>

query ITTTTII
SELECT c.position, c.name, c.type, c.nullable, c.default, c.type_oid, c.type_mod
FROM mz_catalog.mz_columns c
JOIN mz_catalog.mz_tables t ON c.id = t.id
JOIN mz_catalog.mz_schemas s ON t.schema_id = s.id
WHERE t.name = 'mz_cluster_replica_sizes' AND s.name = 'mz_catalog'
ORDER BY c.position
----
1  size  text  false  NULL  25  -1
2  processes  uint8  false  NULL  16464  -1
3  workers  uint8  false  NULL  16464  -1
4  cpu_nano_cores  uint8  false  NULL  16464  -1
5  memory_bytes  uint8  false  NULL  16464  -1
6  disk_bytes  uint8  true  NULL  16464  -1
7  credits_per_hour  numeric  false  NULL  1700  -1

# A log, a source, a materialized view, a view and the generated views that
# report the builtins, including the one that reports these columns.
query TTITTTI
SELECT o.type, o.name, c.position, c.name, c.type, c.nullable, c.type_oid
FROM mz_catalog.mz_columns c
JOIN mz_catalog.mz_objects o ON o.id = c.id
JOIN mz_catalog.mz_schemas s ON o.schema_id = s.id
WHERE
    (s.name, o.name) IN (
        ('mz_introspection', 'mz_active_peeks_per_worker'),
        ('mz_internal', 'mz_catalog_raw'),
        ('mz_catalog', 'mz_tables'),
        ('mz_catalog', 'mz_relations'),
        ('mz_internal', 'mz_builtin_columns'),
        ('mz_internal', 'mz_builtin_views')
    )
ORDER BY o.name, c.position
----
source  mz_active_peeks_per_worker  1  id  uuid  false  2950
source  mz_active_peeks_per_worker  2  worker_id  uint8  false  16464
source  mz_active_peeks_per_worker  3  object_id  text  false  25
source  mz_active_peeks_per_worker  4  type  text  false  25
