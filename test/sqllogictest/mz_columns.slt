# --- Temporary relations ------------------------------------------------------

statement ok
CREATE TEMPORARY TABLE temp_table (a int DEFAULT 5, b text NOT NULL)

statement ok
CREATE TEMPORARY VIEW temp_view AS SELECT * FROM temp_table

query TTITTTT
SELECT objects.type, objects.name, columns.position, columns.name, columns.type, columns.nullable, columns.default
FROM mz_catalog.mz_columns columns
JOIN mz_catalog.mz_objects objects ON objects.id = columns.id
WHERE objects.name IN ('temp_table', 'temp_view')
ORDER BY objects.name, columns.position
----
table  temp_table  1  a  integer  true  5
table  temp_table  2  b  text  false  NULL
view  temp_view  1  a  integer  true  NULL
view  temp_view  2  b  text  false  NULL

# --- A column named like serde_json's number token ----------------------------

# The jsonb packer reads a map whose first key is `$serde_json::private::Number`
# as a number, so `parse_catalog_create_sql` must never key JSON by a column
# name. A packing failure would stall every mz_catalog_server dataflow.

statement ok
CREATE TEMPORARY TABLE serde_number_key ("$serde_json::private::Number" int DEFAULT 5, b text DEFAULT 'x', c int)

statement ok
CREATE TEMPORARY TABLE serde_number_key_only ("$serde_json::private::Number" int DEFAULT 5)

query TITTT
SELECT tables.name, columns.position, columns.name, columns.type, columns.default
FROM mz_catalog.mz_columns columns
JOIN mz_catalog.mz_tables tables ON columns.id = tables.id
WHERE tables.name IN ('serde_number_key', 'serde_number_key_only')
ORDER BY tables.name, columns.position
----
serde_number_key  1  $serde_json::private::Number  integer  5
serde_number_key  2  b  text  'x'
serde_number_key  3  c  integer  NULL
serde_number_key_only  1  $serde_json::private::Number  integer  5

# --- A relation without columns has no rows -----------------------------------

statement ok
CREATE TABLE empty_table ()

query I
SELECT count(*)
FROM mz_catalog.mz_columns columns
JOIN mz_catalog.mz_tables tables ON columns.id = tables.id
WHERE tables.name = 'empty_table'
----
0

# --- Renaming keeps the rows, dropping retracts them -------------------------

statement ok
ALTER TABLE type_table RENAME TO type_table_renamed

query I
SELECT count(*)
FROM mz_catalog.mz_columns columns
JOIN mz_catalog.mz_tables tables ON columns.id = tables.id
WHERE tables.name = 'type_table_renamed'
----
37

statement ok
DROP TABLE type_table_renamed CASCADE

# The DROP cascades to type_view and type_mv. Their rows are retracted: a row
# that survived would have an id that no relation has anymore.
query I
SELECT count(*)
FROM mz_catalog.mz_columns columns
LEFT JOIN mz_catalog.mz_relations relations ON relations.id = columns.id
WHERE relations.id IS NULL
----
0

# The drop itself took effect
query I
SELECT count(*) FROM mz_catalog.mz_objects
WHERE name IN ('type_table_renamed', 'type_view', 'type_mv')
----
0
