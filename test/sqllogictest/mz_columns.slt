# A column of a type defined by CREATE TYPE takes the name and OID of that
# type's item.
query TTT
SELECT columns.name, columns.type, types.name
FROM mz_catalog.mz_columns columns
JOIN mz_catalog.mz_tables tables ON columns.id = tables.id
JOIN mz_catalog.mz_types types ON types.oid = columns.type_oid
WHERE tables.name = 'type_table' AND types.id LIKE 'u%'
ORDER BY columns.position
----
i  list_type  list_type
j  map_type  map_type
k  record_type  record_type

# --- Defaults are the DEFAULT clauses as stored -------------------------------

statement ok
CREATE TABLE defaults (
    c1 int DEFAULT nullif(1, 2),
    c2 bool DEFAULT 1 IN (1, 2),
    c3 bool DEFAULT 'a' LIKE 'b',
    c4 timestamptz DEFAULT CURRENT_TIMESTAMP,
    c5 numeric DEFAULT extract(year FROM now()),
    c6 text DEFAULT substring('abc' FROM 1 FOR 2),
    c7 int DEFAULT position('a' IN 'abc'),
    c8 int DEFAULT CASE WHEN true THEN 1 ELSE 2 END,
    c9 int[] DEFAULT ARRAY[1, 2],
    c10 int DEFAULT greatest(1, 2),
    c11 int DEFAULT mod(5, 2),
    c12 int DEFAULT 5 % 2,
    c13 int DEFAULT -1,
    c14 int8 DEFAULT '1'::int8 + 1,
    c15 text DEFAULT trim(BOTH 'x' FROM 'xax'),
    c16 jsonb DEFAULT '{}'::jsonb -> 'a',
    c17 interval DEFAULT INTERVAL '1 day',
    c18 date DEFAULT DATE '2020-01-01',
    c19 int DEFAULT (1 + 2) * 3,
    c20 bool DEFAULT NOT true,
    c21 bool DEFAULT 1 BETWEEN 0 AND 2,
    c22 int DEFAULT coalesce(NULL::int, 1),
    c23 int list DEFAULT LIST[1, 2],
    c24 map[text => int] DEFAULT MAP['a' => 1],
    c25 text DEFAULT lower('ABC'),
    c26 timestamptz DEFAULT now() - INTERVAL '1 hour',
    c27 bool DEFAULT 1 IS NULL,
    c28 float8 DEFAULT 1::float8 / 2,
    c29 bytea DEFAULT 'abc'::bytea,
    c31 int DEFAULT CAST('1' AS int4),
    c32 numeric(5, 2) DEFAULT 1::numeric(5, 2),
    c33 bool DEFAULT 'x' ~ 'y',
    c34 bool DEFAULT 'x' ILIKE 'y',
    c35 date DEFAULT '2020-01-01'::date,
    c36 text DEFAULT concat('a', 'b'),
    c37 int DEFAULT abs(-1),
    c38 text DEFAULT 'it''s',
    c39 uuid DEFAULT '00000000-0000-0000-0000-000000000000'::uuid,
    c40 int2 DEFAULT 1::int2,
    c41 text DEFAULT NULL,
    c42 int DEFAULT 1 + (2 - 3),
    c43 text DEFAULT CASE 1 WHEN 1 THEN 'a' END,
    c44 timestamp DEFAULT '2020-01-01 00:00:00'::timestamp,
    c45 int DEFAULT length('abc'),
    c46 text DEFAULT 'a' || 'b' || 'c',
    c47 record_type DEFAULT ROW(1, 'a')::record_type,
    c48 int DEFAULT 1 - -1
)

query TT
SELECT columns.name, regexp_replace(columns.default, '\[[su][0-9]+', '[<id>', 'g')
FROM mz_catalog.mz_columns columns
JOIN mz_catalog.mz_tables tables ON columns.id = tables.id
WHERE tables.name = 'defaults'
ORDER BY columns.position
----
c1  NULLIF(1,␠2)
c2  1␠IN␠(1,␠2)
c3  'a'␠LIKE␠'b'
c4  "current_timestamp"
c5  "pg_catalog"."extract"('year',␠"pg_catalog"."now"())
c6  "pg_catalog"."substring"('abc',␠1,␠2)
c7  "pg_catalog"."position"('a',␠'abc')
c8  CASE␠WHEN␠true␠THEN␠1␠ELSE␠2␠END
c9  ARRAY[1,␠2]
c10  GREATEST(1,␠2)
c11  "pg_catalog"."mod"(5,␠2)
c12  5␠%␠2
c13  -1
c14  '1'::[<id>␠AS␠"pg_catalog"."int8"]␠+␠1
c15  "pg_catalog"."btrim"('xax',␠'x')
c16  '{}'::[<id>␠AS␠"pg_catalog"."jsonb"]␠->␠'a'
c17  INTERVAL␠'1␠day'
c18  '2020-01-01'::[<id>␠AS␠"pg_catalog"."date"]
c19  (1␠+␠2)␠*␠3
c20  NOT␠true
c21  1␠BETWEEN␠0␠AND␠2
c22  COALESCE(NULL::[<id>␠AS␠"pg_catalog"."int4"],␠1)
c23  LIST[1,␠2]
c24  MAP['a'␠=>␠1]
c25  "pg_catalog"."lower"('ABC')
c26  "pg_catalog"."now"()␠-␠INTERVAL␠'1␠hour'
c27  1␠IS␠NULL
c28  1::[<id>␠AS␠"pg_catalog"."float8"]␠/␠2
c29  'abc'::[<id>␠AS␠"pg_catalog"."bytea"]
c31  '1'::[<id>␠AS␠"pg_catalog"."int4"]
c32  1::[<id>␠AS␠"pg_catalog"."numeric"](5,␠2)
c33  'x'␠~␠'y'
c34  'x'␠ILIKE␠'y'
c35  '2020-01-01'::[<id>␠AS␠"pg_catalog"."date"]
c36  "pg_catalog"."concat"('a',␠'b')
c37  "pg_catalog"."abs"(-1)
c38  'it''s'
c39  '00000000-0000-0000-0000-000000000000'::[<id>␠AS␠"pg_catalog"."uuid"]
c40  1::[<id>␠AS␠"pg_catalog"."int2"]
c41  NULL
c42  1␠+␠(2␠-␠3)
c43  CASE␠1␠WHEN␠1␠THEN␠'a'␠END
c44  '2020-01-01␠00:00:00'::[<id>␠AS␠"pg_catalog"."timestamp"]
c45  "pg_catalog"."length"('abc')
c46  'a'␠||␠'b'␠||␠'c'
c47  ROW(1,␠'a')::[<id>␠AS␠"materialize"."public"."record_type"]
c48  1␠-␠-1

# A column that repeats DEFAULT reports the last one, which is the one inserts apply.
statement ok
CREATE TABLE repeated_defaults (a int DEFAULT 1 DEFAULT 2, b int DEFAULT 5 DEFAULT NULL)

statement ok
INSERT INTO repeated_defaults DEFAULT VALUES

query II
SELECT * FROM repeated_defaults
----
2  NULL

query TT
SELECT columns.name, columns.default
FROM mz_catalog.mz_columns columns
JOIN mz_catalog.mz_tables tables ON columns.id = tables.id
WHERE tables.name = 'repeated_defaults'
ORDER BY columns.position
----
a  2
b  NULL

# --- Views and materialized views take the planned column names and types ----

statement ok
CREATE VIEW type_view AS
    SELECT a, b, a + 1, row(1, 'x') AS ra, list[]::list_type AS lc, k, i, j, count(*) OVER () AS cnt
    FROM type_table

statement ok
CREATE MATERIALIZED VIEW type_mv AS SELECT a, b, c FROM type_table

query TTITTTTTI
SELECT objects.type, objects.name, columns.position, columns.name, columns.type, columns.nullable, columns.default, types.name as type_name, columns.type_mod
FROM mz_catalog.mz_columns columns
JOIN mz_catalog.mz_objects objects ON objects.id = columns.id
LEFT JOIN mz_catalog.mz_types types ON types.oid = columns.type_oid
WHERE objects.name IN ('type_view', 'type_mv')
ORDER BY objects.name, columns.position
----
materialized-view  type_mv  1  a  integer  true  NULL  int4  -1
materialized-view  type_mv  2  b  text  false  NULL  text  -1
materialized-view  type_mv  3  c  numeric  true  NULL  numeric  2555910
view  type_view  1  a  integer  true  NULL  int4  -1
view  type_view  2  b  text  true  NULL  text  -1
view  type_view  3  ?column?  integer  true  NULL  int4  -1
view  type_view  4  ra  record  false  NULL  record  -1
view  type_view  5  lc  list_type  false  NULL  list_type  -1
view  type_view  6  k  record_type  true  NULL  record_type  -1
view  type_view  7  i  list_type  true  NULL  list_type  -1
view  type_view  8  j  map_type  true  NULL  map_type  -1
view  type_view  9  cnt  bigint  true  NULL  int8  -1

# --- Sources, subsources, progress, source tables and webhooks -----------------

statement ok
CREATE SOURCE auction_source IN CLUSTER quickstart FROM LOAD GENERATOR AUCTION FOR ALL TABLES

statement ok
CREATE TABLE auction_bids_table FROM SOURCE auction_source (REFERENCE bids)

statement ok
CREATE SOURCE webhook_source IN CLUSTER quickstart FROM WEBHOOK BODY FORMAT JSON INCLUDE HEADERS

query TTITTTTT
SELECT objects.type, objects.name, columns.position, columns.name, columns.type, columns.nullable, columns.default, types.name as type_name
FROM mz_catalog.mz_columns columns
JOIN mz_catalog.mz_objects objects ON objects.id = columns.id
LEFT JOIN mz_catalog.mz_types types ON types.oid = columns.type_oid
WHERE objects.name IN ('auction_source', 'auction_source_progress', 'bids', 'auction_bids_table', 'webhook_source')
ORDER BY objects.name, columns.position
