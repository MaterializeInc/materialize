statement ok
CREATE TEMPORARY TABLE tmp (a int DEFAULT 5, b text NOT NULL)

statement ok
CREATE TEMPORARY VIEW tv AS SELECT * FROM tmp

query TTITTTT
SELECT o.type, o.name, c.position, c.name, c.type, c.nullable, c.default
FROM mz_catalog.mz_columns c
JOIN mz_catalog.mz_objects o ON o.id = c.id
WHERE o.name IN ('tmp', 'tv')
ORDER BY o.name, c.position
----
table  tmp  1  a  integer  true  5
table  tmp  2  b  text  false  NULL
view  tv  1  a  integer  true  NULL
view  tv  2  b  text  false  NULL

# --- A relation without columns has no rows -----------------------------------

statement ok
CREATE TABLE empty ()

query I
SELECT count(*)
FROM mz_catalog.mz_columns c
JOIN mz_catalog.mz_tables t ON c.id = t.id
WHERE t.name = 'empty'
----
0

# --- Renaming keeps the rows, dropping retracts them -------------------------

statement ok
ALTER TABLE t RENAME TO t2

query I
SELECT count(*)
FROM mz_catalog.mz_columns c
JOIN mz_catalog.mz_tables t ON c.id = t.id
WHERE t.name = 't2'
----
37

statement ok
DROP TABLE t2 CASCADE

query T
SELECT DISTINCT o.name
FROM mz_catalog.mz_columns c
JOIN mz_catalog.mz_objects o ON o.id = c.id
WHERE o.id LIKE 'u%'
ORDER BY o.name
----
accounts
auctions
bids
defaults
lg_bids
lg_progress
organizations
tmp
tv
users
wh
