# A column of a type defined by CREATE TYPE takes the name and OID of that
# type's item.
query TTT
SELECT c.name, c.type, ty.name
FROM mz_catalog.mz_columns c
JOIN mz_catalog.mz_tables t ON c.id = t.id
JOIN mz_catalog.mz_types ty ON ty.oid = c.type_oid
WHERE t.name = 't' AND ty.id LIKE 'u%'
ORDER BY c.position
----
i  l  l
j  m  m
k  r  r

# --- Defaults are the DEFAULT clauses as stored -------------------------------

statement ok
CREATE TABLE defaults (
    c1 int DEFAULT nullif(1, 2),
    c2 bool DEFAULT 1 IN (1, 2),
    c3 bool DEFAULT 'a' LIKE 'b',
    c4 timestamptz DEFAULT CURRENT_TIMESTAMP,
    c5 numeric DEFAULT extract(year FROM now()),
    c6 text DEFAULT substring('abc' FROM 1 FOR 2),
    c7 int DEFAULT position('a' IN 'abc'),
    c8 int DEFAULT CASE WHEN true THEN 1 ELSE 2 END,
    c9 int[] DEFAULT ARRAY[1, 2],
    c10 int DEFAULT greatest(1, 2),
    c11 int DEFAULT mod(5, 2),
    c12 int DEFAULT 5 % 2,
    c13 int DEFAULT -1,
    c14 int8 DEFAULT '1'::int8 + 1,
    c15 text DEFAULT trim(BOTH 'x' FROM 'xax'),
    c16 jsonb DEFAULT '{}'::jsonb -> 'a',
    c17 interval DEFAULT INTERVAL '1 day',
    c18 date DEFAULT DATE '2020-01-01',
    c19 int DEFAULT (1 + 2) * 3,
    c20 bool DEFAULT NOT true,
    c21 bool DEFAULT 1 BETWEEN 0 AND 2,
    c22 int DEFAULT coalesce(NULL::int, 1),
    c23 int list DEFAULT LIST[1, 2],
    c24 map[text => int] DEFAULT MAP['a' => 1],
    c25 text DEFAULT lower('ABC'),
    c26 timestamptz DEFAULT now() - INTERVAL '1 hour',
    c27 bool DEFAULT 1 IS NULL,
    c28 float8 DEFAULT 1::float8 / 2,
    c29 bytea DEFAULT 'abc'::bytea,
    c31 int DEFAULT CAST('1' AS int4),
    c32 numeric(5, 2) DEFAULT 1::numeric(5, 2),
    c33 bool DEFAULT 'x' ~ 'y',
    c34 bool DEFAULT 'x' ILIKE 'y',
    c35 date DEFAULT '2020-01-01'::date,
    c36 text DEFAULT concat('a', 'b'),
    c37 int DEFAULT abs(-1),
    c38 text DEFAULT 'it''s',
    c39 uuid DEFAULT '00000000-0000-0000-0000-000000000000'::uuid,
    c40 int2 DEFAULT 1::int2,
    c41 text DEFAULT NULL,
    c42 int DEFAULT 1 + (2 - 3),
    c43 text DEFAULT CASE 1 WHEN 1 THEN 'a' END,
    c44 timestamp DEFAULT '2020-01-01 00:00:00'::timestamp,
    c45 int DEFAULT length('abc'),
    c46 text DEFAULT 'a' || 'b' || 'c',
    c47 r DEFAULT ROW(1, 'a')::r,
    c48 int DEFAULT 1 - -1
)

query TT
SELECT c.name, c.default
FROM mz_catalog.mz_columns c
JOIN mz_catalog.mz_tables t ON c.id = t.id
WHERE t.name = 'defaults'
ORDER BY c.position
----
c1  NULLIF(1,␠2)
c2  1␠IN␠(1,␠2)
c3  'a'␠LIKE␠'b'
c4  [s157␠AS␠"pg_catalog"."current_timestamp"]()
c5  "pg_catalog"."extract"('year',␠"pg_catalog"."now"())
c6  "pg_catalog"."substring"('abc',␠1,␠2)
c7  "pg_catalog"."position"('a',␠'abc')
c8  CASE␠WHEN␠true␠THEN␠1␠ELSE␠2␠END
c9  ARRAY[1,␠2]
c10  GREATEST(1,␠2)
c11  5␠%␠2
c12  5␠%␠2
c13  -1
c14  '1'::[s22␠AS␠"pg_catalog"."int8"]␠+␠1
c15  "pg_catalog"."btrim"('xax',␠'x')
c16  '{}'::[s26␠AS␠"pg_catalog"."jsonb"]␠->␠'a'
c17  INTERVAL␠'1␠day'
c18  '2020-01-01'::[s14␠AS␠"pg_catalog"."date"]
c19  (1␠+␠2)␠*␠3
c20  NOT␠true
c21  1␠>=␠0␠AND␠1␠<=␠2
c22  COALESCE(NULL::[s20␠AS␠"pg_catalog"."int4"],␠1)
c23  LIST[1,␠2]
c24  MAP['a'␠=>␠1]
c25  "pg_catalog"."lower"('ABC')
c26  "pg_catalog"."now"()␠-␠INTERVAL␠'1␠hour'
c27  1␠IS␠NULL
c28  1::[s18␠AS␠"pg_catalog"."float8"]␠/␠2
c29  'abc'::[s8␠AS␠"pg_catalog"."bytea"]
c31  '1'::[s20␠AS␠"pg_catalog"."int4"]
c32  1::[s32␠AS␠"pg_catalog"."numeric"](5,␠2)
c33  'x'␠~␠'y'
c34  'x'␠ILIKE␠'y'
c35  '2020-01-01'::[s14␠AS␠"pg_catalog"."date"]
c36  "pg_catalog"."concat"('a',␠'b')
c37  "pg_catalog"."abs"(-1)
c38  'it''s'
c39  '00000000-0000-0000-0000-000000000000'::[s54␠AS␠"pg_catalog"."uuid"]
c40  1::[s44␠AS␠"pg_catalog"."int2"]
c41  NULL
c42  1␠+␠(2␠-␠3)
c43  CASE␠1␠WHEN␠1␠THEN␠'a'␠END
c44  '2020-01-01␠00:00:00'::[s50␠AS␠"pg_catalog"."timestamp"]
c45  "pg_catalog"."length"('abc')
c46  'a'␠||␠'b'␠||␠'c'
c47  ROW(1,␠'a')::[u1␠AS␠"materialize"."public"."r"]
c48  1␠-␠-1

# The defaults are stored in the form planning transforms them to, so the
# stored create_sql spells `mod` and `BETWEEN` the way the rows above do.
# Catalog ids are not stable across builds, so they are masked.
query T multiline
SELECT regexp_replace(create_sql, '\[[su][0-9]+', '[<id>', 'g')
FROM mz_catalog.mz_tables
WHERE name = 'defaults'
----
CREATE TABLE "materialize"."public"."defaults" ("c1" [<id> AS "pg_catalog"."int4"] DEFAULT NULLIF(1, 2), "c2" [<id> AS "pg_catalog"."bool"] DEFAULT 1 IN (1, 2), "c3" [<id> AS "pg_catalog"."bool"] DEFAULT 'a' LIKE 'b', "c4" [<id> AS "pg_catalog"."timestamptz"] DEFAULT [<id> AS "pg_catalog"."current_timestamp"](), "c5" [<id> AS "pg_catalog"."numeric"] DEFAULT "pg_catalog"."extract"('year', "pg_catalog"."now"()), "c6" [<id> AS "pg_catalog"."text"] DEFAULT "pg_catalog"."substring"('abc', 1, 2), "c7" [<id> AS "pg_catalog"."int4"] DEFAULT "pg_catalog"."position"('a', 'abc'), "c8" [<id> AS "pg_catalog"."int4"] DEFAULT CASE WHEN true THEN 1 ELSE 2 END, "c9" [<id> AS "pg_catalog"."_int4"] DEFAULT ARRAY[1, 2], "c10" [<id> AS "pg_catalog"."int4"] DEFAULT GREATEST(1, 2), "c11" [<id> AS "pg_catalog"."int4"] DEFAULT 5 % 2, "c12" [<id> AS "pg_catalog"."int4"] DEFAULT 5 % 2, "c13" [<id> AS "pg_catalog"."int4"] DEFAULT -1, "c14" [<id> AS "pg_catalog"."int8"] DEFAULT '1'::[<id> AS "pg_catalog"."int8"] + 1, "c15" [<id> AS "pg_catalog"."text"] DEFAULT "pg_catalog"."btrim"('xax', 'x'), "c16" [<id> AS "pg_catalog"."jsonb"] DEFAULT '{}'::[<id> AS "pg_catalog"."jsonb"] -> 'a', "c17" [<id> AS "pg_catalog"."interval"] DEFAULT INTERVAL '1 day', "c18" [<id> AS "pg_catalog"."date"] DEFAULT '2020-01-01'::[<id> AS "pg_catalog"."date"], "c19" [<id> AS "pg_catalog"."int4"] DEFAULT (1 + 2) * 3, "c20" [<id> AS "pg_catalog"."bool"] DEFAULT NOT true, "c21" [<id> AS "pg_catalog"."bool"] DEFAULT 1 >= 0 AND 1 <= 2, "c22" [<id> AS "pg_catalog"."int4"] DEFAULT COALESCE(NULL::[<id> AS "pg_catalog"."int4"], 1), "c23" [<id> AS "pg_catalog"."int4"] list DEFAULT LIST[1, 2], "c24" map[[<id> AS "pg_catalog"."text"]=>[<id> AS "pg_catalog"."int4"]] DEFAULT MAP['a' => 1], "c25" [<id> AS "pg_catalog"."text"] DEFAULT "pg_catalog"."lower"('ABC'), "c26" [<id> AS "pg_catalog"."timestamptz"] DEFAULT "pg_catalog"."now"() - INTERVAL '1 hour', "c27" [<id> AS "pg_catalog"."bool"] DEFAULT 1 IS NULL, "c28" [<id> AS "pg_catalog"."float8"] DEFAULT 1::[<id> AS "pg_catalog"."float8"] / 2, "c29" [<id> AS "pg_catalog"."bytea"] DEFAULT 'abc'::[<id> AS "pg_catalog"."bytea"], "c31" [<id> AS "pg_catalog"."int4"] DEFAULT '1'::[<id> AS "pg_catalog"."int4"], "c32" [<id> AS "pg_catalog"."numeric"](5, 2) DEFAULT 1::[<id> AS "pg_catalog"."numeric"](5, 2), "c33" [<id> AS "pg_catalog"."bool"] DEFAULT 'x' ~ 'y', "c34" [<id> AS "pg_catalog"."bool"] DEFAULT 'x' ILIKE 'y', "c35" [<id> AS "pg_catalog"."date"] DEFAULT '2020-01-01'::[<id> AS "pg_catalog"."date"], "c36" [<id> AS "pg_catalog"."text"] DEFAULT "pg_catalog"."concat"('a', 'b'), "c37" [<id> AS "pg_catalog"."int4"] DEFAULT "pg_catalog"."abs"(-1), "c38" [<id> AS "pg_catalog"."text"] DEFAULT 'it''s', "c39" [<id> AS "pg_catalog"."uuid"] DEFAULT '00000000-0000-0000-0000-000000000000'::[<id> AS "pg_catalog"."uuid"], "c40" [<id> AS "pg_catalog"."int2"] DEFAULT 1::[<id> AS "pg_catalog"."int2"], "c41" [<id> AS "pg_catalog"."text"] DEFAULT NULL, "c42" [<id> AS "pg_catalog"."int4"] DEFAULT 1 + (2 - 3), "c43" [<id> AS "pg_catalog"."text"] DEFAULT CASE 1 WHEN 1 THEN 'a' END, "c44" [<id> AS "pg_catalog"."timestamp"] DEFAULT '2020-01-01 00:00:00'::[<id> AS "pg_catalog"."timestamp"], "c45" [<id> AS "pg_catalog"."int4"] DEFAULT "pg_catalog"."length"('abc'), "c46" [<id> AS "pg_catalog"."text"] DEFAULT 'a' || 'b' || 'c', "c47" [<id> AS "materialize"."public"."r"] DEFAULT ROW(1, 'a')::[<id> AS "materialize"."public"."r"], "c48" [<id> AS "pg_catalog"."int4"] DEFAULT 1 - -1)
EOF

# --- Views and materialized views take the planned column names and types ----

statement ok
CREATE VIEW v AS
    SELECT a, b, a + 1, row(1, 'x') AS ra, list[]::l AS lc, k, i, j, count(*) OVER () AS cnt
    FROM t

statement ok
CREATE MATERIALIZED VIEW mv AS SELECT a, b, c FROM t

query TTITTTTII
SELECT o.type, o.name, c.position, c.name, c.type, c.nullable, c.default, c.type_oid, c.type_mod
FROM mz_catalog.mz_columns c
JOIN mz_catalog.mz_objects o ON o.id = c.id
WHERE o.name IN ('v', 'mv')
ORDER BY o.name, c.position
----
