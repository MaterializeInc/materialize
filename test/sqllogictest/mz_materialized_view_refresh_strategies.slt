# Behavioural tests for mz_internal.mz_materialized_view_refresh_strategies.
# The relation is a BuiltinMaterializedView over the REFRESH options of each
# materialized view's create_sql in mz_internal.mz_catalog_raw: see
# MZ_MATERIALIZED_VIEW_REFRESH_STRATEGIES in
# src/catalog/src/builtin/mz_internal.rs. The refresh behaviour itself is
# covered by test/testdrive/materialized-view-refresh-options.td.

mode cockroach

reset-server

simple conn=mz_system,user=mz_system
ALTER SYSTEM SET enable_refresh_every_mvs = true
----
COMPLETE 0

# --- Schema -------------------------------------------------------------------

query TTT
SELECT c.name, c.type, c.nullable::text
FROM mz_catalog.mz_columns c
JOIN mz_catalog.mz_objects o ON c.id = o.id
JOIN mz_catalog.mz_schemas s ON o.schema_id = s.id
WHERE o.name = 'mz_materialized_view_refresh_strategies' AND s.name = 'mz_internal'
ORDER BY c.position
----
materialized_view_id  text  false
type  text  false
interval  interval  true
aligned_to  timestamp␠with␠time␠zone  true
at  timestamp␠with␠time␠zone  true

# --- Every materialized view has a row, and only materialized views do --------

query I
SELECT count(*)
FROM mz_catalog.mz_materialized_views mv
FULL OUTER JOIN mz_internal.mz_materialized_view_refresh_strategies s
    ON s.materialized_view_id = mv.id
WHERE mv.id IS NULL OR s.materialized_view_id IS NULL
----
0

# Builtin materialized views refresh on commit.
query TTTT
SELECT DISTINCT type, interval::text, aligned_to::text, at::text
FROM mz_internal.mz_materialized_view_refresh_strategies
WHERE materialized_view_id LIKE 's%'
----
on-commit  NULL  NULL  NULL

# --- One row per REFRESH option -----------------------------------------------

statement ok
CREATE TABLE t (a int)

statement ok
CREATE MATERIALIZED VIEW mv_default AS SELECT a FROM t

statement ok
CREATE MATERIALIZED VIEW mv_on_commit WITH (REFRESH ON COMMIT) AS SELECT a FROM t

statement ok
CREATE MATERIALIZED VIEW mv_at WITH (REFRESH AT '2999-12-31 23:59:00+00') AS SELECT a FROM t

statement ok
CREATE MATERIALIZED VIEW mv_every
    WITH (REFRESH EVERY '1 day' ALIGNED TO '2000-01-01 00:00:00+00')
    AS SELECT a FROM t

# Several options on one view, with times given as expressions.
statement ok
CREATE MATERIALIZED VIEW mv_many
    WITH (
        REFRESH AT '2999-01-01 00:00:00+00',
        REFRESH AT TIMESTAMPTZ '2999-06-01 00:00:00+00' + INTERVAL '12 hours 30 minutes',
        REFRESH EVERY '90 minutes' ALIGNED TO TIMESTAMPTZ '2000-01-01 00:00:00+00' + INTERVAL '1 hour'
    )
    AS SELECT a FROM t

query TTTTT
SELECT mv.name, s.type, s.interval::text, s.aligned_to::text, s.at::text
FROM mz_internal.mz_materialized_view_refresh_strategies s
JOIN mz_catalog.mz_materialized_views mv ON mv.id = s.materialized_view_id
WHERE mv.id LIKE 'u%'
ORDER BY mv.name, s.type, s.at
----
mv_at  at  NULL  NULL  2999-12-31␠23:59:00+00
mv_default  on-commit  NULL  NULL  NULL
mv_every  every  24:00:00  2000-01-01␠00:00:00+00  NULL
mv_many  at  NULL  NULL  2999-01-01␠00:00:00+00
mv_many  at  NULL  NULL  2999-06-01␠12:30:00+00
mv_many  every  01:30:00  2000-01-01␠01:00:00+00  NULL
mv_on_commit  on-commit  NULL  NULL  NULL

# --- The times are stored folded to mz_timestamp literals ---------------------

# That fold is what lets the view read them back. Catalog ids are not stable
# across builds and the AS OF is the wall clock at creation, so both are masked.
query T
SELECT regexp_replace(regexp_replace(create_sql, '\[[su][0-9]+', '[<id>', 'g'), 'AS OF [0-9]+', 'AS OF <ts>')
FROM mz_catalog.mz_materialized_views
WHERE name = 'mv_many'
----
CREATE MATERIALIZED VIEW "materialize"."public"."mv_many" IN CLUSTER [<id>] WITH (REFRESH = AT 32472144000000::[<id> AS "mz_catalog"."mz_timestamp"], REFRESH = AT 32485235400000::[<id> AS "mz_catalog"."mz_timestamp"], REFRESH = EVERY '90 minutes' ALIGNED TO 946688400000::[<id> AS "mz_catalog"."mz_timestamp"]) AS SELECT "a" FROM [<id> AS "materialize"."public"."t"] AS OF <ts>

# --- Retraction ---------------------------------------------------------------

statement ok
DROP MATERIALIZED VIEW mv_many

query T
SELECT mv.name
FROM mz_internal.mz_materialized_view_refresh_strategies s
JOIN mz_catalog.mz_materialized_views mv ON mv.id = s.materialized_view_id
WHERE mv.id LIKE 'u%'
ORDER BY mv.name
----
mv_at
mv_default
mv_every
mv_on_commit
