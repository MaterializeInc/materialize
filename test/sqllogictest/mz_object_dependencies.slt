# Behavioural tests for mz_internal.mz_object_dependencies.

mode cockroach

reset-server

# All user objects live in a scratch schema owned by the test role, so the
# cascade at the end of the file can clean up everything in one statement.
# The public schema is owned by mz_system, so it cannot play that role.
statement ok
CREATE SCHEMA deps

statement ok
SET search_path = deps

statement ok
CREATE TABLE t (a int, b text NOT NULL)

statement ok
CREATE VIEW v AS SELECT pg_catalog.abs(a), b::text FROM t WHERE a > 42

# --- relation and function edges from user items ------------------------------

# v depends on t (relation reference, stored as an id in create_sql).
query T
SELECT count(*)
FROM mz_internal.mz_object_dependencies
WHERE object_id = (SELECT id FROM mz_views WHERE name = 'v')
  AND referenced_object_id = (SELECT id FROM mz_tables WHERE name = 't')
----
1

# v depends on pg_catalog.abs. Function references print as plain names in
# stored SQL and are recovered by name from the GidMapping rows.
query T
SELECT count(*)
FROM mz_internal.mz_object_dependencies
WHERE object_id = (SELECT id FROM mz_views WHERE name = 'v')
  AND referenced_object_id IN (SELECT id FROM mz_functions WHERE name = 'abs')
----
1

# v depends on the type named in its definition (text from the cast), which
# prints as an id reference in stored SQL.
query T rowsort
SELECT ty.name
FROM mz_internal.mz_object_dependencies dep
JOIN mz_types ty ON ty.id = dep.referenced_object_id
WHERE dep.object_id = (SELECT id FROM mz_views WHERE name = 'v')
----
text

# t depends on its column types.
query T rowsort
SELECT ty.name
FROM mz_internal.mz_object_dependencies dep
JOIN mz_types ty ON ty.id = dep.referenced_object_id
WHERE dep.object_id = (SELECT id FROM mz_tables WHERE name = 't')
----
int4
text

# --- array types ---------------------------------------------------------------

statement ok
CREATE TABLE arr (a int4[])

# int4[] yields an edge to the array type _int4 and none to the element type
# int4, the same set a direct reference to _int4 produces. Name resolution
# treats both spellings as referencing the array type alone.
query T rowsort
SELECT ty.name
FROM mz_internal.mz_object_dependencies dep
JOIN mz_types ty ON ty.id = dep.referenced_object_id
WHERE dep.object_id = (SELECT id FROM mz_tables WHERE name = 'arr')
----
_int4

# --- connection and secret edges ------------------------------------------------

statement ok
CREATE SECRET pw AS 'hunter2'

statement ok
CREATE CONNECTION kc TO KAFKA (BROKER 'kafka:9092', SASL MECHANISMS 'PLAIN', SASL USERNAME 'u', SASL PASSWORD = SECRET pw) WITH (VALIDATE = false)

query T
SELECT count(*)
FROM mz_internal.mz_object_dependencies
WHERE object_id = (SELECT id FROM mz_connections WHERE name = 'kc')
  AND referenced_object_id = (SELECT id FROM mz_secrets WHERE name = 'pw')
----
1

# --- temporary items are excluded ----------------------------------------------

statement ok
CREATE TEMPORARY VIEW tv AS SELECT * FROM t

query T
SELECT count(*)
FROM mz_internal.mz_object_dependencies
WHERE object_id = (SELECT id FROM mz_views WHERE name = 'tv')
----
0

# --- materialized view edges -----------------------------------------------------

statement ok
CREATE MATERIALIZED VIEW umv AS SELECT a + 1 AS a1 FROM t

query T
SELECT count(*)
FROM mz_internal.mz_object_dependencies
WHERE object_id = (SELECT id FROM mz_materialized_views WHERE name = 'umv')
  AND referenced_object_id = (SELECT id FROM mz_tables WHERE name = 't')
----
1

# --- index edges -------------------------------------------------------------------

statement ok
CREATE INDEX fidx ON t (abs(a))

# The index depends on the relation it indexes and on the function its key
# calls.
query T
SELECT count(*)
FROM mz_internal.mz_object_dependencies
WHERE object_id = (SELECT id FROM mz_indexes WHERE name = 'fidx')
  AND referenced_object_id = (SELECT id FROM mz_tables WHERE name = 't')
----
1

query T
SELECT count(*)
FROM mz_internal.mz_object_dependencies
WHERE object_id = (SELECT id FROM mz_indexes WHERE name = 'fidx')
  AND referenced_object_id IN (SELECT id FROM mz_functions WHERE name = 'abs')
----
1

# --- custom types ------------------------------------------------------------------

statement ok
CREATE TYPE custom_list AS LIST (ELEMENT TYPE = int4)

# A custom type depends on its element type: a type -> type edge.
query T
SELECT count(*)
FROM mz_internal.mz_object_dependencies
WHERE object_id = (SELECT id FROM mz_types WHERE name = 'custom_list')
  AND referenced_object_id = (SELECT id FROM mz_types WHERE name = 'int4')
----
1

# --- tables from sources -------------------------------------------------------------

statement ok
CREATE SOURCE lg FROM LOAD GENERATOR COUNTER

statement ok
CREATE TABLE lg_tbl FROM SOURCE lg (REFERENCE counter)

# The table's create_sql references its source by id outside any query.
query T
SELECT count(*)
FROM mz_internal.mz_object_dependencies
WHERE object_id = (SELECT id FROM mz_tables WHERE name = 'lg_tbl')
  AND referenced_object_id = (SELECT id FROM mz_sources WHERE name = 'lg')
----
1

# --- builtin edges ---------------------------------------------------------------

# mz_catalog.mz_indexes is itself a materialized view over mz_catalog_raw.
# Its edge comes from the VALUES inlined at generation time, joined to
# GidMapping rows at query time.
query T
SELECT count(*)
FROM mz_internal.mz_object_dependencies dep
JOIN mz_objects o ON o.id = dep.object_id
JOIN mz_schemas os ON os.id = o.schema_id
JOIN mz_objects r ON r.id = dep.referenced_object_id
JOIN mz_schemas rs ON rs.id = r.schema_id
WHERE os.name = 'mz_catalog' AND o.name = 'mz_indexes'
  AND rs.name = 'mz_internal' AND r.name = 'mz_catalog_raw'
----
1

# Builtin views also depend on the functions they call, recorded by name at
# generation time. mz_catalog.mz_indexes calls mz_internal.parse_catalog_id.
query T
SELECT count(*) > 0
FROM mz_internal.mz_object_dependencies dep
JOIN mz_objects o ON o.id = dep.object_id
JOIN mz_schemas os ON os.id = o.schema_id
WHERE os.name = 'mz_catalog' AND o.name = 'mz_indexes'
  AND dep.referenced_object_id IN (SELECT id FROM mz_functions WHERE name = 'parse_catalog_id')
----
true

# Introspection source indexes depend on their log.
query T
SELECT count(*) > 0 FROM mz_internal.mz_object_dependencies WHERE object_id LIKE 'si%'
----
true

# The relation itself must be reported as a materialized view.
query T
SELECT count(*) FROM mz_materialized_views WHERE name = 'mz_object_dependencies'
----
1

query T
SELECT count(*) FROM mz_internal.mz_ontology_entity_types WHERE name = 'object_dependency'
----
1

# The generating view carries its own outgoing edges.
query T
SELECT count(*)
FROM mz_internal.mz_object_dependencies dep
JOIN mz_objects o ON o.id = dep.object_id
JOIN mz_schemas os ON os.id = o.schema_id
JOIN mz_objects r ON r.id = dep.referenced_object_id
JOIN mz_schemas rs ON rs.id = r.schema_id
WHERE os.name = 'mz_internal' AND o.name = 'mz_object_dependencies_raw'
  AND rs.name = 'mz_internal' AND r.name = 'mz_catalog_raw'
----
1

query T
SELECT count(*) > 0
FROM mz_internal.mz_object_dependencies dep
JOIN mz_objects o ON o.id = dep.object_id
JOIN mz_schemas os ON os.id = o.schema_id
WHERE os.name = 'mz_internal' AND o.name = 'mz_object_dependencies_raw'
  AND dep.referenced_object_id IN (
      SELECT id FROM mz_functions WHERE name = 'parse_catalog_item_references'
  )
----
true

# mz_object_dependencies reads mz_object_dependencies_raw, so the edge between
# the two is recorded like any other.
query T
SELECT count(*)
FROM mz_internal.mz_object_dependencies dep
JOIN mz_objects o ON o.id = dep.object_id
JOIN mz_schemas os ON os.id = o.schema_id
JOIN mz_objects r ON r.id = dep.referenced_object_id
JOIN mz_schemas rs ON rs.id = r.schema_id
WHERE os.name = 'mz_internal' AND o.name = 'mz_object_dependencies'
  AND rs.name = 'mz_internal' AND r.name = 'mz_object_dependencies_raw'
----
1

# --- dropped items leave no edges --------------------------------------------------

statement ok
CREATE VIEW dropme AS SELECT a FROM t

query T
SELECT count(*) > 0
FROM mz_internal.mz_object_dependencies
WHERE object_id = (SELECT id FROM mz_views WHERE name = 'dropme')
----
true

statement ok
DROP VIEW dropme

# --- structural invariants -------------------------------------------------------

# No duplicate edges: ResolvedIds was a map, so the packed table never
# produced duplicates, and consumers (e.g. transitive closures) assume this.
query T
SELECT count(*) FROM (
    SELECT object_id, referenced_object_id
    FROM mz_internal.mz_object_dependencies
    GROUP BY object_id, referenced_object_id
    HAVING count(*) > 1
)
----
0

# No self-edges.
query T
SELECT count(*) FROM mz_internal.mz_object_dependencies WHERE object_id = referenced_object_id
----
0

# No edge outlives its object: cascading away the whole scratch schema drops
# every user object created above, so any user edge still present is a leak.
statement ok
DROP SCHEMA deps CASCADE

query T
SELECT count(*)
FROM mz_internal.mz_object_dependencies
WHERE object_id LIKE 'u%' OR referenced_object_id LIKE 'u%'
----
0
