# Behavioural tests for mz_internal.mz_replacements.

mode cockroach

reset-server

simple conn=mz_system,user=mz_system
ALTER SYSTEM SET enable_replacement_materialized_views = true
----
COMPLETE 0

# Assert the relation is empty on a fresh env.
query I
SELECT count(*) FROM mz_internal.mz_replacements
----
0

# Create a replacement materialized view and assert the mapping exists.
statement ok
CREATE TABLE t (a int)

statement ok
CREATE MATERIALIZED VIEW mv AS SELECT a FROM t

statement ok
CREATE MATERIALIZED VIEW non_replacement_mv AS SELECT a FROM t

statement ok
CREATE REPLACEMENT MATERIALIZED VIEW replacement_mv FOR mv AS SELECT a + 1 AS a FROM t

query TT
SELECT r_mv.name, t_mv.name
FROM mz_internal.mz_replacements r
JOIN mz_catalog.mz_materialized_views r_mv ON r_mv.id = r.id
JOIN mz_catalog.mz_materialized_views t_mv ON t_mv.id = r.target_id
----
replacement_mv  mv

# Applying the replacement removes it from mz_replacements.

statement ok
ALTER MATERIALIZED VIEW mv APPLY REPLACEMENT replacement_mv

query I
SELECT count(*) FROM mz_internal.mz_replacements
----
0

query I
SELECT count(*) FROM mz_catalog.mz_materialized_views WHERE name IN ('mv', 'non_replacement_mv')
----
2

# Dropping a pending replacement removes it from mz_replacements.

statement ok
CREATE REPLACEMENT MATERIALIZED VIEW replacement_mv2 FOR mv AS SELECT a + 2 AS a FROM t

query TT
SELECT r_mv.name, t_mv.name
FROM mz_internal.mz_replacements r
JOIN mz_catalog.mz_materialized_views r_mv ON r_mv.id = r.id
JOIN mz_catalog.mz_materialized_views t_mv ON t_mv.id = r.target_id
----
replacement_mv2  mv

statement ok
DROP MATERIALIZED VIEW replacement_mv2

query I
SELECT count(*) FROM mz_internal.mz_replacements
----
0
