# For more prepared statement tests, see `order_by.slt` and `test_bind_params`.

statement ok
CREATE TABLE t (a int);

# INSERT
statement ok
PREPARE i1 AS
INSERT INTO t(a) VALUES($1);

statement ok
EXECUTE i1(5);

query I
SELECT * FROM t;
----
5

# INSERT ... RETURNING
statement ok
PREPARE i2 AS
INSERT INTO t(a) VALUES($1 - 1) RETURNING $1 + 1;

query I
EXECUTE i2(7);
----
8

query I
SELECT * FROM t;
----
5
6

query error operator is not unique: unknown \+ unknown
PREPARE i3 AS
INSERT INTO t(a) VALUES(4) RETURNING $1 + $1;

statement ok
PREPARE i3 AS
INSERT INTO t(a) VALUES(4) RETURNING $1;

query T
EXECUTE i3('x');
----
x

query I valuesort
SELECT * FROM t;
----
4
5
6

statement ok
PREPARE p1 AS
SELECT $1 + $1::bigint;

query I
EXECUTE p1(5);
----
10

statement ok
PREPARE p2 AS
SELECT $1::bigint + $1::bigint;

query I
EXECUTE p2(7);
----
14

statement ok
PREPARE p3 AS
SELECT $1 || $1;

query T
EXECUTE p3('abc');
----
abcabc

statement ok
PREPARE p4 AS
SELECT $1::text || $1::bigint::text;

query error invalid input syntax for type bigint: invalid digit found in string: "abc"
EXECUTE p4('abc');

query T
EXECUTE p4('123');
----
123123

statement ok
PREPARE p5 AS
SELECT $1, $1::bigint;

query II
EXECUTE p5(7);
----
0
7

query error operator does not exist: bigint \|\| bigint
PREPARE p6 AS
SELECT $1 + $1::bigint, $1 || $1;

query error operator does not exist: text \+ bigint
PREPARE p7 AS
SELECT $1 || $1, $1 + $1::bigint;

query error there are contradicting constraints for the type of parameter \$1: should be both text and integer
PREPARE p AS SELECT repeat($1, $1);

# A quoted name is stored and looked up without its quotes, so SQL and an
# extended-protocol `Parse` can name the same statement.
statement error prepared statement "Nope" does not exist
DEALLOCATE "Nope"

statement error unknown prepared statement "Nope"
EXECUTE "Nope"

statement ok
PREPARE "Mixed" AS SELECT 1;

query I
EXECUTE "Mixed";
----
1

# The lexer folds the unquoted spelling, which therefore names a different
# statement, exactly as in Postgres.
statement error prepared statement "mixed" does not exist
DEALLOCATE mixed

statement ok
DEALLOCATE "Mixed";

# Inference can describe record comparisons that typed execution cannot plan.
# The execution error must not prevent preparing either operand order.
statement ok
PREPARE record_param_left AS SELECT $1 = ROW(1, 2);

statement ok
PREPARE record_param_right AS SELECT ROW(1, 2) = $1;

query error operator does not exist: text = record\(f1: integer,f2: integer\)
EXECUTE record_param_left('(1,2)');

query error operator does not exist: record\(f1: integer,f2: integer\) = text
EXECUTE record_param_right('(1,2)');

query error operator does not exist: text = record\(f1: integer,f2: integer\)
EXECUTE record_param_left('(1,2,3)');

query error operator does not exist: record\(f1: integer,f2: integer\) = text
EXECUTE record_param_right('(1,2,3)');

mode cockroach

statement ok
CREATE TABLE prepared_values (id int, value int);

statement ok
INSERT INTO prepared_values VALUES (1, 11), (2, 22), (3, 33);

statement ok
CREATE INDEX prepared_values_id ON prepared_values (id);

statement ok
PREPARE prepared_conditional AS
SELECT CASE WHEN $2 THEN value ELSE 1 / $3 END
FROM prepared_values WHERE id = $1;

query I
EXECUTE prepared_conditional(1, true, 0);
----
11

query I
EXECUTE prepared_conditional(2, false, 2);
----
0

query error division by zero
EXECUTE prepared_conditional(1, false, 0);

query I
EXECUTE prepared_conditional(3, true, 0);
----
33

statement ok
PREPARE prepared_finishing AS
SELECT value FROM prepared_values WHERE id >= $1 ORDER BY value LIMIT $2 OFFSET $3;

query I
EXECUTE prepared_finishing(1, 1, 1);
----
22

query error unable to cast given parameter \$2: expected bigint, got text
EXECUTE prepared_finishing(2, NULL, 0);

query I
EXECUTE prepared_finishing(2, NULL::bigint, 0);
----
22
33

query I
EXECUTE prepared_finishing(1, 0, 0);
----

query I
EXECUTE prepared_finishing(NULL::int, 1, 0);
----

query error LIMIT must not be negative
EXECUTE prepared_finishing(1, -1, 0);

query I
EXECUTE prepared_finishing(1, 1, 2);
----
33

# The same prepared bodies retain their semantics on the custom-plan path.
simple conn=mz_system,user=mz_system
ALTER SYSTEM SET enable_prepared_query_templates TO false;
----
COMPLETE 0

query I
EXECUTE prepared_conditional(2, true, 0);
----
22

query error division by zero
EXECUTE prepared_conditional(1, false, 0);

query I
EXECUTE prepared_finishing(1, 1, 1);
----
22

query error LIMIT must not be negative
EXECUTE prepared_finishing(1, -1, 0);

simple conn=mz_system,user=mz_system
ALTER SYSTEM RESET enable_prepared_query_templates;
----
COMPLETE 0

# A new temporary relation changes unqualified resolution, even if the
# prepared result descriptor and the original relation are unchanged.
statement ok
PREPARE prepared_shadow AS SELECT value FROM prepared_values WHERE id = $1;

query I
EXECUTE prepared_shadow(1);
----
11

statement ok
CREATE TEMP TABLE prepared_values (id int, value int);

statement ok
INSERT INTO prepared_values VALUES (1, 101), (2, 202);

query I
EXECUTE prepared_shadow(1);
----
101

query I
EXECUTE prepared_shadow(2);
----
202

statement ok
DROP TABLE prepared_values;

query I
EXECUTE prepared_shadow(2);
----
22

statement ok
DEALLOCATE prepared_shadow;

statement ok
DEALLOCATE prepared_conditional;

statement ok
DEALLOCATE prepared_finishing;

statement ok
DROP TABLE prepared_values;
