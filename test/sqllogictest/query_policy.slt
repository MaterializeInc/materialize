mode cockroach

simple conn=mz_system,user=mz_system
ALTER SYSTEM SET enable_query_policies = true;
----
COMPLETE 0

simple conn=mz_system,user=mz_system
ALTER SYSTEM SET enable_query_policy_enforcement = true;
----
COMPLETE 0

simple conn=mz_system,user=mz_system
ALTER SYSTEM SET persist_fast_path_limit = 1000;
----
COMPLETE 0

# Creation can be delegated without granting superuser or role-management powers.
statement ok
CREATE ROLE policy_creator;

simple conn=policy_creator,user=policy_creator
CREATE QUERY POLICY delegated (RULES (r (action='reject', metric='query_plan_includes', value='storage_read')));
----
db error: ERROR: permission denied for SYSTEM
DETAIL: The 'policy_creator' role needs CREATEQUERYPOLICY privileges on SYSTEM

simple conn=mz_system,user=mz_system
GRANT CREATEQUERYPOLICY ON SYSTEM TO policy_creator;
----
COMPLETE 0

simple conn=policy_creator,user=policy_creator
CREATE QUERY POLICY delegated (RULES (r (action='reject', metric='query_plan_includes', value='storage_read')));
----
COMPLETE 0

simple conn=policy_creator,user=policy_creator
ALTER QUERY POLICY delegated SET (MODE = 'enforce');
----
COMPLETE 0

simple conn=policy_creator,user=policy_creator
DROP QUERY POLICY delegated;
----
COMPLETE 0

simple conn=mz_system,user=mz_system
REVOKE CREATEQUERYPOLICY ON SYSTEM FROM policy_creator;
----
COMPLETE 0

statement ok
DROP ROLE policy_creator;

statement ok
CREATE ROLE policy_grantee;

statement error cannot specify QUERY POLICYS and IN DATABASE
ALTER DEFAULT PRIVILEGES FOR ROLE materialize IN DATABASE materialize GRANT USAGE ON QUERY POLICIES TO policy_grantee;

statement error cannot specify QUERY POLICYS and IN SCHEMA
ALTER DEFAULT PRIVILEGES FOR ROLE materialize IN SCHEMA public GRANT USAGE ON QUERY POLICIES TO policy_grantee;

statement ok
ALTER DEFAULT PRIVILEGES FOR ROLE materialize GRANT USAGE ON QUERY POLICIES TO policy_grantee;

statement ok
CREATE QUERY POLICY inherited (RULES (r (action='reject', metric='query_plan_includes', value='storage_read')));

mode standard

query TTTTTTT
SHOW PRIVILEGES FOR policy_grantee WHERE name = 'inherited';
