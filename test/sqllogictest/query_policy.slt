mode cockroach

statement ok
DROP QUERY POLICY inherited;

statement ok
ALTER DEFAULT PRIVILEGES FOR ROLE materialize REVOKE USAGE ON QUERY POLICIES FROM policy_grantee;

statement ok
DROP ROLE policy_grantee;

statement ok
CREATE TABLE indexed (a int, b int);

statement ok
INSERT INTO indexed VALUES (1, 10), (1, 30), (2, 20);

statement ok
CREATE DEFAULT INDEX ON indexed;

statement ok
CREATE MATERIALIZED VIEW unindexed AS SELECT * FROM indexed;

statement ok
CREATE QUERY POLICY no_dataflows (MODE = 'enforce', RULES (
    fast_only (action = 'reject', metric = 'query_plan_includes', value = 'temporary_dataflow')
));

statement ok
CREATE QUERY POLICY no_persist (MODE = 'enforce', RULES (
    memory_only (action = 'reject', metric = 'query_plan_includes', value = 'storage_read')
));

statement ok
ALTER CLUSTER quickstart SET (QUERY POLICY = no_dataflows);

# Constants and existing-index reads are allowed.
query I
SELECT 7;
----
7

query II rowsort
SELECT * FROM indexed;
----
1 10
1 30
2 20

# Aggregation needs a temporary dataflow even though its input is indexed.
simple conn=restricted,user=materialize
SELECT a, sum(b) FROM indexed GROUP BY a;
----
db error: ERROR: query rejected: this query would build a temporary dataflow
DETAIL: Query policy "no_dataflows" rule "fast_only" applies to this query on cluster "quickstart".
HINT: Run EXPLAIN to inspect the query plan. Create an index that serves the query on this cluster, or use a cluster whose query policy permits this plan.

# Diagnostics remain available even when their introspection queries need dataflows.
statement ok
EXPLAIN ANALYZE CLUSTER MEMORY;

statement ok
EXPLAIN ANALYZE MEMORY FOR MATERIALIZED VIEW unindexed;

# A persist fast-path read does not build a temporary dataflow.
query II rowsort
SELECT * FROM unindexed LIMIT 10;
----
1 10
1 30
2 20

# DDL remains possible on a restricted cluster.
statement ok
CREATE MATERIALIZED VIEW totals AS SELECT a, sum(b) FROM indexed GROUP BY a;

statement ok
CREATE DEFAULT INDEX ON totals;

query II rowsort
SELECT * FROM totals;
----
1 40
2 20

# Read-then-write queries cannot bypass the temporary-dataflow restriction.
statement error query rejected: this query would build a temporary dataflow
INSERT INTO indexed SELECT a, sum(b)::int FROM indexed GROUP BY a;

statement error query rejected: this query would build a temporary dataflow
UPDATE indexed SET b = b + 1 WHERE b < (SELECT avg(b) FROM indexed);

statement error query rejected: this query would build a temporary dataflow
DELETE FROM indexed WHERE b < (SELECT avg(b) FROM indexed);

query II rowsort
SELECT * FROM indexed;
----
1 10
1 30
2 20

query error query rejected: this query would build a temporary dataflow
SUBSCRIBE indexed;

# Replacing RULES removes the old restriction and preserves enforcement mode.
statement ok
ALTER QUERY POLICY no_dataflows SET (RULES (
    memory_only (action = 'reject', metric = 'query_plan_includes', value = 'storage_read')
));

query II rowsort
SELECT a, sum(b) FROM indexed GROUP BY a;
----
1 40
2 20

query error query rejected: this query would read from object storage
SELECT * FROM unindexed LIMIT 10;

statement ok
ALTER QUERY POLICY no_dataflows SET (RULES (
    fast_only (action = 'reject', metric = 'query_plan_includes', value = 'temporary_dataflow')
));

statement ok
ALTER CLUSTER quickstart SET (QUERY POLICY = no_persist);

# A temporary dataflow over indexes is allowed by a persist-only restriction.
query II rowsort
SELECT a, sum(b) FROM indexed GROUP BY a;
----
1 40
2 20

simple conn=restricted,user=materialize
SELECT * FROM unindexed LIMIT 10;
