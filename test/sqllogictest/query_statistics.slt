mode cockroach

simple conn=mz_system,user=mz_system
ALTER SYSTEM SET enable_cardinality_estimates TO true;
----
COMPLETE 0

# Optional statistics must preserve query results in both peek sequencers,
# including when collection times out. Do not assert timing-sensitive estimates.
statement ok
CREATE TABLE query_statistics_t (x int);

statement ok
INSERT INTO query_statistics_t VALUES (1), (2), (3);

simple conn=mz_system,user=mz_system
ALTER SYSTEM SET enable_frontend_peek_sequencing TO false;
----
COMPLETE 0

simple conn=coordinator
SET enable_session_cardinality_estimates TO true;
SELECT sum(x) FROM query_statistics_t WHERE x > 1;
----
COMPLETE 0
5
COMPLETE 1

simple conn=mz_system,user=mz_system
ALTER SYSTEM SET enable_frontend_peek_sequencing TO true;
----
COMPLETE 0

simple conn=frontend
SET enable_session_cardinality_estimates TO true;
SELECT sum(x) FROM query_statistics_t WHERE x > 1;
----
COMPLETE 0
5
COMPLETE 1

simple conn=mz_system,user=mz_system
ALTER SYSTEM SET optimizer_oneshot_stats_timeout TO '1us';
----
COMPLETE 0

simple conn=coordinator
SELECT sum(x) FROM query_statistics_t WHERE x > 1;
----
5
COMPLETE 1

simple conn=frontend
SELECT sum(x) FROM query_statistics_t WHERE x > 1;
----
5
COMPLETE 1

simple conn=mz_system,user=mz_system
ALTER SYSTEM RESET optimizer_oneshot_stats_timeout;
----
COMPLETE 0

simple conn=mz_system,user=mz_system
ALTER SYSTEM RESET enable_frontend_peek_sequencing;
----
COMPLETE 0

simple conn=mz_system,user=mz_system
ALTER SYSTEM RESET enable_cardinality_estimates;
----
COMPLETE 0

statement ok
DROP TABLE query_statistics_t;
