mode cockroach

reset-server

# Server - false; Session - false

simple conn=mz_system,user=mz_system
ALTER SYSTEM SET enable_rbac_checks TO false;
----
COMPLETE 0

statement ok
SET enable_session_rbac_checks TO false;

query B
SELECT mz_internal.is_rbac_enabled();
----
false

# Server - true; Session - false

simple conn=mz_system,user=mz_system
ALTER SYSTEM SET enable_rbac_checks TO true;
----
COMPLETE 0

statement ok
SET enable_session_rbac_checks TO false;

query B
SELECT mz_internal.is_rbac_enabled();
----
true

# Server - false; Session - true

simple conn=mz_system,user=mz_system
ALTER SYSTEM SET enable_rbac_checks TO false;
----
COMPLETE 0

statement ok
SET enable_session_rbac_checks TO true

query B
SELECT mz_internal.is_rbac_enabled();
----
true

# Server - true; Session - true

simple conn=mz_system,user=mz_system
ALTER SYSTEM SET enable_rbac_checks TO true;
----
COMPLETE 0

statement ok
SET enable_session_rbac_checks TO true

query B
SELECT mz_internal.is_rbac_enabled();
----
true

# Turn everything off

simple conn=mz_system,user=mz_system
ALTER SYSTEM SET enable_rbac_checks TO false;
----
COMPLETE 0

statement ok
SET enable_session_rbac_checks TO false


# Adapter management is administrative even when both optional checks are off.
statement ok
CREATE ROLE adapter_outsider LOGIN;

simple conn=adapter_outsider,user=adapter_outsider
SET enable_session_rbac_checks TO false;
----
COMPLETE 0

simple conn=adapter_outsider,user=adapter_outsider
CREATE ADAPTER rbac_forbidden_adapter (SIZE '1');
----
db error: ERROR: permission denied to manage adapters
DETAIL: You must be a superuser to manage adapters

statement ok
DROP ROLE adapter_outsider;
