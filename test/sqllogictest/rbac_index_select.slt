1
COMPLETE 1

# A plain REVOKE SELECT, or REVOKE ALL, on the relation also revokes its
# index-scoped grants.

statement ok
REVOKE SELECT ON v FROM alice

simple conn=alice,user=alice
SELECT * FROM v;
----
db error: ERROR: permission denied for VIEW "materialize.public.v"
DETAIL: The 'alice' role needs SELECT privileges on VIEW "materialize.public.v"

query TT
SELECT name, index FROM mz_internal.mz_show_index_scoped_privileges WHERE grantee = 'alice' ORDER BY index
----
mv  mv_idx

statement ok
GRANT SELECT ON v TO alice USING INDEX v_idx

statement ok
REVOKE ALL ON v FROM alice

query TT
SELECT name, index FROM mz_internal.mz_show_index_scoped_privileges WHERE grantee = 'alice' ORDER BY index
----
mv  mv_idx

# A new owner of the relation also owns its indexes, and becomes the grantor of
# their index-scoped grants.

statement ok
GRANT SELECT ON v TO alice USING INDEX v_idx

statement ok
CREATE ROLE new_owner

simple conn=mz_system,user=mz_system
GRANT SELECT ON t TO new_owner;
----
COMPLETE 0

simple conn=mz_system,user=mz_system
ALTER VIEW v OWNER TO new_owner;
----
COMPLETE 0

query TTT
