1
COMPLETE 1

# A materialized view that alice creates over the relation is read with her
# privileges as its owner, which do not include SELECT on `v`.

simple conn=mz_system,user=mz_system
GRANT CREATE ON CLUSTER idx_cluster TO alice;
----
COMPLETE 0

simple conn=alice,user=alice
CREATE MATERIALIZED VIEW alice_mv IN CLUSTER idx_cluster AS SELECT * FROM v;
----
COMPLETE 0

simple conn=alice,user=alice
SELECT * FROM alice_mv;
