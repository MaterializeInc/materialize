# 35 chained INTERSECTs.
# Planning duplicates an INTERSECT's left input, so a left-deep chain doubles
# the plan at every level. `plan_set_expr` puts the cheaper input on the left to
# keep that polynomial. Without that, this query needs 2^35 HIR nodes and
# exhausts memory while planning.
query I
SELECT 1 INTERSECT SELECT 1 INTERSECT SELECT 1 INTERSECT SELECT 1 INTERSECT SELECT 1 INTERSECT SELECT 1 INTERSECT SELECT 1 INTERSECT SELECT 1 INTERSECT SELECT 1 INTERSECT SELECT 1 INTERSECT SELECT 1 INTERSECT SELECT 1 INTERSECT SELECT 1 INTERSECT SELECT 1 INTERSECT SELECT 1 INTERSECT SELECT 1 INTERSECT SELECT 1 INTERSECT SELECT 1 INTERSECT SELECT 1 INTERSECT SELECT 1 INTERSECT SELECT 1 INTERSECT SELECT 1 INTERSECT SELECT 1 INTERSECT SELECT 1 INTERSECT SELECT 1 INTERSECT SELECT 1 INTERSECT SELECT 1 INTERSECT SELECT 1 INTERSECT SELECT 1 INTERSECT SELECT 1 INTERSECT SELECT 1 INTERSECT SELECT 1 INTERSECT SELECT 1 INTERSECT SELECT 1 INTERSECT SELECT 1 INTERSECT SELECT 1;
----
1
