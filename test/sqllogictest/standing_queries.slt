mode cockroach

# Test standing queries end-to-end.

# --- Enable feature flag ---

simple conn=mz_system,user=mz_system
ALTER SYSTEM SET enable_standing_queries = true;
----
COMPLETE 0

# --- Setup ---

statement ok
CREATE TABLE orders (id INT, customer_id INT, amount INT)

statement ok
INSERT INTO orders VALUES (1, 10, 100), (2, 10, 200), (3, 20, 300), (4, 20, 400), (5, 30, 500)

# --- CREATE STANDING QUERY ---

statement ok
CREATE STANDING QUERY orders_by_customer (cid INT) AS SELECT id, customer_id, amount FROM orders WHERE customer_id = cid

# --- EXECUTE: single param, multiple results ---

query III rowsort
EXECUTE STANDING QUERY orders_by_customer (10)
----
1  10  100
2  10  200

query III rowsort
SELECT id, customer_id, amount FROM orders WHERE customer_id = 10
----
1  10  100
2  10  200

query III rowsort
EXECUTE STANDING QUERY orders_by_customer (20)
----
3  20  300
4  20  400

query III rowsort
SELECT id, customer_id, amount FROM orders WHERE customer_id = 20
----
3  20  300
4  20  400

# --- EXECUTE: no matching rows ---

query III
EXECUTE STANDING QUERY orders_by_customer (99)
----

query III
SELECT id, customer_id, amount FROM orders WHERE customer_id = 99
----

# --- EXECUTE: single matching row ---

query III
EXECUTE STANDING QUERY orders_by_customer (30)
----
5  30  500

query III
SELECT id, customer_id, amount FROM orders WHERE customer_id = 30
----
5  30  500

# --- Standing query with SELECT * ---

statement ok
CREATE STANDING QUERY all_orders_for_customer (cid INT) AS SELECT * FROM orders WHERE customer_id = cid

query III rowsort
EXECUTE STANDING QUERY all_orders_for_customer (10)
----
1  10  100
2  10  200

query III rowsort
SELECT * FROM orders WHERE customer_id = 10
----
1  10  100
2  10  200

# --- EXPLAIN CREATE STANDING QUERY ---

query T multiline
EXPLAIN CREATE STANDING QUERY explain_test (cid INT) AS SELECT id, customer_id, amount FROM orders WHERE customer_id = cid
----
materialize.public.explain_test:
  →Lookup Join %0:Explained Query » %1:orders[#1{customer_id}]
    →Unarranged Raw Stream
      →Read Explained Query
    →Arrange (#1{customer_id})
      →Read materialize.public.orders

Source materialize.public.orders
  filter=((#1{customer_id}) IS NOT NULL)
Source Explained Query
  filter=((#1) IS NOT NULL)

Target cluster: quickstart

EOF

query T multiline
EXPLAIN OPTIMIZED PLAN FOR CREATE STANDING QUERY explain_test2 (cid INT) AS SELECT id, customer_id, amount FROM orders WHERE customer_id = cid
----
materialize.public.explain_test2:
  Project (#0, #2, #1, #4)
    Join on=(#1 = #3{customer_id}) type=delta
      ArrangeBy keys=[[#1]]
        Filter (#1) IS NOT NULL
          ReadStorage Explained Query
      ArrangeBy keys=[[#1{customer_id}]]
        Filter (#1{customer_id}) IS NOT NULL
          ReadStorage materialize.public.orders

Source materialize.public.orders
  filter=((#1{customer_id}) IS NOT NULL)
Source Explained Query
  filter=((#1) IS NOT NULL)

Target cluster: quickstart

EOF

query T multiline
EXPLAIN PHYSICAL PLAN FOR CREATE STANDING QUERY explain_test3 (cid INT) AS SELECT id, customer_id, amount FROM orders WHERE customer_id = cid
----
materialize.public.explain_test3:
  Join::Lookup
    lookup_stage[0]
      closure
        project=(#1, #2, #0, #3)
      lookup={ relation=1, key=[#1{customer_id}] }
      stream={ key=[#1], thinning=(#0) }
    source={ relation=0, raw }
    ArrangeBy
      raw=true
      Get::Collection Explained Query
        raw=true
    ArrangeBy
      raw=true
      arrangements[0]={ key=[#1{customer_id}], permutation={#0: #1, #1: #0}, thinning=(#0, #2) }
      Get::Collection materialize.public.orders
        raw=true

Source materialize.public.orders
  filter=((#1{customer_id}) IS NOT NULL)
Source Explained Query
  filter=((#1) IS NOT NULL)

Target cluster: quickstart

EOF

# --- EXPLAIN EXECUTE STANDING QUERY ---

query T multiline
EXPLAIN EXECUTE STANDING QUERY orders_by_customer (10)
----
Execute Standing Query materialize.public.orders_by_customer
  Parameters:
    $1: Int32 = 10

EOF

# --- Each execution reflects the writes that precede it ---
#
# The join with the parameter collection is a lookup join: an execution looks
# up the other inputs as of its timestamp, and later changes to them do not
# produce output. Changes between executions must show in the later execution
# only, and must not leave rows behind for later executions.

query III
EXECUTE STANDING QUERY orders_by_customer (40)
----

statement ok
INSERT INTO orders VALUES (6, 40, 600), (7, 40, 700)

query III rowsort
EXECUTE STANDING QUERY orders_by_customer (40)
----
6  40  600
7  40  700

statement ok
DELETE FROM orders WHERE id = 6

query III rowsort
EXECUTE STANDING QUERY orders_by_customer (40)
----
7  40  700

statement ok
UPDATE orders SET amount = 750 WHERE id = 7

query III rowsort
EXECUTE STANDING QUERY orders_by_customer (40)
----
7  40  750

statement ok
DELETE FROM orders WHERE id = 7

query III
EXECUTE STANDING QUERY orders_by_customer (40)
----

# Duplicate rows keep their multiplicity.

statement ok
INSERT INTO orders VALUES (8, 40, 800), (8, 40, 800)

query III
EXECUTE STANDING QUERY orders_by_customer (40)
----
8  40  800
8  40  800

statement ok
DELETE FROM orders WHERE id = 8

# --- Lookup joins over several inputs ---

statement ok
CREATE TABLE customers (id INT, name TEXT)

statement ok
INSERT INTO customers VALUES (10, 'ten'), (20, 'twenty')

statement ok
CREATE STANDING QUERY orders_with_name (cid INT) AS SELECT o.id, c.name FROM orders o JOIN customers c ON o.customer_id = c.id WHERE o.customer_id = cid

query T multiline
EXPLAIN PHYSICAL PLAN FOR CREATE STANDING QUERY orders_with_name_explain (cid INT) AS SELECT o.id, c.name FROM orders o JOIN customers c ON o.customer_id = c.id WHERE o.customer_id = cid
----
materialize.public.orders_with_name_explain:
  Join::Lookup
    lookup_stage[1]
      closure
        project=(#1..=#3)
      lookup={ relation=2, key=[#0{id}] }
      stream={ key=[#1], thinning=(#0, #2) }
    lookup_stage[0]
      closure
        project=(#1, #0, #2)
      lookup={ relation=1, key=[#1{customer_id}] }
      stream={ key=[#1], thinning=(#0) }
    source={ relation=0, raw }
    ArrangeBy
      raw=true
      Get::Collection Explained Query
        raw=true
    ArrangeBy
      raw=true
      arrangements[0]={ key=[#1{customer_id}], permutation={#0: #1, #1: #0}, thinning=(#0) }
      Get::Collection materialize.public.orders
        raw=true
    ArrangeBy
      raw=true
      arrangements[0]={ key=[#0{id}], permutation=id, thinning=(#1) }
      Get::Collection materialize.public.customers
        raw=true

Source materialize.public.orders
  project=(#0, #1)
  filter=((#1{customer_id}) IS NOT NULL)
Source materialize.public.customers
  filter=((#0{id}) IS NOT NULL)
Source Explained Query
  filter=((#1) IS NOT NULL)

Target cluster: quickstart

EOF

query IT rowsort
EXECUTE STANDING QUERY orders_with_name (10)
----
1  ten
2  ten

query IT
EXECUTE STANDING QUERY orders_with_name (30)
----

statement ok
INSERT INTO customers VALUES (30, 'thirty')

query IT
EXECUTE STANDING QUERY orders_with_name (30)
----
5  thirty

statement ok
UPDATE customers SET name = 'TEN' WHERE id = 10

query IT rowsort
EXECUTE STANDING QUERY orders_with_name (10)
----
1  TEN
2  TEN

statement ok
DROP STANDING QUERY orders_with_name

# --- Stateful operators in the query ---
#
# Decorrelation joins the parameter collection with the result of the query,
# keyed by the parameter values it references, so that join sits directly below
# the output. Stateful operators, like the aggregation here, read the parameter
# collection below the lookup join and maintain their state as usual.

statement ok
CREATE STANDING QUERY order_count (cid INT) AS SELECT count(*), sum(amount) FROM orders WHERE customer_id = cid

query T multiline
EXPLAIN PHYSICAL PLAN FOR CREATE STANDING QUERY order_count_explain (cid INT) AS SELECT count(*), sum(amount) FROM orders WHERE customer_id = cid
----
materialize.public.order_count_explain:
  With
    cte l0 =
      Reduce::Distinct
        key_plan=id
        val_plan
          project=()
        Get::Collection Explained Query
          project=(#1)
          raw=true
    cte l1 =
      Reduce::Accumulable
        simple_aggrs[0]=(0, count(*))
        simple_aggrs[1]=(1, sum(#1{amount}))
        key_plan
          project=(#0)
        val_plan
          project=(#2, #1)
          map=(true)
        Join::Linear
          linear_stage[0]
            lookup={ relation=1, key=[#0{customer_id}] }
            stream={ key=[#0], thinning=() }
          source={ relation=0, key=[#0] }
          Get::PassArrangements l0
            raw=false
            arrangements[0]={ key=[#0], permutation=id, thinning=() }
          ArrangeBy
            raw=true
            arrangements[0]={ key=[#0{customer_id}], permutation=id, thinning=(#1) }
            Get::Collection materialize.public.orders
              raw=true
  Return
    Join::Lookup
      lookup_stage[0]
        closure
          project=(#1..=#3)
        lookup={ relation=1, key=[#0] }
        stream={ key=[#1], thinning=(#0) }
      source={ relation=0, raw }
      ArrangeBy
        raw=true
        Get::PassArrangements Explained Query
          raw=true
      ArrangeBy
        raw=true
        arrangements[0]={ key=[#0], permutation=id, thinning=(#1, #2) }
        Union
          ArrangeBy
            input_key=[#0]
            raw=true
            Get::PassArrangements l1
              raw=false
              arrangements[0]={ key=[#0], permutation=id, thinning=(#1, #2) }
          Mfp
            project=(#0..=#2)
            map=(0, null)
            Union consolidate_output=true
              Negate
                Get::Arrangement l1
                  project=(#0)
                  key=#0
                  raw=false
                  arrangements[0]={ key=[#0], permutation=id, thinning=(#1, #2) }
              ArrangeBy
                input_key=[#0]
                raw=true
                Get::PassArrangements l0
                  raw=false
                  arrangements[0]={ key=[#0], permutation=id, thinning=() }

Source materialize.public.orders
  project=(#1, #2)
  filter=((#1{customer_id}) IS NOT NULL)
Source Explained Query

Target cluster: quickstart

EOF

query II
EXECUTE STANDING QUERY order_count (10)
----
2  300

query II
EXECUTE STANDING QUERY order_count (40)
----
0  NULL

statement ok
INSERT INTO orders VALUES (9, 40, 900)

query II
EXECUTE STANDING QUERY order_count (40)
----
1  900

query II
EXECUTE STANDING QUERY order_count (10)
----
2  300

statement ok
CREATE STANDING QUERY top_order (cid INT) AS SELECT id FROM orders WHERE customer_id = cid ORDER BY amount DESC LIMIT 1

query I
EXECUTE STANDING QUERY top_order (20)
----
4

statement ok
INSERT INTO orders VALUES (10, 20, 1000)

query I
EXECUTE STANDING QUERY top_order (20)
----
10

statement ok
DELETE FROM orders WHERE id IN (9, 10)

query I
EXECUTE STANDING QUERY top_order (20)
----
4

query II
EXECUTE STANDING QUERY order_count (40)
----
0  NULL

statement ok
DROP STANDING QUERY order_count

statement ok
DROP STANDING QUERY top_order

statement ok
DROP TABLE customers

# --- DROP STANDING QUERY ---

statement ok
DROP STANDING QUERY orders_by_customer

statement error unknown catalog item
EXECUTE STANDING QUERY orders_by_customer (10)

statement ok
DROP STANDING QUERY all_orders_for_customer

# --- Errors localized to the request that raised them ---
#
# A standing query serves every session through one dataflow. On a cluster
# created with cell-scoped errors, an error in one request's evaluation fails
# that request only, and other requests, from this session or another, keep
# working. A cluster records the setting when it is created.

simple conn=mz_system,user=mz_system
ALTER SYSTEM SET enable_compute_cell_errors TO true;
----
COMPLETE 0

statement ok
CREATE CLUSTER sq_cell SIZE 'scale=1,workers=1'

statement ok
SET cluster = sq_cell

statement ok
CREATE STANDING QUERY share (cid INT, d INT) AS SELECT id, amount / d AS share FROM orders WHERE customer_id = cid

query II rowsort
EXECUTE STANDING QUERY share (10, 10)
----
1  10
2  20

query error division by zero
EXECUTE STANDING QUERY share (10, 0)

query II rowsort
EXECUTE STANDING QUERY share (20, 100)
----
3  3
4  4

simple conn=other_session,user=materialize
SET cluster = sq_cell;
EXECUTE STANDING QUERY share (30, 50);
----
COMPLETE 0
5,10
COMPLETE 1

statement ok
CREATE STANDING QUERY positive (cid INT, d INT) AS SELECT id FROM orders WHERE customer_id = cid AND amount / d > 0

query error division by zero
EXECUTE STANDING QUERY positive (10, 0)

query I rowsort
EXECUTE STANDING QUERY positive (20, 1)
----
3
4

statement ok
DROP CLUSTER sq_cell CASCADE

# On a cluster with row-scoped errors, one request's error poisons the
# standing query, and every later request fails, in any session.

simple conn=mz_system,user=mz_system
ALTER SYSTEM SET enable_compute_cell_errors TO false;
----
COMPLETE 0

statement ok
CREATE CLUSTER sq_row SIZE 'scale=1,workers=1'

statement ok
SET cluster = sq_row

statement ok
CREATE STANDING QUERY share_row (cid INT, d INT) AS SELECT id, amount / d AS share FROM orders WHERE customer_id = cid

query II rowsort
EXECUTE STANDING QUERY share_row (10, 10)
----
1  10
2  20

query error division by zero
EXECUTE STANDING QUERY share_row (10, 0)

query error division by zero
EXECUTE STANDING QUERY share_row (20, 100)

statement ok
RESET cluster

statement ok
DROP CLUSTER sq_row CASCADE

simple conn=mz_system,user=mz_system
ALTER SYSTEM RESET enable_compute_cell_errors;
----
COMPLETE 0
