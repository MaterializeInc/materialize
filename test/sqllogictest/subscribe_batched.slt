mode cockroach

simple conn=mz_system,user=mz_system
ALTER SYSTEM SET enable_envelope_debezium_in_subscribe = true
----
COMPLETE 0

simple conn=mz_system,user=mz_system
ALTER SYSTEM SET enable_within_timestamp_order_by_in_subscribe = true
----
COMPLETE 0

statement ok
CREATE TABLE t (a int, b int)

statement ok
CREATE VIEW v AS VALUES (1, 2)

# The feature flag gates BATCHED.

simple conn=mz_system,user=mz_system
ALTER SYSTEM SET enable_subscribe_batched = false
----
COMPLETE 0

statement error db error: ERROR: `SUBSCRIBE \.\.\. WITH \(BATCHED\)` is not available
SUBSCRIBE t WITH (BATCHED)

simple conn=mz_system,user=mz_system
ALTER SYSTEM SET enable_subscribe_batched = true
----
COMPLETE 0

# BATCHED = false is a plain subscribe.

statement ok
BEGIN

statement ok
DECLARE c CURSOR FOR SUBSCRIBE t WITH (BATCHED = false)

query IIII colnames
FETCH 0 c
----
mz_timestamp mz_diff a b

statement ok
COMMIT

# BATCHED requires plain diff output.

statement error BATCHED requires plain diff output
SUBSCRIBE t ENVELOPE UPSERT (KEY (a)) WITH (BATCHED)

statement error BATCHED requires plain diff output
SUBSCRIBE t WITHIN TIMESTAMP ORDER BY a WITH (BATCHED)

statement error BATCHED implies PROGRESS
SUBSCRIBE t WITH (BATCHED, PROGRESS = false)

# BATCHED emits progress rows.

statement ok
BEGIN

statement ok
DECLARE c CURSOR FOR SUBSCRIBE v WITH (BATCHED)

query IIIII colnames
FETCH ALL c WITH (timeout = '1s')
----
mz_timestamp mz_progressed mz_diff column1 column2
18446744073709551615  1  NULL  NULL  NULL
18446744073709551615  0  1     1     2

statement ok
COMMIT

# A subscribe over an indexed view reads the index's arrangement, and reports what the
# subscribe over the unindexed view reports.

statement ok
CREATE VIEW iv AS VALUES (1, 2), (3, 4)

statement ok
CREATE DEFAULT INDEX ON iv

statement ok
BEGIN

statement ok
DECLARE c CURSOR FOR SUBSCRIBE iv WITH (BATCHED)

query IIIII colnames,rowsort
FETCH ALL c WITH (timeout = '1s')
----
mz_timestamp mz_progressed mz_diff column1 column2
18446744073709551615  0  1  1  2
18446744073709551615  0  1  3  4
18446744073709551615  1  NULL  NULL  NULL

statement ok
COMMIT

statement ok
CREATE VIEW uv AS VALUES (1, 2), (3, 4)

statement ok
BEGIN

statement ok
DECLARE c CURSOR FOR SUBSCRIBE uv WITH (BATCHED)

query IIIII colnames,rowsort
FETCH ALL c WITH (timeout = '1s')
----
mz_timestamp mz_progressed mz_diff column1 column2
18446744073709551615  0  1  1  2
18446744073709551615  0  1  3  4
18446744073709551615  1  NULL  NULL  NULL

statement ok
COMMIT
