mode cockroach

simple conn=mz_system,user=mz_system
ALTER SYSTEM SET enable_envelope_debezium_in_subscribe = true
----
COMPLETE 0

simple conn=mz_system,user=mz_system
ALTER SYSTEM SET enable_within_timestamp_order_by_in_subscribe = true
----
COMPLETE 0

statement ok
CREATE TABLE t (a int, b int)

statement ok
CREATE VIEW v AS VALUES (1, 2)

# The feature flag gates BATCHED.

simple conn=mz_system,user=mz_system
ALTER SYSTEM SET enable_subscribe_batched = false
----
COMPLETE 0

statement error db error: ERROR: `SUBSCRIBE \.\.\. WITH \(BATCHED\)` is not available
SUBSCRIBE t WITH (BATCHED)

simple conn=mz_system,user=mz_system
ALTER SYSTEM SET enable_subscribe_batched = true
----
COMPLETE 0

# BATCHED = false is a plain subscribe.

statement ok
BEGIN

statement ok
DECLARE c CURSOR FOR SUBSCRIBE t WITH (BATCHED = false)

query IIII colnames
FETCH 0 c
----
mz_timestamp mz_diff a b

statement ok
COMMIT

# BATCHED requires plain diff output.

statement error BATCHED requires plain diff output
SUBSCRIBE t ENVELOPE UPSERT (KEY (a)) WITH (BATCHED)

statement error BATCHED requires plain diff output
SUBSCRIBE t WITHIN TIMESTAMP ORDER BY a WITH (BATCHED)

statement error BATCHED implies PROGRESS
SUBSCRIBE t WITH (BATCHED, PROGRESS = false)

# BATCHED emits progress rows.

statement ok
BEGIN

statement ok
DECLARE c CURSOR FOR SUBSCRIBE v WITH (BATCHED)

query IIIII colnames
FETCH ALL c WITH (timeout = '1s')
----
mz_timestamp mz_progressed mz_diff column1 column2
18446744073709551615  1  NULL  NULL  NULL
18446744073709551615  0  1     1     2

statement ok
COMMIT

# A subscribe over an indexed view reads the index's arrangement, and reports what the
# subscribe over the unindexed view reports.

statement ok
CREATE VIEW iv AS VALUES (1, 2), (3, 4)

statement ok
CREATE DEFAULT INDEX ON iv

statement ok
BEGIN

statement ok
DECLARE c CURSOR FOR SUBSCRIBE iv WITH (BATCHED)

query IIIII colnames,rowsort
FETCH ALL c WITH (timeout = '1s')
----
mz_timestamp mz_progressed mz_diff column1 column2
18446744073709551615  0  1  1  2
18446744073709551615  0  1  3  4
18446744073709551615  1  NULL  NULL  NULL

statement ok
COMMIT

statement ok
CREATE VIEW uv AS VALUES (1, 2), (3, 4)

statement ok
BEGIN

statement ok
DECLARE c CURSOR FOR SUBSCRIBE uv WITH (BATCHED)

query IIIII colnames,rowsort
FETCH ALL c WITH (timeout = '1s')
----
mz_timestamp mz_progressed mz_diff column1 column2
18446744073709551615  0  1  1  2
18446744073709551615  0  1  3  4
18446744073709551615  1  NULL  NULL  NULL

statement ok
COMMIT

# A subscribe over a filter and map of an indexed view that keeps the index key reads the
# index's arrangement. It reports what the subscribe over the unindexed view reports.

statement ok
CREATE VIEW kv AS VALUES (1, 2), (2, 1), (3, 4), (NULL, 5)

statement ok
CREATE INDEX kv_column1 ON kv (column1)

statement ok
CREATE VIEW ukv AS VALUES (1, 2), (2, 1), (3, 4), (NULL, 5)

query T multiline
EXPLAIN PHYSICAL PLAN FOR SUBSCRIBE (SELECT column1, column2 + 1 AS c FROM kv WHERE column1 < column2) WITH (BATCHED)
----

Used Indexes:
  - materialize.public.kv_column1 (*** full scan ***)

Target cluster: quickstart

EOF

query T multiline
EXPLAIN PHYSICAL PLAN FOR SUBSCRIBE (SELECT column2 FROM kv WHERE column1 < column2) WITH (BATCHED)
----
Explained Query:
  Get::Arrangement materialize.public.kv
    project=(#1)
    filter=((#0{column1} < #1{column2}))
    key=#0{column1}
    raw=false
    arrangements[0]={ key=[#0{column1}], permutation=id, thinning=(#1) }

Used Indexes:
  - materialize.public.kv_column1 (*** full scan ***)

Target cluster: quickstart

EOF

statement ok
BEGIN

statement ok
DECLARE c CURSOR FOR SUBSCRIBE (SELECT column1, column2 + 1 AS c FROM kv WHERE column1 < column2) WITH (BATCHED)

query IIIII colnames,rowsort
FETCH ALL c WITH (timeout = '1s')
----
mz_timestamp mz_progressed mz_diff column1 c
18446744073709551615  0  1  1  3
18446744073709551615  0  1  3  5
18446744073709551615  1  NULL  NULL  NULL

statement ok
COMMIT

statement ok
BEGIN

statement ok
DECLARE c CURSOR FOR SUBSCRIBE (SELECT column1, column2 + 1 AS c FROM ukv WHERE column1 < column2) WITH (BATCHED)

query IIIII colnames,rowsort
FETCH ALL c WITH (timeout = '1s')
----
mz_timestamp mz_progressed mz_diff column1 c
18446744073709551615  0  1  1  3
18446744073709551615  0  1  3  5
18446744073709551615  1  NULL  NULL  NULL

statement ok
COMMIT

# A subscribe whose projection drops the index key reads the view it builds. It reports what the
# subscribe over the unindexed view reports.

statement ok
BEGIN

statement ok
DECLARE c CURSOR FOR SUBSCRIBE (SELECT column2 FROM kv WHERE column1 < column2) WITH (BATCHED)

query IIII colnames,rowsort
FETCH ALL c WITH (timeout = '1s')
----
mz_timestamp mz_progressed mz_diff column2
18446744073709551615  0  1  2
18446744073709551615  0  1  4
18446744073709551615  1  NULL  NULL

statement ok
COMMIT

statement ok
BEGIN

statement ok
DECLARE c CURSOR FOR SUBSCRIBE (SELECT column2 FROM ukv WHERE column1 < column2) WITH (BATCHED)

query IIII colnames,rowsort
FETCH ALL c WITH (timeout = '1s')
----
mz_timestamp mz_progressed mz_diff column2
18446744073709551615  0  1  2
18446744073709551615  0  1  4
18446744073709551615  1  NULL  NULL

statement ok
COMMIT
