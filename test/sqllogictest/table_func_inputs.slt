# A scalar subquery that produces more than one row

statement ok
CREATE TABLE subquery_rows (k int)

statement ok
INSERT INTO subquery_rows VALUES (1), (1), (2)

query II
SELECT s.k, (SELECT r.k FROM subquery_rows r WHERE r.k = s.k AND r.k = 2) FROM subquery_rows s ORDER BY s.k
----
1  NULL
1  NULL
2  2

query error more than one record produced in subquery
SELECT s.k, (SELECT r.k FROM subquery_rows r WHERE r.k = s.k) FROM subquery_rows s
