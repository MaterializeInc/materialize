  (1, '{}', 1),
  (2, '{1,2,3}', 1),
  (3, '{1,2,3}', 0),
  (4, '{1,2,3}', 2),
  (5, '{1,2,3}', -1),
  (6, '{{1,2},{3,4},{5,6}}', 1),
  (7, '{{1,2},{3,4},{5,6}}', 2),
  (8, '{NULL}', 1),
  (9, NULL, 1),
  (10, '{1,2,3}', NULL)

query II
SELECT id, s FROM subscripts, generate_subscripts(a, d) AS s ORDER BY id, s
----
2  1
2  2
2  3
6  1
6  2
6  3
7  1
7  2
8  1

# regexp_matches

# NOTE: A pattern without capture groups returns `{}`. PostgreSQL returns the
# whole match, as our own `regexp_match` does (DB-68).

statement ok
CREATE TABLE matches (id int, s text, p text, f text)

statement ok
INSERT INTO matches VALUES
  (1, 'abc', 'x', ''),
  (2, '', '', ''),
  (3, 'aXbXc', '(X)', 'g'),
  (4, 'aXbXc', '(X)', ''),
  (5, 'b', '(a)|(b)', ''),
  (6, 'AbA', 'a', 'gi'),
  (7, 'ééé', '(é+)', ''),
  (8, 'abc', '', 'g'),
  (9, NULL, 'a', ''),
  (10, 'a', NULL, ''),
  (11, 'a', 'a', NULL)

query IT
SELECT id, m FROM matches, regexp_matches(s, p, f) AS m ORDER BY id, m
----
2  {}
3  {X}
3  {X}
4  {X}
5  {NULL,b}
6  {}
6  {}
7  {ééé}
8  {}
8  {}
8  {}
8  {}

query IT
SELECT id, m FROM matches, regexp_matches(s, p) AS m ORDER BY id, m
----
2  {}
3  {X}
4  {X}
5  {NULL,b}
7  {ééé}
8  {}
11  {}

statement ok
CREATE TABLE matches_bad_regex (s text, p text)

statement ok
INSERT INTO matches_bad_regex VALUES ('a', '(')

query error invalid regular expression: regex parse error:
SELECT m FROM matches_bad_regex, regexp_matches(s, p) AS m

statement ok
CREATE TABLE matches_bad_flag (s text, p text, f text)

statement ok
INSERT INTO matches_bad_flag VALUES ('a', 'a', 'z')

query error invalid regular expression flag: z
SELECT m FROM matches_bad_flag, regexp_matches(s, p, f) AS m

# regexp_extract, whose pattern must be a literal

statement ok
CREATE TABLE haystacks (id int, s text)

statement ok
INSERT INTO haystacks VALUES
  (1, 'ab'),
  (2, 'a'),
  (3, ''),
  (4, 'xxab'),
  (5, 'ééb'),
  (6, NULL)

query ITT
SELECT id, first, second FROM haystacks, regexp_extract('(?P<first>a|é+)(?P<second>b)?', s) ORDER BY id
----
1  a  b
2  a  NULL
4  a  b
5  éé  b

# csv_extract, whose column count must be a literal

statement ok
CREATE TABLE csv_lines (id int, s text)

statement ok
INSERT INTO csv_lines VALUES
  (1, 'a,b'),
  (2, ''),
  (3, 'a'),
  (4, 'a,b,c'),
  (5, '"q,1",x'),
  (6, '"a""b",c'),
  (7, 'a,'),
  (8, ',,'),
  (9, ' a , b '),
  (10, NULL)

query ITT
SELECT id, column1, column2 FROM csv_lines, csv_extract(2, s) ORDER BY id
----
1  a  b
5  q,1  x
6  a"b  c
7  a  (empty)
9  ␠a␠  ␠b␠

# repeat_row, repeat_row_non_negative

statement ok
CREATE TABLE repeats (id int, n bigint)

statement ok
INSERT INTO repeats VALUES (1, 0), (2, 1), (3, 3), (4, -2), (5, NULL)

query II
SELECT id, count(*) FROM repeats, repeat_row(n) GROUP BY id ORDER BY id
----
2  1
3  3
4  -2

query II
SELECT id, count(*) FROM repeats, repeat_row_non_negative(n) WHERE id <> 4 GROUP BY id ORDER BY id
----
2  1
3  3

query II
SELECT id, o FROM repeats, repeat_row_non_negative(n) WITH ORDINALITY AS t(o) WHERE id <> 4 ORDER BY id, o
----
2  1
3  1
3  2
3  3

statement ok
CREATE TABLE repeats_negative (n bigint)

statement ok
INSERT INTO repeats_negative VALUES (-2)

query error repeat_row_non_negative got \-2
SELECT count(*) FROM repeats_negative, repeat_row_non_negative(n)

# unnest over arrays, lists and maps

statement ok
CREATE TABLE containers (id int, a int[], l int list, m map[text=>int])

statement ok
INSERT INTO containers VALUES
  (1, '{}', '{}', '{}'),
  (2, '{NULL}', '{NULL}', '{a=>NULL}'),
  (3, '{{1,2},{3,4}}', '{1,2,1}', '{b=>2,a=>1}'),
  (4, NULL, NULL, NULL)

query II
SELECT id, e FROM containers, unnest(a) AS e ORDER BY id, e
----
2  NULL
3  1
3  2
3  3
3  4

query II
SELECT id, e FROM containers, unnest(l) AS e ORDER BY id, e
----
2  NULL
3  1
3  1
3  2

query ITI
SELECT id, key, value FROM containers, unnest(m) ORDER BY id, key
----
2  a  NULL
3  a  1
3  b  2

query III
SELECT id, e, n FROM containers, unnest(l) WITH ORDINALITY AS t(e, n) ORDER BY id, n
----
2  NULL  1
3  1  1
3  2  2
3  1  3

# ROWS FROM pads the shorter function with NULLs

query III
SELECT id, e, g FROM containers, ROWS FROM (unnest(l), generate_series(1, id)) AS t(e, g) ORDER BY id, g
----
1  NULL  1
2  NULL  1
2  NULL  2
3  1  1
3  2  2
3  1  3
4  NULL  1
4  NULL  2
4  NULL  3
4  NULL  4

