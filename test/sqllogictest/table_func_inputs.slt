# Table functions evaluated on edge-case inputs read from tables.
#
# Calls on literal arguments are folded by the optimizer, so a plan stores
# their result and never runs the function. Every call here takes its
# arguments from a table column, so it runs in a dataflow, which is how a
# durably stored plan would run it. Rows whose input errors live in their own
# tables, because one erroring row fails the whole query.
#
# Unlike `table_func.slt`, which is in `tests_without_views` in
# `test/sqllogictest/mzcompose.py`, this file runs with `--auto-index-selects`,
# so CI also checks each successful query as a maintained indexed view.

mode cockroach

simple conn=mz_system,user=mz_system
ALTER SYSTEM SET enable_repeat_row = true
----
COMPLETE 0

simple conn=mz_system,user=mz_system
ALTER SYSTEM SET enable_repeat_row_non_negative = true
----
COMPLETE 0

# jsonb_each, jsonb_each_text, jsonb_object_keys

# NOTE: jsonb numbers are normalized, so `1.50` reads back as `1.5`.
# PostgreSQL keeps the written scale.

# NOTE: jsonb values print without spaces, as `[1,2]`, where PostgreSQL prints
# `[1, 2]` (database-issues#7085).

# NOTE: Rows 6 to 8 are not objects. These functions return no rows for them,
# where PostgreSQL errors (DB-75 covers `jsonb_object_keys`).

statement ok
CREATE TABLE objs (id int, v jsonb)

statement ok
INSERT INTO objs VALUES
  (1, '{}'),
  (2, '{"a": 1, "b": "x", "c": null, "d": [1, 2], "e": {"f": true}}'),
  (3, '{"": 0, "ü": 1.50, "big": 1e20, "neg": -0, "small": 0.000001}'),
  (4, '{"a": 1, "a": 2}'),
  (5, '{"esc\"ape": "line\nbreak", "k\u00e9y": "\u00e9x"}'),
  (6, '[1, 2]'),
  (7, '"str"'),
  (8, 'null'),
  (9, NULL)

query ITT
SELECT id, key, value FROM objs, jsonb_each(v) ORDER BY id, key
----
2  a  1
2  b  "x"
2  c  null
2  d  [1,2]
2  e  {"f":true}
3  (empty)  0
3  big  100000000000000000000
3  neg  0
3  small  0.000001
3  ü  1.5
4  a  2
5  esc"ape  "line\nbreak"
5  kéy  "éx"

query ITT
SELECT id, key, value FROM objs, jsonb_each_text(v) ORDER BY id, key
----
2  a  1
2  b  x
2  c  NULL
2  d  [1,2]
2  e  {"f":true}
3  (empty)  0
3  big  100000000000000000000
3  neg  0
3  small  0.000001
3  ü  1.5
4  a  2
5  esc"ape  line⏎break
5  kéy  éx

query IT
SELECT id, k FROM objs, jsonb_object_keys(v) AS k ORDER BY id, k
----
2  a
2  b
2  c
2  d
2  e
3  (empty)
3  big
3  neg
3  small
3  ü
4  a
5  esc"ape
5  kéy

# NOTE: `WITH ORDINALITY` numbers the keys in sorted order. PostgreSQL numbers
# shorter keys first.

query ITTI
SELECT id, key, value, ordinality FROM objs, jsonb_each(v) WITH ORDINALITY ORDER BY id, ordinality
----
2  a  1  1
2  b  "x"  2
2  c  null  3
2  d  [1,2]  4
2  e  {"f":true}  5
3  (empty)  0  1
3  big  100000000000000000000  2
3  neg  0  3
3  small  0.000001  4
3  ü  1.5  5
4  a  2  1
5  esc"ape  "line\nbreak"  1
5  kéy  "éx"  2

# jsonb_array_elements, jsonb_array_elements_text

# NOTE: Rows 6 to 8 are not arrays. These functions return no rows for them,
# where PostgreSQL errors.

statement ok
CREATE TABLE arrs (id int, v jsonb)

statement ok
INSERT INTO arrs VALUES
  (1, '[]'),
  (2, '[null]'),
  (3, '[1, "a", true, null, [], {}]'),
  (4, '[[1, [2]], {"k": [3]}]'),
  (5, '["é", 1.0, 1e3, -0, "", " "]'),
  (6, '{"a": 1}'),
  (7, '"s"'),
  (8, 'null'),
  (9, NULL)

query IT
SELECT id, e FROM arrs, jsonb_array_elements(v) AS e ORDER BY id, e::text
----
2  null
3  "a"
3  1
3  []
3  null
3  true
3  {}
4  [1,[2]]
4  {"k":[3]}
5  "␠"
5  ""
5  "é"
5  0
5  1
5  1000

query IT
SELECT id, e FROM arrs, jsonb_array_elements_text(v) AS e ORDER BY id, e
----
2  NULL
3  1
3  []
3  a
3  true
3  {}
3  NULL
4  [1,[2]]
4  {"k":[3]}
5  (empty)
5  ␠
5  0
5  1
5  1000
5  é

query ITI
SELECT id, e, n FROM arrs, jsonb_array_elements(v) WITH ORDINALITY AS t(e, n) ORDER BY id, n
----
2  null  1
3  1  1
3  "a"  2
3  true  3
3  null  4
3  []  5
3  {}  6
4  [1,[2]]  1
4  {"k":[3]}  2
5  "é"  1
5  1  2
5  1000  3
5  0  4
5  ""  5
5  "␠"  6

# aclexplode, mz_aclexplode

# NOTE: `aclexplode` of an empty array returns no rows, where PostgreSQL errors.

statement ok
CREATE TABLE acls (id int, a aclitem[], m mz_aclitem[])

statement ok
INSERT INTO acls VALUES
  (1, ARRAY[]::aclitem[], ARRAY[]::mz_aclitem[]),
  (2,
   ARRAY[makeaclitem(10, 20, 'SELECT', false)],
   ARRAY[mz_internal.make_mz_aclitem('u1', 'u2', 'USAGE')]),
  (3,
   ARRAY[makeaclitem(10, 20, 'SELECT,INSERT,UPDATE,DELETE', false), makeaclitem(0, 20, 'USAGE', false)],
   ARRAY[mz_internal.make_mz_aclitem('u1', 'u2', 'SELECT,INSERT,UPDATE,DELETE'), mz_internal.make_mz_aclitem('p', 's1', 'CREATE')]),
  (4,
   ARRAY[makeaclitem(10, 20, 'SELECT', false), makeaclitem(10, 20, 'SELECT', false)],
   ARRAY[mz_internal.make_mz_aclitem('u1', 'u2', 'USAGE'), mz_internal.make_mz_aclitem('u1', 'u2', 'USAGE')]),
  (5, NULL, NULL)

query IIITT
SELECT id, grantor, grantee, privilege_type, is_grantable FROM acls, aclexplode(a) ORDER BY id, grantee, privilege_type
----
2  20  10  SELECT  false
3  20  0  USAGE  false
3  20  10  DELETE  false
3  20  10  INSERT  false
3  20  10  SELECT  false
3  20  10  UPDATE  false
4  20  10  SELECT  false
4  20  10  SELECT  false

query ITTTT
SELECT id, grantor, grantee, privilege_type, is_grantable FROM acls, mz_internal.mz_aclexplode(m) ORDER BY id, grantee, privilege_type
----
2  u2  u1  USAGE  false
3  s1  p  CREATE  false
3  u2  u1  DELETE  false
3  u2  u1  INSERT  false
3  u2  u1  SELECT  false
3  u2  u1  UPDATE  false
4  u2  u1  USAGE  false
4  u2  u1  USAGE  false

# generate_series over integers

statement ok
CREATE TABLE int_series (id int, lo int, hi int, step int)

statement ok
INSERT INTO int_series VALUES
  (1, 0, 0, 1),
  (2, 1, 0, 1),
  (3, 3, 1, -1),
  (4, 0, 10, 3),
  (5, 2147483646, 2147483647, 1),
  (6, 2147483640, 2147483647, 5),
  (7, -2147483647, -2147483648, -1),
  (8, -2147483642, -2147483648, -5),
  (9, 0, 5, 2147483647),
  (10, NULL, 1, 1),
  (11, 1, NULL, 1),
  (12, 1, 2, NULL)

query II
SELECT id, g FROM int_series, generate_series(lo, hi, step) AS g ORDER BY id, g
----
1  0
3  1
3  2
3  3
4  0
4  3
4  6
4  9
5  2147483646
5  2147483647
6  2147483640
6  2147483645
7  -2147483648
7  -2147483647
8  -2147483647
8  -2147483642
9  0

query II
SELECT id, g FROM int_series, generate_series(lo, hi) AS g WHERE id <= 4 ORDER BY id, g
----
1  0
4  0
4  1
4  2
4  3
4  4
4  5
4  6
4  7
4  8
4  9
4  10

query III
SELECT id, g, n FROM int_series, generate_series(lo, hi, step) WITH ORDINALITY AS t(g, n) ORDER BY id, n
----
1  0  1
3  3  1
3  2  2
3  1  3
4  0  1
4  3  2
4  6  3
4  9  4
5  2147483646  1
5  2147483647  2
6  2147483640  1
6  2147483645  2
7  -2147483647  1
7  -2147483648  2
8  -2147483642  1
8  -2147483647  2
9  0  1

statement ok
CREATE TABLE int_series_zero_step (lo int, hi int, step int)

statement ok
INSERT INTO int_series_zero_step VALUES (0, 1, 0)

query error step size cannot equal zero
SELECT g FROM int_series_zero_step, generate_series(lo, hi, step) AS g

statement ok
CREATE TABLE bigint_series (id int, lo bigint, hi bigint, step bigint)

statement ok
INSERT INTO bigint_series VALUES
  (1, 0, 0, 1),
  (2, 1, 0, 1),
  (3, 9223372036854775806, 9223372036854775807, 1),
  (4, 9223372036854775800, 9223372036854775807, 5),
  (5, -9223372036854775807, -9223372036854775808, -1),
  (6, 0, 5, 9223372036854775807),
  (7, NULL, 1, 1)

query II
SELECT id, g FROM bigint_series, generate_series(lo, hi, step) AS g ORDER BY id, g
----
1  0
3  9223372036854775806
3  9223372036854775807
4  9223372036854775800
4  9223372036854775805
5  -9223372036854775808
5  -9223372036854775807
6  0

# Every bigint_series row yields at most two values, so enumerating them all
# is cheap.
query II
SELECT id, g FROM bigint_series, mz_unsafe.generate_series_unoptimized(lo, hi, step) AS g ORDER BY id, g
----
1  0
3  9223372036854775806
3  9223372036854775807
4  9223372036854775800
4  9223372036854775805
5  -9223372036854775808
5  -9223372036854775807
6  0

statement ok
CREATE TABLE bigint_series_zero_step (lo bigint, hi bigint, step bigint)

statement ok
INSERT INTO bigint_series_zero_step VALUES (0, 1, 0)

query error step size cannot equal zero
SELECT g FROM bigint_series_zero_step, generate_series(lo, hi, step) AS g

query error step size cannot equal zero
SELECT g FROM bigint_series_zero_step, mz_unsafe.generate_series_unoptimized(lo, hi, step) AS g

