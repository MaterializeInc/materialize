SELECT TRY_CAST('12:34:56' AS time)::text, TRY_CAST('12:34:56' AS time)::text IS NOT DISTINCT FROM CAST('12:34:56' AS time)::text, TRY_CAST(NULL AS time) IS NULL
----
12:34:56  true  true

statement error
SELECT CAST('abc' AS time)

query T
SELECT TRY_CAST('abc' AS time)::text
----
NULL

statement error
SELECT CAST('' AS time)

query T
SELECT TRY_CAST('' AS time)::text
----
NULL

