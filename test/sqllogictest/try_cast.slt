# TRY_CAST(expr AS type) is CAST(expr AS type) that yields NULL where the cast
# would error. Errors raised by `expr` itself still propagate.
#
# The matrix below has one block per entry of the planner's cast table. For
# each source value that converts, the block shows the TRY_CAST result and
# checks that it agrees with CAST (the second column, always true, comparing
# the text renderings so that every type is comparable; the third
# column checks that a NULL source yields NULL). For each source value that
# does not convert, the block checks that CAST errors and TRY_CAST is NULL.
# The values were chosen so that every cast with a failure mode has at least
# one failing value; a block with no failing value is a cast that cannot fail.
#
# The numeric(5,2) target's blocks are in try_cast_noindex.slt, see there.
#
# `"char"` sources appear only against the targets with a dedicated `"char"`
# cast: the other targets route through text and panic on its datum (DB-201),
# in CAST and TRY_CAST alike.

mode cockroach

# The feature flag gates the syntax.
simple conn=mz_system,user=mz_system
ALTER SYSTEM SET enable_try_cast = false
----
COMPLETE 0

statement error enable_try_cast
SELECT TRY_CAST('1' AS int4)

simple conn=mz_system,user=mz_system
ALTER SYSTEM SET enable_try_cast = true
----
COMPLETE 0

# Record types can only be named through user-defined types.
statement ok
CREATE TYPE rec8 AS (a int8, b text)

statement ok
CREATE TYPE rec2 AS (a int2, b text)

# Basics.
query ITT
SELECT TRY_CAST('42' AS int4), TRY_CAST('abc' AS int4)::text, TRY_CAST(NULL AS int4)::text
----
42 NULL NULL

query T
SELECT pg_typeof(TRY_CAST(1 AS int8))
----
bigint

# The argument is evaluated first, and its errors propagate.
statement error division by zero
SELECT TRY_CAST(1 / 0 AS text)

statement error number too large to fit in target type
SELECT TRY_CAST(CAST('99999' AS smallint) AS integer)

statement error division by zero
SELECT TRY_CAST(TRY_CAST(1 / 0 AS int8) AS int4)

# Every stage of a multi-stage cast is protected.
query TT
SELECT TRY_CAST((-1)::int8 AS regclass)::text, TRY_CAST(5::int8 AS regclass)::text
----
NULL 5

# String-like targets route through text, and an explicit cast to char(n)
# truncates rather than failing, as CAST does.
query T
SELECT TRY_CAST(12345 AS char(3))
----
123

# A bad element yields NULL for the whole value, never a value with NULL
# holes in it. Collection literals are typed on their own, so the same holds
# for them.
query TTTT
SELECT TRY_CAST('{1,2,x}' AS int4 list)::text, TRY_CAST('{1,2,3}' AS int4 list)::text, TRY_CAST(ARRAY['1', 'x'] AS int4[])::text, TRY_CAST(LIST[100000] AS int2 list)::text
----
NULL {1,2,3} NULL NULL

query TT
SELECT TRY_CAST(ROW(100000, 'a') AS rec2)::text, TRY_CAST(ROW(1, 'a') AS rec8)::text
----
NULL (1,a)

# Because the literal is typed on its own, an empty collection literal needs
# its own type annotation.
statement error cannot determine type of empty array
SELECT TRY_CAST(ARRAY[] AS int4[])

query T
SELECT TRY_CAST(ARRAY[]::int4[] AS int8[])::text
----
{}

# Pairs CAST rejects are rejected the same way.
statement error CAST does not support casting from integer to jsonb
SELECT TRY_CAST(1 AS jsonb)

# The catalog-lookup casts are implemented in SQL and have no null-fallback
# form. String-like types route through text, so all of them are refused.

statement error TRY_CAST does not support casting from text to regclass
SELECT TRY_CAST(NULL::text AS regclass)

statement error TRY_CAST does not support casting from regclass to text
SELECT TRY_CAST(NULL::regclass AS text)

statement error TRY_CAST does not support casting from text to regproc
SELECT TRY_CAST(NULL::text AS regproc)

statement error TRY_CAST does not support casting from regproc to text
SELECT TRY_CAST(NULL::regproc AS text)

statement error TRY_CAST does not support casting from text to regtype
SELECT TRY_CAST(NULL::text AS regtype)

statement error TRY_CAST does not support casting from regtype to text
SELECT TRY_CAST(NULL::regtype AS text)

statement error TRY_CAST does not support casting from text to regclass
SELECT TRY_CAST(NULL::char(3) AS regclass)

statement error TRY_CAST does not support casting from regclass to text
SELECT TRY_CAST(NULL::regclass AS char(3))

statement error TRY_CAST does not support casting from text to regproc
SELECT TRY_CAST(NULL::char(3) AS regproc)

statement error TRY_CAST does not support casting from regproc to text
SELECT TRY_CAST(NULL::regproc AS char(3))

statement error TRY_CAST does not support casting from text to regtype
SELECT TRY_CAST(NULL::char(3) AS regtype)

statement error TRY_CAST does not support casting from regtype to text
SELECT TRY_CAST(NULL::regtype AS char(3))

statement error TRY_CAST does not support casting from text to regclass
SELECT TRY_CAST(NULL::varchar(3) AS regclass)

statement error TRY_CAST does not support casting from regclass to text
SELECT TRY_CAST(NULL::regclass AS varchar(3))

statement error TRY_CAST does not support casting from text to regproc
SELECT TRY_CAST(NULL::varchar(3) AS regproc)

statement error TRY_CAST does not support casting from regproc to text
SELECT TRY_CAST(NULL::regproc AS varchar(3))

statement error TRY_CAST does not support casting from text to regtype
SELECT TRY_CAST(NULL::varchar(3) AS regtype)

statement error TRY_CAST does not support casting from regtype to text
SELECT TRY_CAST(NULL::regtype AS varchar(3))

statement error TRY_CAST does not support casting from text to regclass
SELECT TRY_CAST(NULL::name AS regclass)

statement error TRY_CAST does not support casting from regclass to text
SELECT TRY_CAST(NULL::regclass AS name)

statement error TRY_CAST does not support casting from text to regproc
SELECT TRY_CAST(NULL::name AS regproc)

statement error TRY_CAST does not support casting from regproc to text
SELECT TRY_CAST(NULL::regproc AS name)

statement error TRY_CAST does not support casting from text to regtype
SELECT TRY_CAST(NULL::name AS regtype)

statement error TRY_CAST does not support casting from regtype to text
SELECT TRY_CAST(NULL::regtype AS name)

statement error TRY_CAST does not support casting from aclitem to text
SELECT TRY_CAST(NULL::aclitem AS text)

statement error TRY_CAST does not support casting from mz_aclitem to text
SELECT TRY_CAST(NULL::mz_aclitem AS text)

statement error TRY_CAST does not support casting from aclitem to mz_aclitem
SELECT TRY_CAST(NULL::aclitem AS mz_aclitem)

statement error TRY_CAST does not support casting from mz_aclitem to aclitem
SELECT TRY_CAST(NULL::mz_aclitem AS aclitem)

# TRY_CAST over a NOT NULL column is nullable, and NULL fallbacks flow through
# dataflows without error.
statement ok
CREATE TABLE t (s text NOT NULL)

statement ok
INSERT INTO t VALUES ('1'), ('2'), ('x'), ('3000000000'), ('2020-01-01')

statement ok
CREATE MATERIALIZED VIEW mv AS SELECT s, TRY_CAST(s AS int4) AS i, TRY_CAST(s AS date) AS d, TRY_CAST(s AS int4 list) AS l FROM t

statement ok
CREATE INDEX mv_i ON mv (i)

query TTTT rowsort
SELECT s, i::text, d::text, l::text FROM mv
----
1 1 NULL NULL
2 2 NULL NULL
2020-01-01 NULL 2020-01-01 NULL
3000000000 NULL NULL NULL
x NULL NULL NULL

query TT rowsort
SELECT name, nullable::text FROM mz_columns WHERE id = (SELECT id FROM mz_materialized_views WHERE name = 'mv') AND name IN ('s', 'i')
----
i true
s false

# A view definition plans as a TryCast.
statement ok
CREATE VIEW v AS SELECT TRY_CAST(s AS int4) AS i FROM t

query T multiline
EXPLAIN RAW PLAN FOR VIEW v
----
Project (#1)
  Map (try_cast[text_to_integer](#0{s}))
    Get materialize.public.t

EOF

query T multiline
EXPLAIN RAW PLAN FOR SELECT TRY_CAST(s AS int4) FROM t
----
Project (#1)
  Map (try_cast[text_to_integer](#0{s}))
    Get materialize.public.t

Target cluster: quickstart

EOF

query T multiline
EXPLAIN OPTIMIZED PLAN AS VERBOSE TEXT FOR SELECT TRY_CAST('x' AS int4), TRY_CAST('7' AS int4)
----
Explained Query (fast path):
  Constant
    - (null, 7)

Target cluster: quickstart

EOF

# The matrix.

## boolean sources

# boolean -> int4
query TBB
SELECT TRY_CAST(true AS int4)::text, TRY_CAST(true AS int4)::text IS NOT DISTINCT FROM CAST(true AS int4)::text, TRY_CAST(NULL::bool AS int4) IS NULL
----
1  true  true

query TBB
SELECT TRY_CAST(false AS int4)::text, TRY_CAST(false AS int4)::text IS NOT DISTINCT FROM CAST(false AS int4)::text, TRY_CAST(NULL::bool AS int4) IS NULL
----
0  true  true

# boolean -> int8
query TBB
SELECT TRY_CAST(true AS int8)::text, TRY_CAST(true AS int8)::text IS NOT DISTINCT FROM CAST(true AS int8)::text, TRY_CAST(NULL::bool AS int8) IS NULL
----
1  true  true

query TBB
SELECT TRY_CAST(false AS int8)::text, TRY_CAST(false AS int8)::text IS NOT DISTINCT FROM CAST(false AS int8)::text, TRY_CAST(NULL::bool AS int8) IS NULL
----
0  true  true

# boolean -> text
query TBB
SELECT TRY_CAST(true AS text)::text, TRY_CAST(true AS text)::text IS NOT DISTINCT FROM CAST(true AS text)::text, TRY_CAST(NULL::bool AS text) IS NULL
----
true  true  true

query TBB
SELECT TRY_CAST(false AS text)::text, TRY_CAST(false AS text)::text IS NOT DISTINCT FROM CAST(false AS text)::text, TRY_CAST(NULL::bool AS text) IS NULL
----
false  true  true

