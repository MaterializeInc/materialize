SELECT TRY_CAST('[1,3)'::int4range AS text)::text, TRY_CAST('[1,3)'::int4range AS text)::text IS NOT DISTINCT FROM CAST('[1,3)'::int4range AS text)::text, TRY_CAST(NULL::int4range AS text) IS NULL
----
[1,3)  true  true
