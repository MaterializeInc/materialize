# text -> numeric(5,2)
query TBB
SELECT TRY_CAST('1.5' AS numeric(5,2))::text, TRY_CAST('1.5' AS numeric(5,2))::text IS NOT DISTINCT FROM CAST('1.5' AS numeric(5,2))::text, TRY_CAST(NULL AS numeric(5,2)) IS NULL
----
1.50  true  true

statement error
SELECT CAST('abc' AS numeric(5,2))

query T
SELECT TRY_CAST('abc' AS numeric(5,2))::text
----
NULL

statement error
SELECT CAST('' AS numeric(5,2))

query T
SELECT TRY_CAST('' AS numeric(5,2))::text
----
NULL

