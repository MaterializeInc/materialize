# The numeric(5,2) blocks of the TRY_CAST matrix in try_cast.slt. They live
# apart because a constant-folded numeric(5,2) literal loses its scale on the
# view path: `SELECT 1.5::numeric(5,2)::text` gives `1.50`, but the same
# expression in a CREATE VIEW gives `1.5`, for CAST and TRY_CAST alike. The
# indexed views that --auto-index-selects wraps queries in hit that, so this
# file is kept out of that mode. The blocks have the same shape as in
# try_cast.slt.

mode cockroach

simple conn=mz_system,user=mz_system
ALTER SYSTEM SET enable_try_cast = true
----
COMPLETE 0

## numeric(5,2) targets

# smallint -> numeric(5,2)
query TBB
SELECT TRY_CAST(1::int2 AS numeric(5,2))::text, TRY_CAST(1::int2 AS numeric(5,2))::text IS NOT DISTINCT FROM CAST(1::int2 AS numeric(5,2))::text, TRY_CAST(NULL::int2 AS numeric(5,2)) IS NULL
----
1.00  true  true

query TBB
SELECT TRY_CAST(32767::int2 AS numeric(5,2))::text, TRY_CAST(32767::int2 AS numeric(5,2))::text IS NOT DISTINCT FROM CAST(32767::int2 AS numeric(5,2))::text, TRY_CAST(NULL::int2 AS numeric(5,2)) IS NULL
----
32767.00  true  true

query TBB
SELECT TRY_CAST((-1)::int2 AS numeric(5,2))::text, TRY_CAST((-1)::int2 AS numeric(5,2))::text IS NOT DISTINCT FROM CAST((-1)::int2 AS numeric(5,2))::text, TRY_CAST(NULL::int2 AS numeric(5,2)) IS NULL
----
-1.00  true  true

# integer -> numeric(5,2)
query TBB
SELECT TRY_CAST(1 AS numeric(5,2))::text, TRY_CAST(1 AS numeric(5,2))::text IS NOT DISTINCT FROM CAST(1 AS numeric(5,2))::text, TRY_CAST(NULL::int4 AS numeric(5,2)) IS NULL
----
1.00  true  true

query TBB
SELECT TRY_CAST(2147483647 AS numeric(5,2))::text, TRY_CAST(2147483647 AS numeric(5,2))::text IS NOT DISTINCT FROM CAST(2147483647 AS numeric(5,2))::text, TRY_CAST(NULL::int4 AS numeric(5,2)) IS NULL
